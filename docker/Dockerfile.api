# XRealityLab API (ASP.NET Core 3.1 Web API, used by Unity / Qualtrics)
# Build from the repository root:  docker build -f docker/Dockerfile.api -t xrealitylab-api .
FROM mcr.microsoft.com/dotnet/sdk:3.1-focal AS build
WORKDIR /src
COPY . .
RUN dotnet publish XRealityLabAPI/XRealityLabAPI.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:3.1-focal
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "XRealityLabAPI.dll"]
