@model XRealityLab.Models.LabDirectorDTO
@using System.Security.Claims;
@using XRealityLab.Common;

@{
    ViewBag.Title = "Add Lab";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>Lab and IT Director</strong>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--Projects Cards-->
<form asp-action="EditLab">
    <div class="row">
        <div class="col-xl-6">
            <div class="card card-default">
                <div class="card-body">
                    <h2>Lab Details</h2>
                    <input type="hidden" asp-for="PassToken" />
                    <div class="form-group" align="center">
                        <div align="center" style="padding :10px 0 0 0">
                            <img id="imgIcon" src="~/_images/group_icons/organization_blank_icon.png" alt="Avatar" width="90" height="90" class="rounded-circle" />
                            <input id="inputBase64" type="hidden" asp-for="PhotoBase64" />
                        </div>
                        <label class="col-md-6 col-form-label">Organization Icon</label>
                        <div>
                            <input id="inputFileToLoad" class="form-control filestyle" type="file" data-classbutton="btn btn-secondary" data-classinput="form-control inline" onchange="encodeImageFileAsURL()" data-icon="&lt;span class='fa fa-upload mr'&gt;&lt;/span&gt;" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Color</label>
                        <select id="color" asp-for="Color" class="form-control form-control-lg">
                            <option style="background-color:#5BB79E" value="#5BB79E">C1</option>
                            <option style="background-color:#4F91CD" value="#4F91CD">C2</option>
                            <option style="background-color:#9F78B9" value="#9F78B9">C3</option>
                            <option style="background-color:#E1BD42" value="#E1BD42">C4</option>
                            <option style="background-color:#D07F39" value="#D07F39">C5</option>
                            <option style="background-color:#CE5543" value="#CE5543">C6</option>
                            <option style="background-color:#76CB8E" value="#76CB8E">C7</option>
                            <option style="background-color:#364658" value="#364658">C8</option>
                            <option style="background-color:#A5B0B1" value="#A5B0B1">C9</option>
                            <option style="background-color:#53A564" value="#53A564">C10</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Lab Title</label>
                        <input asp-for="FullName" class="form-control" type="text" placeholder="" />
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input asp-for="Description" class="form-control" type="text" placeholder="" />
                    </div>
                    <div class="form-group">
                        <label>Hex Color</label>
                        <div class="col-6">
                            <div class="demo-colorpicker" data-container="true" data-color="rgb(50,216,62)" data-inline="true"></div>
                        </div>
                        <div class="col-3">
                            <input asp-for="Color" class="form-control" type="text" placeholder="#FFFFFF" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card card-default">
                <div class="card-body">
                    <h2>Email address</h2>
                    <div align="right">
                        <a class="fa mr fas fa-ellipsis-h text-black" data-toggle="dropdown"></a>
                        <div class="dropdown-menu" role="menu">
                            <a class="dropdown-item" href="/DirectorIT/ChangeLabDirector?passToken=@Model.PassToken">Change Lab Director</a>
                        </div>
                    </div>
                    <div class="form-group" style="pointer-events: none">
                        <input asp-for="Email" class="form-control" type="email" placeholder="Enter email" style="background-color:lightgray" />
                    </div>
                </div>
            </div>
            <div class="card card-default">
                <div class="card-body">
                    <h2>Lab Director and Contact</h2>
                    <div class="form-group">
                        <label>Rank</label>
                        <select id="rank" asp-for="Rank" class="form-control form-control-lg">
                            @foreach (var item in Enum.GetValues(typeof(Rank)))
                            {
                                <option value=@((int)item)>@((Rank)item).</option>
                            }
                        </select>
                        @*<input asp-for="Rank" class="form-control" type="text" placeholder="Enter Rank" />*@
                    </div>
                    <div class="form-group">
                        <label>First Name</label>
                        <input asp-for="Firstname" class="form-control" type="text" placeholder="Enter First Name" />
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input asp-for="Lastname" class="form-control" type="text" placeholder="Enter Last Name" />
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input asp-for="Telephone" class="form-control" type="text" placeholder="Enter Phone Number" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="btn btn-sm btn-primary" type="submit">Update</button>
</form>

@section Styles {
    <link href="~/vendor/bootstrap-colorpicker/dist/css/bootstrap-colorpicker.css" rel="stylesheet" />

}

@section Scripts {
    <script src="~/vendor/bootstrap-colorpicker/dist/js/bootstrap-colorpicker.js"></script>
    <script type='text/javascript'>
        function encodeImageFileAsURL() {
            var filesSelected = document.getElementById("inputFileToLoad").files;
            if (filesSelected.length > 0) {
                var fileToLoad = filesSelected[0];
                var fileReader = new FileReader();
                fileReader.onload = function (fileLoadedEvent) {
                    var srcData = fileLoadedEvent.target.result; // <--- data: base64
                    document.getElementById("imgIcon").src = srcData;
                    document.getElementById("inputBase64").value = srcData;
                }
                fileReader.readAsDataURL(fileToLoad);
            }
        }
    </script>
}
