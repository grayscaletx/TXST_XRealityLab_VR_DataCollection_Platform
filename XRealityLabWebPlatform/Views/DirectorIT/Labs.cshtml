@model XRealityLab.Models.OrganizationDTO
@using XRealityLab.Common;

@{
    ViewBag.Title = "Labs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>
        <strong>Labs of @Model.FullName</strong><span class="xr-count">@Model.LabDTOs.Count of @Model.NoAllowedLabs</span>
        <span class="xr-sub">Each lab has one Lab Director, who manages its projects and researchers.</span>
    </div>
</div>

<partial name="_ActionMessage" />

<div class="xr-grid">
    @if (Model.LabDTOs.Count < Model.NoAllowedLabs)
    {
        <a class="xr-card xr-card-new" href="/DirectorIT/AddLab">
            <span class="xr-plus">+</span>
            New lab
        </a>
    }

    @foreach (var item in Model.LabDTOs)
    {
        <article class="xr-card" style="--xr-card-color:@item.Color">
            <div class="xr-card-band">
                <div class="xr-card-menu">
                    <a class="fas fa-ellipsis-h" data-toggle="dropdown" role="button" aria-label="Actions for @item.FullName"></a>
                    <div class="dropdown-menu dropdown-menu-right" role="menu">
                        <a class="dropdown-item" href="/DirectorIT/EditLab?passToken=@item.PassToken">Edit lab</a>
                        <a class="dropdown-item" href="/DirectorIT/ChangeLabDirector?passToken=@item.PassToken">Change Lab Director</a>
                        <a class="dropdown-item text-danger" href="/DirectorIT/RemoveLab?passToken=@item.PassToken" onclick="return confirm('Remove this lab together with its projects and users? This cannot be undone.');">Remove lab</a>
                    </div>
                </div>
            </div>
            <img class="xr-card-avatar" src="@item.PhotoUrl" alt="" />
            <div class="xr-card-body">
                <h3 class="xr-card-title"><a href="/DirectorIT/EditLab?passToken=@item.PassToken">@item.FullName</a></h3>
                <p class="xr-label">Lab Director</p>
                <ul class="xr-people">
                    <li>@((Rank)item.LabDirector.Rank + ". " + item.LabDirector.Firstname + " " + item.LabDirector.Lastname)</li>
                </ul>
                <div class="xr-card-foot">
                    <a href="/DirectorIT/EditLab?passToken=@item.PassToken">Edit lab</a>
                </div>
            </div>
        </article>
    }
</div>
