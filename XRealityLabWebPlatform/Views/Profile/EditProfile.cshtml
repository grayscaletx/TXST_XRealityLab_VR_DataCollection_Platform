@model ARI.Application.UserDTO

@{
    ViewData["Title"] = "Επεργασία στοιχείων χρήστη";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>
        Επεξεργασία στοιχείων χρήστη
    </div>
</div>

<div class="card" style="max-width:1400px">
    <div class="card-header">
        <div class="card-title">Λογαριασμός \ Επεξεργασία στοιχείων χρήστη</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="EditProfile">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PassToken" />
                <div class="form-group">
                    <label asp-for="Firstname" class="control-label"></label>
                    <input asp-for="Firstname" class="form-control" />
                    <span asp-validation-for="Firstname" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Lastname" class="control-label"></label>
                    <input asp-for="Lastname" class="form-control" />
                    <span asp-validation-for="Lastname" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Telephone" class="control-label"></label>
                    <input asp-for="Telephone" class="form-control" />
                    <span asp-validation-for="Telephone" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Ανανέωση" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/jquery-3.6.0.slim.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}