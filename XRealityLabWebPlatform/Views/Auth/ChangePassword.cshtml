@model XRealityLab.Application.IdentityChangePasswordDTO
@using Microsoft.Extensions.Options
@inject IOptions<XRealityLab.Security.ReCAPTCHASettings> GoogleReCAPTCHA

@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="block-center mt-4 wd-xl">
    <!-- START card-->
    <div class="card card-flat" style="background-color:#4bc4e9">
        <div class="card-header text-center bg-white">
            <a href="#">
                <img class="block-center rounded" src="~/_images/Logo/XRealityLabIcon.png" style="max-width: 250px;" alt="Image" />
            </a>
        </div>
        <div class="card-body">
            <p class="text-center py-2">Αλλαγή κωδικού</p>
            <form asp-action="ChangePassword" class="m-t" role="form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Password" class="form-control border-right-0" placeholder="Password" required="" autocomplete="off" />
                        <div class="input-group-append">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="ConfirmPassword" class="form-control border-right-0" placeholder="Confirm password" required="" autocomplete="off" />
                        <div class="input-group-append">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <input asp-for="IdentityID" type="hidden" />
                <input asp-for="Code" type="hidden" />
                <div class="form-group">
                    <input type="submit" value="Change" class="btn btn-danger btn-block" />
                </div>
            </form>
        </div>
    </div>
    <br />
    <p class="m-t"><small>Copyright © 2023 </small><a href="http://xrealitylab.com"><small> XRealityLab </small></a><small>All rights reserved.</small></p>    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @if (ViewBag.Message != null)
    {
        <script>
            $(document).ready(function(){
            alert('@ViewBag.Message');
            });
        </script>
    }
}

