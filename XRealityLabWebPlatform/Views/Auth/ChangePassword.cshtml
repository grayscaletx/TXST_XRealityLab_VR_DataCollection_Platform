@model XRealityLab.Application.IdentityChangePasswordDTO

@{
    ViewData["Title"] = "Choose a new password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2>Choose a new password</h2>
<p class="xr-sub">At least 4 characters, including one lower-case letter.</p>

<form asp-action="ChangePassword">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Password">New password</label>
        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" required="required" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword">Repeat the new password</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required="required" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <input asp-for="IdentityID" type="hidden" />
    <input asp-for="Code" type="hidden" />
    <button type="submit" class="btn btn-primary btn-block">Save new password</button>
</form>

<p class="xr-auth-links"><a asp-action="Login">Back to log in</a></p>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
