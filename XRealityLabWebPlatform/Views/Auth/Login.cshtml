@model ARI.Application.IdentityLoginUserDTO
@using Microsoft.Extensions.Options
@inject IOptions<ARI.Security.ReCAPTCHASettings> GoogleReCAPTCHA

@{
    ViewData["Title"] = "XReality Lab";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="block-center mt-4 wd-xl" >
    <!-- START card-->
    <div class="card card-flat" style="background-color:#4bc4e9">
        <div class="card-header text-center" >
            <a href="#">
                <img class="block-center" src="~/_images/Logo/XRealityLabIcon.png" style="max-width: 250px;" alt="Image" />
            </a>
        </div>
        <div class="card-body">
            <p class="text-center py-2" style="color:white">Login</p>
            <form asp-action="Login" class="mb-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Email" class="form-control border-right-0" type="email" placeholder="Email address" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Email" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Password" class="form-control border-right-0" placeholder="password" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Password" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <input asp-for="Token" type="hidden" />
                <div class="clearfix" hidden>
                    <div class="float-right">
                        <a asp-action="ForgotPassword" class="text-muted"><small>Ξέχασες τον κωδικό σου;</small></a>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Login" class="btn btn-block btn-primary mt-3" style="background-color:white; color:#4bc4e9" />
                </div>
            </form>
            <br />
            <p class="text-muted text-center"><small>Δεν έχεις λογαριασμό;</small></p>
            <a class="btn btn-block btn-secondary" asp-action="Register">Create an account</a>
        </div>
    </div>
    <br />
    <p class="m-t"><small>Copyright © 2023 </small><a href="http://xrealitylab.com"><small> XRealityLab </small></a><small>All rights reserved.</small></p>
    <small>v.- (dev environment)</small>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://www.google.com/recaptcha/api.js?render=@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key"></script>
    <script>
        grecaptcha.ready(function () {
            grecaptcha.execute('@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key', { action: 'homepage' }).then(function (token) {
                console.log(token);
                $('#Token').val(token);
        });
    });
    </script>
}