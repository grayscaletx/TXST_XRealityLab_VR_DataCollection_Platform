@model XRealityLab.Application.IdentityForgotPasswordDTO
@using Microsoft.Extensions.Options
@inject IOptions<XRealityLab.Security.ReCAPTCHASettings> GoogleReCAPTCHA

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="block-center mt-4 wd-xl">
    <div class="card card-flat" style="background-color:#4bc4e9">
        <div class="card-header text-center">
            <a href="#">
                <img class="block-center rounded" src="~/_images/Logo/XRealityLab.JPG" style="max-width: 250px;" alt="Image" />
            </a>
        </div>
        <div class="card-body">
            <p class="text-center py-2 text-white">Forgot password</p>
            <form asp-action="ForgotPassword" class="m-t" role="form">
                <p class="text-center text-white"><small>Forgot your password? No problem, we'll just email you a reset link. Please use the email that you registered with previously. </small></p>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Email" class="form-control border-right-0" type="email" placeholder="@Html.DisplayNameFor(m=>m.Email)" autocomplete="off" />
                        <div class="input-group-append">
                            <span asp-validation-for="Email" class="text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <input asp-for="Token" type="hidden" />
                <div class="form-group">
                    <input type="submit" value="Send Email" class="btn btn-danger btn-block" />
                </div>
            </form>
            <a asp-action="Login" class="text-white"><small>Cancel</small></a>
        </div>
    </div>
    <br />
    <p class="m-t"><small>Copyright © 2023 </small><a href="http://xrealitylab.com"><small> XRealityLab </small></a><small>All rights reserved.</small></p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://www.google.com/recaptcha/api.js?render=@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key"></script>
    <script>
        grecaptcha.ready(function () {
            grecaptcha.execute('@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key', { action: 'homepage' }).then(function (token) {
                console.log(token);
                $('#Token').val(token);
        });
    });
    </script>
    @if (ViewBag.Message != null)
    {
        <script>
            $(document).ready(function(){
            alert('@ViewBag.Message');
            });
        </script>
    }
}
