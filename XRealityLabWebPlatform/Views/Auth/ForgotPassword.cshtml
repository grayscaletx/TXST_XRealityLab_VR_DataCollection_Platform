@model ARI.Application.IdentityForgotPasswordDTO
@using Microsoft.Extensions.Options
@inject IOptions<ARI.Security.ReCAPTCHASettings> GoogleReCAPTCHA

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="block-center mt-4 wd-xl">
    <!-- START card-->
    <div class="card card-flat">
        <div class="card-header text-center bg-white">
            <a href="#">
                <img class="block-center rounded" src="~/images/AriLogo.png" style="max-width: 250px;" alt="Image" />
            </a>
        </div>
        <div class="card-body">
            <p class="text-center py-2">Επαναφορά κωδικού</p>
            <form asp-action="ForgotPassword" class="m-t" role="form">
                <p class="text-center"><small>Ξεχάσατε το κωδικό? Θα σας στείλουμε λεπτομέρειες για την ανάκτηση στην ηλεκτρονική σας διεύθυνση. Παρακαλώ πληκτρολογήστε την ηλεκτρονική διεύθυνση.</small></p>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Email" class="form-control border-right-0" type="email" placeholder="Ηλεκτρονική διεύθυνση" autocomplete="off" />
                        <div class="input-group-append">
                            <span asp-validation-for="Email" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <input asp-for="Token" type="hidden" />
                <div class="form-group">
                    <input type="submit" value="Αποστολή" class="btn btn-danger btn-block" />
                </div>
            </form>
            <a asp-action="Login"><small>Ακύρωση</small></a>
        </div>
    </div>
    <br />
    <p class="m-t"><small>Copyright © 2021</small><a href="http://arifoods.gr/"><small> ARI S.A. </small></a><small>All rights reserved.</small></p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://www.google.com/recaptcha/api.js?render=@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key"></script>
    <script>
        grecaptcha.ready(function () {
            grecaptcha.execute('@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key', { action: 'homepage' }).then(function (token) {
                console.log(token);
                $('#Token').val(token);
        });
    });
    </script>
    @if (ViewBag.Message != null)
    {
        <script>
            $(document).ready(function(){
            alert('@ViewBag.Message');
            });
        </script>
    }
}
