@model XRealityLab.Application.IdentityUserDTO
@using Microsoft.Extensions.Options
@inject IOptions<XRealityLab.Security.ReCAPTCHASettings> GoogleReCAPTCHA

@{
    ViewData["Title"] = " Δημιουργία λογαριασμού";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="block-center mt-4 wd-xl">
    <!-- START card-->
    <div class="card card-flat">
        <div class="card-header text-center bg-white">
            <a href="#">
                <img class="block-center" src="~/images/AriLogo.png" style="max-width: 250px;" alt="Image" />
            </a>
        </div>
        <div class="card-body">
            <p class="text-center py-2">Δημιουργία νέου λογαριασμού</p>
            <form asp-action="Register" class="mb-3" role="form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Email" class="form-control border-right-0" type="email" placeholder="Ηλεκτρονική διεύθυνση" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Email" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Firstname" class="form-control border-right-0" placeholder="Όνομα" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Firstname" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Lastname" class="form-control border-right-0" placeholder="Επώνυμο" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Lastname" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="PhoneNumber" class="form-control border-right-0" placeholder="Τηλέφωνο" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="PhoneNumber" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="Password" class="form-control border-right-0" type="password" placeholder="Κωδικός" autocomplete="off" required="required" />
                        <div class="input-group-append">
                            <span asp-validation-for="Password" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group with-focus">
                        <input asp-for="ConfirmPassword" class="form-control border-right-0" type="password" placeholder="Επιβεβαίωση κωδικού" autocomplete="off" required="required" data-parsley-equalto="#signupInputPassword1" />
                        <div class="input-group-append">
                            <span asp-validation-for="ConfirmPassword" class="input-group-text text-muted bg-transparent border-left-0 text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="checkbox c-checkbox mt-0">
                    <label>
                        <input type="checkbox" value="" required="required" name="agreed" />
                        <span class="fa fa-check"></span><small>Αποδοχή όρων και </small><a class="ml-1" asp-action="Privacy" asp-controller="Home"><small>προυποθέσεων</small></a>
                    </label>
                </div>
                <input asp-for="Token" type="hidden" />
                <div class="form-group">
                    <input type="submit" value="Δημιουργία" class="btn btn-block btn-primary mt-3" />
                </div>
            </form>
            <p class="pt-3 text-center">Έχεις λογαριασμό;</p>
            <a class="btn btn-block btn-secondary" asp-action="Login">Σύνδεση</a>
        </div>
    </div>
    <br />
    <p class="m-t"><small>Copyright © 2021</small><a href="http://arifoods.gr/"><small> ARI S.A. </small></a><small>All rights reserved.</small></p>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://www.google.com/recaptcha/api.js?render=@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key"></script>
    <script>
         $(document).ready(function(){
            $("#signupForm").validate({
                rules:{
                    termsConditions : "required"
                }
            });
        });

        grecaptcha.ready(function () {
            grecaptcha.execute('@GoogleReCAPTCHA.Value.ReCAPTCHA_Site_Key', { action: 'homepage' }).then(function (token) {
                console.log(token);
                $('#Token').val(token);
        });
    });
    </script>
}
