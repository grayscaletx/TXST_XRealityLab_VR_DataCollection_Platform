    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <h2>Placeholder(Session Name)</h2>
        <!-- Breadcrumb below title-->
        <ol class="breadcrumb breadcrumb px-0 pb-0">
            <li class="breadcrumb-item">
                <a href="/ResearchAssistant/MyProjects">MyProjects</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/ResearchAssistant/DataCollections">Data Collections</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/ResearchAssistant/Participants">Placeholder(Session Name)</a>
            </li>
            <li class="breadcrumb-item active">Placeholder(Participant Name)</li>
        </ol>
    </div>
</div>


<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

