@model IEnumerable<ARI.Models.MaterialDTO>
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Προιόντα";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string role = ((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").ToList().LastOrDefault().Value;
}
<div class="content-heading">
    <div>
        Προιόντα
    </div>
</div>


<div class="card" style="max-width:1400px">
    <div class="card-header">
        <div class="card-title">Διασφάλιση ποιότητας \ Προιόντα</div>
        <div class="text-sm">Στο παρακάτω πίνακα εμφανίζονται τα προιόντα που υπάρχουν στην πλατφόρμα.</div>
        <div class="text-sm">Από την παρακάτω καρτέλα μπορείτε να προσθέσετε και να ανανεώσετε τις τιμές Expiration day και lager day. Εάν οι τιμές είναι κενές δεν θα εμφανίζεται το προιόν στη πλατφόρμα.</div>
        <a id="download-btn" asp-action="DownloadMaterials" class="mb-1 btn btn-primary" style="float: right;margin: 0px 0px 0px 5px;display:inline">Εξαγωγή δεδομένων</a>
    </div>
    <div class="card-body">
        <table class="table table-striped my-5 w-100" id="datatable1">
            <thead>
                <tr>
                    <th data-priority="1">Α/Α</th>
                    <th>SAPCode</th>
                    <th>Περιγραφή</th>
                    <th class="sort-numeric">Χώρα</th>
                    <th class="sort-numeric">GTIN</th>
                    <th class="sort-numeric">Lager days</th>
                    <th class="sort-numeric">Expiration days</th>
                    <th>
                        <em></em>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr class="gradeX">
                    <td>
                        <a>ΠΡ @item.MaterialId</a>
                    </td>
                    <td>@item.MaterialSAPID</td>
                    <td>@item.MaterialDescription</td>
                    <td>@item.LanguageCode</td>
                    <td>@item.GTIN</td>
                    <td>@item.LagerDays</td>
                    <td>@item.ExpirationDays</td>
                    <td>
                        <div class="ibox-tools">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-cog"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-user">
                                <li>
                                    <a onclick="displayModal('@item.MaterialId')" class="dropdown-item">Επεξεργασία (expiration &amp; lager days)</a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!--Modal-->
<div id="modal-container" tabindex="-1">

</div>
<!--Edit material-->
<div class="modal inmodal fade" id="edit-material" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
            </div>
            <div class="modal-body" style="align-items:center">
                <p style="font-size:24px;text-align:center">
                    <img src="~/images/AriLogo.png" width="50" />
                    Επεξεργασία προιόντος
                </p>
                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label>Lager days</label>
                            <input class="form-control modal-lager-days" type="text" id="modal-lager-days" value="0" required />
                        </div>
                        <div class="form-group">
                            <label>Expiration days</label>
                            <input class="form-control modal-expiration-days" type="text" id="modal-expiration-days" value="0" required />
                        </div>
                        <input class="form-control modal-material-id" type="text" id="modal-material-id" hidden/>
                    </div>
                </div>
                <p style="font-size:20px;text-align:center">
                    <a class="btn btn-primary" data-dismiss="modal" onclick="EditMaterial(this)" style="width:200px;color:white">Ανανέωση</a>
                </p>
            </div>
        </div>
    </div>
</div>
<!--Error-->
<div class="modal inmodal fade" id="display-error-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><img src="~/images/AriLogo.png" width="100" /><strong>@ViewData["Title"]</strong></h4>
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Κλείσιμο</span></button>
            </div>
            <div class="modal-body" style="align-items:center">
                <p style="font-size:24px;text-align:center">
                    Σφάλμα:
                </p>
                <p id="error-message" style="font-size:22px;text-align:center;font-style:italic;color:red"> </p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">
}

@section Scripts {

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery/dist/jquery-ui.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>

    <script>
        function displayModal(materialId) {
            var modalContainer = document.getElementById('modal-container');
            removeAllChildNodes(modalContainer);
            modalTemplate = document.getElementById("edit-material");

            var cloneElement = modalTemplate.cloneNode(true);
            cloneElement.id = 'display-modal';
            document.getElementById('modal-container').appendChild(cloneElement);
            jQuery.noConflict();
            $('#display-modal').appendTo("body").modal('show');
            cloneElement.getElementsByClassName("modal-material-id")[0].value = materialId;
        }
        function EditMaterial(obj) {
            var lagerdays = obj.parentElement.parentElement.getElementsByClassName('modal-lager-days')[0].value;
            var expirationdays = obj.parentElement.parentElement.getElementsByClassName('modal-expiration-days')[0].value;
            var materialid = obj.parentElement.parentElement.getElementsByClassName('modal-material-id')[0].value;

            var formData = new FormData();
            formData.append('lager-days', lagerdays);
            formData.append('expiration-days', expirationdays);
            formData.append('material-id', materialid);

            $.ajax({
                type: "post",
                url: "/QualityAssurance/EditMaterial",
                contentType: false,
                processData: false,
                data: formData,
                success: function (response) {
                    if (response.result == "Succeeded") {
                        window.location = '/QualityAssurance/Materials';
                    }
                    else {
                        displayErrorMessage(response);
                    }
                },
                error: function () {
                    displayErrorMessage("");
                }
            });
        }

        function displayErrorMessage(response) {
            $('#display-error-modal').appendTo("body").modal('show');
            document.getElementById('error-message').innerHTML = 'ActionGUID: ' + response.responseGUID + ' - ' + response.message + ' Result: ' + response.result;
        }
        function removeAllChildNodes(parent) {
            while (parent.firstChild) {
                parent.removeChild(parent.firstChild);
            }
        }
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
            });
        }
    </script>

}
