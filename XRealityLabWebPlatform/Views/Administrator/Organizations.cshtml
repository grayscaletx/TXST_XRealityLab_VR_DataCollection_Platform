@model List<XRealityLab.Models.OrganizationDTO>
@using XRealityLab.Common;

@{
    ViewBag.Title = "Organizations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>
        <strong>Organizations</strong><span class="xr-count">@Model.Count</span>
        <span class="xr-sub">Each organization has one Director of IT, who creates its labs.</span>
    </div>
</div>

<partial name="_ActionMessage" />

<div class="xr-grid">
    <a class="xr-card xr-card-new" href="/Administrator/AddOrganization">
        <span class="xr-plus">+</span>
        New organization
    </a>

    @foreach (var item in Model)
    {
        <article class="xr-card" style="--xr-card-color:@item.Color">
            <div class="xr-card-band">
                @if (item.Expired)
                {
                    <span class="xr-card-badge is-danger">Expired @item.SubscriptionExpiration.ToString("MM/dd/yyyy")</span>
                }
                else if (item.NotStarted)
                {
                    <span class="xr-card-badge is-ok">Starts @item.SubscriptionStarted.ToString("MM/dd/yyyy")</span>
                }
                <div class="xr-card-menu">
                    <a class="fas fa-ellipsis-h" data-toggle="dropdown" role="button" aria-label="Actions for @item.FullName"></a>
                    <div class="dropdown-menu dropdown-menu-right" role="menu">
                        <a class="dropdown-item" href="/Administrator/EditOrganization?passToken=@item.PassToken">Edit organization</a>
                        <a class="dropdown-item" href="/Administrator/ChangeITDirector?passToken=@item.PassToken">Change Director of IT</a>
                        <a class="dropdown-item text-danger" href="/Administrator/RemoveOrganization?passToken=@item.PassToken" onclick="return confirm('Remove this organization together with its labs, projects and users? This cannot be undone.');">Remove organization</a>
                    </div>
                </div>
            </div>
            <img class="xr-card-avatar" src="@item.PhotoUrl" alt="" />
            <div class="xr-card-body">
                <h3 class="xr-card-title"><a href="/Administrator/EditOrganization?passToken=@item.PassToken">@item.FullName</a></h3>
                <p class="xr-label">Director of IT</p>
                <ul class="xr-people">
                    <li>@((Rank)item.ITDirector.Rank + ". " + item.ITDirector.Firstname + " " + item.ITDirector.Lastname)</li>
                </ul>
                <div class="xr-card-foot">
                    <a href="/Administrator/EditOrganization?passToken=@item.PassToken">Edit organization</a>
                </div>
            </div>
        </article>
    }
</div>
