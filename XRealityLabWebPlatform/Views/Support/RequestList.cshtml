@model IEnumerable<ARI.Application.RequestDTO>

@{
    ViewBag.Title = "Αιτήματα";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-heading">
    <div>
        Λίστα παραπόνων
    </div>
</div>
<!-- START cards box-->

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Υποστήριξη \ Αιτήματα</div>
        <div class="text-sm">Στο παρακάτω πίνακα αναγράφονται τα βιογραφικά \ αιτήματα \ παράπονα που έχουν σταλθεί μέσω φόρμας στην εταιρία ARI</div>
    </div>

    <div class="card-body">
        <table class="table table-striped my-4 w-100" id="datatable1">
            <thead>
                <tr>
                    <th data-priority="1">Α/Α</th>
                    <th>Ονοματεπώνυμο</th>
                    <th>Ηλεκτρονική διεύθυνση</th>
                    <th>Διεύθυνση</th>
                    <th>Πόλη</th>
                    <th>Τηλέφωνο</th>
                    <th>Τύπος αιτήματος</th>
                    <th>Περιγραφή</th>
                    <th>Ημερομηνία αιτήματος</th>
                    <th>Έγγραφα</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    <td>
                        ΚΦ @item.RequestId
                    </td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Street</td>
                    <td>@item.City</td>
                    <td>@item.Telephone</td>
                    <td>@item.ComplaintSubject</td>
                    <td>
                        @{
                            string description = !String.IsNullOrWhiteSpace(item.Description) && item.Description.Length >= 30
                            ? item.Description.Substring(0, 30) + "..."
                            : item.Description;
                        }
                        <a href="" data-toggle="modal" data-target="#myModalLarge-@item.RequestId">@description</a>
                    </td>
                    <td>@item.SubmissionDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (!String.IsNullOrEmpty(item.FilePath))
                        {
                            <a href="@item.FilePath" target="_blank"><img width="15" height="15" src="~/images/document_link.png"/></a>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section BodyArea {
    @foreach (var item in Model)
    {
        <div class="modal fade" id="myModalLarge-@item.RequestId" tabindex="-1" role="dialog" aria-labelledby="myModalLabelLarge" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="myModalLabelLarge">Περιγραφή</h4>
                        <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">@item.Description</div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Κλείσιμο</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

