@model ARI.Models.CompanyCarReservationDTO

@{
    ViewData["Title"] = "Κράτηση οχήματος";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>
        Προσθήκη εταιρικού αυτοκινήτου
    </div>
</div>

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Εξοπλισμός \ Εταιρικά αυτοκίνητα</div>
        <div class="text-sm">Πρόσθεσε τις πληροφορίες για την κράτηση του εταιρικού αυτοκινήτου</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="AddCompanyCar">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedUser, htmlAttributes: new { @class = "control-label" }) <small> (*)</small>
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedUser, new SelectList(Model.UserListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "User" })
                        @Html.ValidationMessageFor(x => x.SelectedUser, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedCar, htmlAttributes: new { @class = "control-label" }) <small> (*)</small>
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedCar, new SelectList(Model.CarListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "Car" })
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="InKilometers" class="control-label"></label>
                    <input asp-for="InKilometers" class="form-control" />
                    <span asp-validation-for="InKilometers" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ArrivalDateTime" class="control-label"></label>  <small> (*)</small>
                    <input asp-for="ArrivalDateTime" class="form-control" type="datetime" name="ArrivalDateTime" id="arrivalDatePicker" value=@DateTime.UtcNow.AddHours(3) />
                    <span asp-validation-for="ArrivalDateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Προσθήκη" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="CompanyCarsList">Επιστροφή στη λίστα των κρατήσεων</a>
</div>

@section Scripts {
    <script src="~/js/jquery-3.6.0.slim.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>

    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    @*<script src="~/js/signature_pad.min.js"></script>*@
    <script>
    $(function () {
        $('#arrivalDatePicker').datetimepicker();
        $('#departureDatePicker').datetimepicker();
    });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}