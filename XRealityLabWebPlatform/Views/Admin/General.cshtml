@model ARI.Models.GeneralInfoDTO
@{
    ViewData["Title"] = "Διαχείριση γενικών δεδομένων";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = new Uri($"{ ViewContext.HttpContext.Request.Scheme}://{ ViewContext.HttpContext.Request.Host}");
}

<div class="content-heading">
    <div>
        Διαχείριση γενικών δεδομένων πλατφόρμας
    </div>
</div>

<div class="card" style="max-width:1400px">
    <div class="card-body">
        <div class="col-md-8">
            <div>
                <h3><strong>Χρήστες</strong></h3>
                <p>Διαγραφή όλων των χρηστών. <i>(@Model.Users εγγραφές)</i></p>
                <p>Δεν θα διαγραφούν χρήστες με ρόλο Διαχειριστή και IT. Για να ολοκληρωθεί επιτυχώς η ενέργεια θα διαγραφούν και οι εγγραφές στα εταιρικά αυτοκίνητα για αυτούς του χρήστες. 
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong></p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllUsers")" disabled />
                <br />
                <br />
            </div>
            <div>
                <h3><strong>Φορτηγά</strong></h3>
                <p>Διαγραφή όλων των δεδομένων για τα φορτηγά. <i>(@Model.Trucks εγγραφές)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllTrucks")" disabled />
                <br />
                <p>Διαγραφή των δεδομένων για το έτος {0} για τα φορτηγά.</p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <select class="form-control" id="year-truck">
                    <option>2022</option>
                    <option>2023</option>
                    <option>2024</option>
                    <option>2025</option>
                </select>
                <input class="form-control" id="truck-input" value="@string.Format("{0}{1}?year={2}",@baseUrl, "Admin/DeleteTrucksByYear","2022")" disabled />
                <br />
                <br />
            </div>
            <br />
            <div>
                <h3><strong>Επισκέπτες</strong></h3>
                <p>Διαγραφή όλων των δεδομένων για τους επισκέπτες. <i>(@Model.Visitors εγγραφές)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllVisitors")" disabled />
                <br />
                <p>Διαγραφή των δεδομένων για το έτος {0} για τους επισκέπτες.</p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <select class="form-control" id="year-visitor">
                    <option>2022</option>
                    <option>2023</option>
                    <option>2024</option>
                    <option>2025</option>
                </select>
                <input class="form-control" id="visitor-input" value="@string.Format("{0}{1}?year={2}",@baseUrl, "Admin/DeleteVisitorsByYear","2022")" disabled />
                <br />
                <br />
            </div>
            <br />
            <div>
                <h3><strong>Αυτοκίνητα εταιρίας και δανεισμός</strong></h3>
                <p>Διαγραφή όλων των δεδομένων για τους δανεισμούς των εταιρικών αυτοκινήτων. <i>(@Model.CompanyCarReservations εγγραφές)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllCompanyCarReservations")" disabled />
                <br />
                <p>Διαγραφή των δεδομένων για το έτος {0} για τους δανεισμούς των εταιρικών αυτοκινήτων.</p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <select class="form-control" id="year-companycar">
                    <option>2022</option>
                    <option>2023</option>
                    <option>2024</option>
                    <option>2025</option>
                </select>
                <input class="form-control" id="companycar-input" value="@string.Format("{0}{1}?year={2}",@baseUrl, "Admin/DeleteCompanyCarReservationsByYear","2022")" disabled />
                <br />
                <br />
            </div>
            <br />
            <div>
                <h3><strong>Αιτήσεις - παράπονα</strong></h3>
                <p>Διαγραφή όλων των δεδομένων για τα παράπονα και αιτήσεις. <i>(@Model.Applications εγγραφές)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllApplications")" disabled />
                <br />
                <p>Διαγραφή των δεδομένων για το έτος {0} για τα παράπονα και αιτήσεις.</p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <select class="form-control" id="year-application">
                    <option>2022</option>
                    <option>2023</option>
                    <option>2024</option>
                    <option>2025</option>
                </select>
                <input class="form-control" id="application-input" value="@string.Format("{0}{1}?year={2}",@baseUrl, "Admin/DeleteApplicationsByYear","2022")" disabled />
                <br />
                <br />
            </div>
            <br />
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <script>
        $(function () {
            $("#year-truck").on('change', function () {
                var truckInput = document.getElementById("truck-input").value;
                document.getElementById("truck-input").value = truckInput.substring(0, truckInput.length - 4) + this.value;
            })
            $("#year-visitor").on('change', function () {
                var visitorInput = document.getElementById("visitor-input").value;
                document.getElementById("visitor-input").value = visitorInput.substring(0, visitorInput.length - 4) + this.value;
            })
            $("#year-companycar").on('change', function () {
                var companyCarInput = document.getElementById("companycar-input").value;
                document.getElementById("companycar-input").value = companyCarInput.substring(0, companyCarInput.length - 4) + this.value;
            })
            $("#year-application").on('change', function () {
                var applicationInput = document.getElementById("application-input").value;
                document.getElementById("application-input").value = applicationInput.substring(0, applicationInput.length - 4) + this.value;
            })

        });
    </script>
}