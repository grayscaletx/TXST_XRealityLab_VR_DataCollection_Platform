@model ARI.Models.ManufacturingOperationDTO

@{
    ViewData["Title"] = "Διαχείριση δεδομένων παραγωγής";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = new Uri($"{ ViewContext.HttpContext.Request.Scheme}://{ ViewContext.HttpContext.Request.Host}");
}

<div class="content-heading">
    <div>
        Διαχείριση δεδομένων παραγωγής πλατφόρμας
    </div>
</div>

<div class="card" style="max-width:1400px">
    <div class="card-body">
        <div class="col-md-8">
            <div>
                <h3><strong>Παραγγελίες όλων των δεδομένων</strong></h3>
                <p> - Διαγραφή δεδομένων παραγγελιών LIDL. <i>(@Model.OrdersLidl εγγραφές)</i></p>
                <p> - Διαγραφή δεδομένων παραγγελιών ARI. <i>(@Model.OrdersAri εγγραφές)</i></p>
                <p> - Διαγραφή δεδομένων συσκευαστηρίου. <i>(@Model.PackagingLine εγγραφές)</i></p>
                <p> - Διαγραφή δεδομένων παλετών. <i>(@Model.Pallets εγγραφές)</i></p>
                <p> - Εκκαθάριση δεδομένων αποθήκης. <i>(@Model.ReservedPallets δεσμευμένες θέσεις)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Δεν υπάρχει δυνατότητα ανάκτησης</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/DeleteAllProductionData")" disabled />
                <br />
                <br />
            </div>
            <br />
            <div>
                <h3><strong>SAP</strong></h3>
                <p>Τελευταία αποστολή των δεδομένων :<i>(15/08/22 14:35)</i></p>
                <p>Συγχρονισμός δεδομένων. <i>(- εγγραφές)</i></p>
                <p>
                    <strong>Είστε σύμφωνοι για αυτή την ένεργεια? Θα ανανεώθουν οι εγγραφές από το περιβάλλον SAP. Η συγκεκριμένη ενέργεια διαρκεί περίπου 10 λεπτά και προτείνεται να μην εκτελείται παραπάνω από 2 φορές την ημέρα.</strong>
                </p>
                <input class="form-control" id="ref" value="@string.Format("{0}{1}",@baseUrl, "Admin/SyncSAPData")" disabled />
                <br />
            </div>
            <br />
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <script>
        $(function () {
            $("#year-order-lidl").on('change', function () {
                var orderLidlInput = document.getElementById("order-lidl-input").value;
                document.getElementById("order-lidl-input").value = orderLidlInput.substring(0, orderLidlInput.length - 4) + this.value;
            })


        });
    </script>
}