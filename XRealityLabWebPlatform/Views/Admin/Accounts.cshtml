@model List<ARI.Models.OrganizationDTO>
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>Organizations</strong>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--Projects Cards-->
<div class="card">
    <div class="card-columns">
        @foreach (var item in Model)
        {

            <div class="card" style="background-color : @item.Color; color: white; height:320px; width:400px" onclick="location.href='#'">
                <div align="right">
                    <a class="fa-2x mr-2 fas fa-ellipsis-h text-white" data-toggle="dropdown"></a>
                    <div class="dropdown-menu" role="menu">
                        <a class="dropdown-item" href="#">Edit Organization</a>
                        <a class="dropdown-item" href="#">Reset Password</a>
                        <a class="dropdown-item" href="#">Remove Organization</a>
                    </div>
                </div>
                <div align="center">
                    <img src="~/images/bg1.jpg" alt="Avatar" width="90" height="90" class="rounded-circle" />
                </div>
                <br>
                <div align="left"><h3>@item.FullName</h3> </div>
                <br>
                <div class="card-header" style="background-color : dimgray ; color: white"><strong>Research Director</strong></div>
                <div class="card-body" style="background-color : white ; color: black">
                    <ul class="list-unstyled">
                        <li class="fa-2x fa-2x mr-2 far fa-envelope"> @(item.ITDirector.Firstname + " " + item.ITDirector.Lastname)</li>
                    </ul>
                </div>
            </div>
        }
        <div class="card" style="background-color : white; color:cyan; height:320px; width:400px; border:dashed; border-color:aqua" onclick="location.href='/Admin/AddNewOrganization'">
           New Organization
        </div>
    </div>
</div>

@section Styles {
        <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
        <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
        <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">        
}

@section Scripts {
    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>
}
