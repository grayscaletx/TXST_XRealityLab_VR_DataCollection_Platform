@model ARI.Models.GuestDTO
@using System.Globalization;

@{
    ViewData["Title"] = "Προσθήκη επισκέπτη";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = TimeZoneInfo.FindSystemTimeZoneById("E. Europe Standard Time");
    DateTimeOffset localServerTime = DateTimeOffset.Now;
}

<div class="content-heading">
    <div>
        Προσθήκη Επισκέπτη
    </div>
</div>

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Έλεγχος πρόσβασης \ Επισκέπτες</div>
        <div class="text-sm">Πρόσθεσε τις πληροφορίες του επισκέπτη.</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="AddVisitor">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label> (*)
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label> (*)
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedCompany, htmlAttributes: new { @class = "control-label" }) (*)
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedCompany, new SelectList(Model.CompanyListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "Company" })
                        @Html.ValidationMessageFor(x => x.SelectedCompany, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <input class="control-label" id="companyCheckBox" type="checkbox" value="option1" />
                    <label asp-for="CompanyName" class="control-label">Νέα εταιρία (*)</label>
                    <input asp-for="CompanyName" class="form-control" id="companyText" disabled />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-group">
                    <label asp-for="VisitationPurpose" class="control-label"></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text">Περιγραφή</span>
                        </div>
                        <textarea class="form-control" aria-label="With textarea" asp-for="VisitationPurpose"></textarea>
                        <span asp-validation-for="VisitationPurpose" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Telephone" class="control-label"></label>
                    <input asp-for="Telephone" class="form-control" />
                    <span asp-validation-for="Telephone" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ArrivalDateTime" class="control-label"></label> (*)
                    <input asp-for="ArrivalDateTime" class="form-control" type="datetime" name="ArrivalDateTime" id="arrivalDatePicker" value=@TimeZoneInfo.ConvertTime(localServerTime, info) />
                    <span asp-validation-for="ArrivalDateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input class="control-label" id="departureCheckBox" type="checkbox" value="option1" />
                    <label asp-for="DepartureDateTime" class="control-label"></label>
                    <input asp-for="DepartureDateTime" class="form-control datepicker" type="datetime" name="DepartureDateTime" id="departureDatePicker" disabled />
                    <span asp-validation-for="DepartureDateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Προσθήκη" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="VisitorList">Επιστροφή στη λίστα με τους επισκέπτες</a>
</div>

@section Scripts {
    <script src="~/js/jquery-3.6.0.slim.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>

    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    @*<script src="~/js/signature_pad.min.js"></script>*@
    <script>
        $(function () {
            $('#arrivalDatePicker').datetimepicker();
            $('#departureDatePicker').datetimepicker();
        });
        document.getElementById('companyCheckBox').onchange = function () {
            document.getElementById('companyText').disabled = !this.checked;
            document.getElementById('Company').disabled = this.checked;
            document.getElementById('Company').selectedIndex = 0;
            document.getElementById('companyText').value = '';
        };
        document.getElementById('departureCheckBox').onchange = function () {
            document.getElementById('departureDatePicker').disabled = !this.checked;
            document.getElementById("departureDatePicker").value = '';
        };
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}