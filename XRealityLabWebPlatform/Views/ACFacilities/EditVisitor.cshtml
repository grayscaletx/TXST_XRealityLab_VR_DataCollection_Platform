@model ARI.Models.GuestDTO
@using System.Globalization;

@{
    ViewData["Title"] = "Προσθήκη ώρας αναχώρησης του επισκέπτη";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = TimeZoneInfo.FindSystemTimeZoneById("E. Europe Standard Time");
    DateTimeOffset localServerTime = DateTimeOffset.Now;
}

<div class="content-heading">
    <div>
        ΚΕ @Model.GuestId
    </div>
    <!-- END Language list-->
</div>

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Έλεγχος πρόσβασης \ Επισκέπτες</div>
        <div class="text-sm">Προσθέστε την ώρα αναχώρησης του επισκέπτη</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="EditVisitor">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PassToken" />
                <div class="form-group">
                    <label asp-for="DepartureDateTime" class="control-label"></label>
                    <input asp-for="DepartureDateTime" class="form-control datepicker" type="datetime" name="DepartureDateTime" id="departureDatePicker" value=@TimeZoneInfo.ConvertTime(localServerTime, info) />
                    <span asp-validation-for="DepartureDateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Ανανέωση" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="VisitorList">Επιστροφή στη λίστα με τους επισκέπτες</a>
</div>

@section Scripts {
    <script src="~/js/jquery-3.6.0.slim.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>

    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    @*<script src="~/js/signature_pad.min.js"></script>*@
    <script>
        $(function () {
            $('#departureDatePicker').datetimepicker();
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}