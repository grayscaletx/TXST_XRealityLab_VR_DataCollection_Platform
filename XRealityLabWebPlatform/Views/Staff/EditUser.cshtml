@model XRealityLab.Application.UserDTO1;
@using System.Security.Claims;
@using XRealityLab.Common;

@{
    ViewData["Title"] = "Επεξεργασία ρόλου";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>

    </div>
    <!-- END Language list-->
</div>

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Προσωπικό \ Χρήστες</div>
        <div class="text-sm">Προσθέστε το ρόλο του χρήστη.</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="EditUser">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PassToken" />
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedRole, htmlAttributes: new { @class = "control-label" })
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedRole, new SelectList(Model.RoleListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "Role" })
                        @Html.ValidationMessageFor(x => x.SelectedRole, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Ανανέωση" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="UserList">Επιστροφή στη λίστα με τους χρήστες</a>
</div>

@section Scripts {
    <script src="~/js/jquery-3.6.0.slim.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>

    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    @*<script src="~/js/signature_pad.min.js"></script>*@
    <script>
        $(function () {
            $('#departureDatePicker').datetimepicker();
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}