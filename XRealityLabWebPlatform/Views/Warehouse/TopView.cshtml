            </table>
        }
    </div>

    <div id="container-area-2" hidden>@Model.PalletDTOs.Where(k => k.LoadingAreaID == 2).Count()</div>
    <div id="container-area-7" hidden>@Model.PalletDTOs.Where(k => k.LoadingAreaID == 7).Count()</div>
    <div id="container-area-8" hidden>@Model.PalletDTOs.Where(k => k.LoadingAreaID == 8).Count()</div>
    <br />
    <br />
</div>


