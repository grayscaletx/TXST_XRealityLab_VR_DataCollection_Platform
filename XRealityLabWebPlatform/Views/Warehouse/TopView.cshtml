                <a href="" id="modal-pallet-palletcard-lidl" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση παλετοκάρτας LIDL</a>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
}

