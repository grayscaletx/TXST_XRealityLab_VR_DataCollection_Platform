@model List<ARI.Models.LoadDTO>
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Έντυπα παλετών";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        Παραγγελίες ARI
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--ARI Order list-->
<div class="card" style="max-width:1400px">
    <div class="card-header">
        <div class="card-title">Φόρτωση \ Φορτώσεις (Picking)</div>
        <div class="text-sm" style="max-width:900px">
            Για τη δημιουργία μίας νέας φόρτωσης χρειάζεται να επιλέξετε τις παραγγελίες και τις παλέτες. Όταν υπάρχει σωστή ποσότητα παλλετών για κάθε παραγγελία το σύστημα
            σας επιτρέπει να προχωρήσετε στο επόμενο βήμα, στην ταυτοποίηση παλετoκάρτας ARI με Lidl.<i>(Εάν οι παραγγελίες δεν έχουν ship-to-party ή sold-to-party δεν εμφανίζονται στην παρακάτω λίστα)</i>
        </div>
        <a asp-action="AddBlankLoad" class="mb-1 btn btn-primary" type="button" style="float: right;display:inline">Δημιουργία νέου εντύπου φόρτωσης</a>
    </div>
    <div class="card-body">
        <table class="table table-striped my-5 w-100" id="packagingLineDataTable">
            <thead>
                <tr>
                    <th>Α/Α</th>
                    <th style="text-align: center">Ημερομηνία δημιουργίας</th>
                    <th style="text-align: center"></th>
                    <th style="text-align: center"></th>
                    <th style="text-align: center"></th>
                    <th style="text-align: center">Αριθμός παραγγελιών</th>
                    <th style="text-align: center">Αριθμός παλετών από παραγγελίες</th>
                    <th style="text-align: center">Αριθμός παλετών από αποθήκη / απόθεμα</th>
                    <th style="text-align: center">Ταύτιση</th>
                    <th style="text-align: center">Κατάσταση</th>
                    <th style="text-align: center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr class="gradeX">
                    @{
                        string badgeClass = "badge-" + (item.StatusId == -1 ? "danger" : item.StatusId == 0 ? "success" :
                        item.StatusId == 1 ? "warning" : item.StatusId == 2 ? "dark" : "");
                        string identificationIcon = item.LoadMetricsDTO.IsIdentified
                            && item.LoadMetricsDTO.NoOrderPallets != 0 && item.LoadMetricsDTO.NoPallets != 0 ? "/images/correct.png" : "/images/warning.png";
                    }
                    <td data-sort="@item.LoadId">
                        <a>ΠΑ @item.LoadId</a>
                    </td>
                    <td style="text-align: center">@item.CreationDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    @if (item.StatusId == 1)
                    {
                        <td style="display:inline-block"><a href=@item.PalletCardsLIDL id="modal-load-palletcard-lidl" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">παλετοκάρτα LIDL</a></td>
                        <td style="display:inline-block"><a href=@item.DriverDocuments id="modal-load-documents-driver" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">εγγράφα οδηγού</a></td>
                        <td style="display:inline-block"><a href=@item.CMRDocuments id="modal-pallet-documents-CMR" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">εγγράφα CMR</a></td>
                    }
                    else
                    {
                        <td style="display:none"><a href="" id="modal-load-palletcard-lidl" target="_blank" class="btn btn-primary" style="display:none;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση παλετοκάρτας LIDL</a></td>
                        <td style="display:none"><a href="" id="modal-load-documents-driver" target="_blank" class="btn btn-primary" style="display:none;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση εγγράφων οδηγού</a></td>
                        <td style="display:none"><a href="" id="modal-pallet-documents-CMR" target="_blank" class="btn btn-primary" style="display:none;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση εγγράφων CMR</a></td>
                    }
                    <td style="text-align: center">@item.LoadMetricsDTO.NoOrders</td>
                    <td style="text-align: center"><strong>@item.LoadMetricsDTO.NoOrderPallets</strong></td>
                    <td style="text-align: center"><strong>@item.LoadMetricsDTO.NoPallets</strong></td>
                    <td style="text-align: center"><img height="20" src="@identificationIcon" title="@item.LoadMetricsDTO.Label" /></td>
                    <td style="text-align: center"><div class="badge @badgeClass">@item.SelectedStatus</div></td>
                    <td class="ibox-tools">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-cog"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li style="margin:2px 0">
                                @if (item.StatusId == 0)
                                {
                                    <a class="btn btn-primary" asp-action="EditLoadOrders" asp-route-passToken="@item.PassToken">Επεξεργασία παραγγελιών</a>
                                }
                            </li>
                            <li style="margin:2px 0">
                                @if (item.StatusId == 0)
                                {
                                    <a class="btn btn-primary" asp-action="EditLoadPallets" asp-route-passToken="@item.PassToken">Επεξεργασία παλετών</a>
                                }
                            </li>
                            <li style="margin:2px 0">
                                @if (item.StatusId != 0)
                                {
                                    <a class="btn btn-primary" asp-action="ChangeOrderARIStatus" asp-route-formStatus="0" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Αναίρεση επικαιροποίησης / Ενεργοποίηση</a>
                                }
                                else if (item.IsMatch)
                                {
                                    <a class="btn btn-primary" asp-action="ChangeOrderARIStatus" asp-route-formStatus="1" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Επικαιροποιήση εντύπου φόρτωσης</a>
                                }
                            </li>
                            <li style="margin:2px 0">
                                @if (item.StatusId != -1)
                                {
                                    <a class="btn btn-primary" asp-action="ChangeOrderARIStatus" asp-route-formStatus="-1" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Ακύρωση εντύπου φόρτωσης</a>
                                }
                            </li>
                            <li style="margin:2px 0">
                                @if (item.StatusId == 1)
                                {
                                    <a href=@item.LIDLOrderHeaders target="_blank" class="btn btn-primary">LIDL Headers</a>
                                }
                            </li>
                            <li style="margin:2px 0">
                                @if (item.StatusId == 1)
                                {
                                    <a href=@item.LIDLOrderLines target="_blank" class="btn btn-primary">LIDL Lines</a>
                                }
                            </li>
                        </ul>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">
}

@section Scripts {
    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>

}
