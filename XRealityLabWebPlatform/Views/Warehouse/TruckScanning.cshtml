@section Scripts {
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script src="/barcode/gs1/beep.js"></script>
    <script src="/barcode/scanner/onscan.js"></script>
    <script>
        //Scanner
        function initOnScan() {
            var suffixKeyCodes = [];
            var prefixKeyCodes = [];

            var options = {
                suffixKeyCodes: suffixKeyCodes,
                prefixKeyCodes: prefixKeyCodes,
            }

            options.onScan = function (barcode) {
                if (document.getElementById('truck-order').value == "-") {
                    alert('Επιλέξτε φορτηγό');
                    return;
                }
                //alert(barcode);
                scannerValidation(barcode);
            };

            try {
                onScan.attachTo(document, options);
            } catch (e) {
                onScan.setOptions(document, options);
            }
        }

        (function () {
            initOnScan();
        })();

        temp_scanPalletAri = "";
        temp_scanPalletLidl = "";
        //Validation
        function scannerValidation(barcode) {
            var truck_order = document.getElementById('truck-order').value;

            $.get("GetScannedBarcodeData/?truckId=" + truck_order + "&barcode=" + barcode, function (message) {

                if (message == "no valid") {
                    document.getElementById('temp-panel').style.display = "none";
                    //timer javascript
                }
                else {

                    if (temp_scanPalletAri != "" && barcode.length <= 20) { return; }

                    if (temp_scanPalletLidl != "" && barcode.length >= 20) { return; }

                    document.getElementById('temp-panel').style.display = "block";
                    var fifteenSeconds = 15, display = document.querySelector('#temp-timer');
                    startTimer(fifteenSeconds, display);
                    document.getElementById('temp-pallet-code').innerHTML = message.palletId;
                    document.getElementById('temp-pallet-lot').innerHTML = message.palletLOT;
                    document.getElementById('temp-pallet-sapid').innerHTML = message.material.materialSAPID;
                    document.getElementById('temp-pallet-description').innerHTML = message.material.materialDescription;

                    if (barcode.length >= 20) {
                        document.getElementById('temp-lidl-icon').src = "/images/ok.jpg";
                        temp_scanPalletLidl = message.palletId;
                    }
                    else {
                        document.getElementById('temp-ari-icon').src = "/images/ok.jpg";
                        temp_scanPalletAri = message.palletId;
                    }
                }

                if (temp_scanPalletAri != "" && (temp_scanPalletAri == temp_scanPalletLidl)) {
                    document.getElementById('temp-panel').style.display = "block";
                    //change color to blue
                    for (const pallet_identifier of document.getElementsByClassName("pallet-identifier")) {
                        if (pallet_identifier.innerHTML == temp_scanPalletAri) {

                            pallet_identifier.parentElement.style.background = "#62d9ff";
                            scanPalletIds.push(temp_scanPalletAri);
                            document.getElementById("scan-truck-no").textContent = "Φορτώθηκαν: " + scanPalletIds.length;
                            beep.play();
                            temp_scanPalletAri = "";
                            temp_scanPalletLidl = "";
                            document.getElementById('temp-panel').style.display = "none";

                            //if (truckPalletsCount == scanPalletIds.length) {
                            //    document.getElementById("complete-truck-btn").disabled = false;
                            //}
                            //to continue
                            break;
                        }
                    }
                }



            });
        }

        function startTimer(duration, display) {
            var timer = duration, minutes, seconds;
            setInterval(function () {
                minutes = parseInt(timer / 60, 10);
                seconds = parseInt(timer % 60, 10);

                minutes = minutes < 10 ? "0" + minutes : minutes;
                seconds = seconds < 10 ? "0" + seconds : seconds;

                display.textContent = minutes + ":" + seconds;

                if (--timer < 0) {
                    timer = duration;
                    //stop timer, hide panel
                    temp_scanPalletAri = "";
                    temp_scanPalletLidl = "";
                    document.getElementById('temp-panel').style.display = "none";
                }
            }, 1000);
        }



        //Warehouse
        lastSelectionStatus = 3;
        lastPalletToLoadElement = "";
        lastWarehousePalletElement = "";
        noTruckPalletSala1 = 0;
        noTruckPalletSala1Psigeio = 0;
        noTruckPalletProektasi = 0;
        noTruckPalletSala2Deksia = 0;
        noTruckPalletSala2Aristera = 0;
        noTruckPalletSala2Domatio = 0;
        noTruckPalletMakio = 0;
        noTruckPalletEikoniki = 0;
        noTruckPallet = 0;
        var pallet_warehouse_btns = document.getElementsByClassName('pallet-warehouse-btn');

        //clear values
        var trackOrderTemp = document.getElementById('truck-order');
        trackOrderTemp.selectedIndex = 0;

        function CloseSuccessDialog() {
            window.location = '/Warehouse/TruckOrders?succeededPastAction=false';
        }

        selectedTruck = false;
        truckPalletsCount = 0;
        scanPalletIds = [];
        //Warehouse
        for (var i = 0; i < pallet_warehouse_btns.length; i++) {

            //pallet_warehouse_btns[i].addEventListener('click', function (event) {
            //    pallet_btn = event.currentTarget;

            //    if ((pallet_btn.style.getPropertyValue('background-color') == "#62d9ff" || pallet_btn.style.getPropertyValue('background-color') == "purple")
            //        && pallet_btn.parentElement.firstElementChild.src == "/images/scanning_icon.png" || selectedTruck == true) {
            //    }
            //    else {
            //        return;
            //    }

            //    if (pallet_btn.style.getPropertyValue('background-color') == "purple") {

            //        if (!scanPalletIds.includes(pallet_btn.getElementsByClassName("pallet-identifier")[0].innerHTML)) {
            //            scanPalletIds.push(pallet_btn.getElementsByClassName("pallet-identifier")[0].innerHTML);
            //            document.getElementById("scan-truck-no").textContent = "Φορτώθηκαν: " + scanPalletIds.length;
            //        }

            //        pallet_btn.style.background = "#62d9ff";
            //        for (const child of pallet_btn.children)
            //            if (child.nodeName == "P")
            //                child.style.color = "black";

            //        if (truckPalletsCount == scanPalletIds.length) {
            //            document.getElementById("complete-truck-btn").disabled = false;
            //        }

            //        beep.play();
            //    }
            //    else {
            //        //if (selectedPalletIds.includes(pallet_btn.getElementsByClassName("pallet-identifier")[0].innerHTML)) {
            //        //    selectedPalletIds = selectedPalletIds.filter(item => item !== pallet_btn.getElementsByClassName("pallet-identifier")[0].innerHTML);
            //        //}
            //    }
            //});

            pallet_warehouse_btns[i].addEventListener('dblclick', function (event) {
                var urlString = "?warehouseName=" + event.currentTarget.parentElement.id + "&loadinglineId=" + event.currentTarget.parentNode.parentNode.childNodes[1].id + "&itemId=" + event.currentTarget.id.split('-')[4];

                $.get("GetPalletWarehouseInfo/" + urlString, function (data) {
                    document.getElementById("modal-pallet-label").innerHTML = "Επικαιροποίηση φόρτωσης";
                    document.getElementById("modal-pallet-material-description").innerHTML = data.material.materialDescription;
                    document.getElementById("modal-pallet-sapid").innerHTML = data.material.materialSAPID;
                    document.getElementById("modal-pallet-lot").innerHTML = data.material.materialLOT;
                    document.getElementById("modal-pallet-country").innerHTML = data.countryCode;
                    document.getElementById("modal-pallet-pallet-boxes").innerHTML = data.noPalletBox;
                    document.getElementById("modal-pallet-creation-time").innerHTML = data.creationDateTime;
                    document.getElementById("modal-pallet-max-delivery-date").innerHTML = formatDate(data.material.maxDeliveryDate);
                    document.getElementById("modal-pallet-expiration-date").innerHTML = formatDate(data.material.expirationDate);
                    document.getElementById("modal-qr-image").src = data.qrCodeLink;
                    document.getElementById("modal-barcode-image").src = data.barCodeLink;
                    document.getElementById("modal-pallet-palletcard").href = data.palletCardLink;
                    document.getElementById("modal-pallet-palletcard-lidl").href = data.palletCardLIDL;
                    if (data.palletCardLIDL == null) {
                        document.getElementById("modal-pallet-palletcard-lidl").hidden = true;
                    }
                    else {
                        document.getElementById("modal-pallet-palletcard-lidl").hidden = false;
                    }

                    //Status
                    document.getElementById("modal-pallet-status-badge").innerHTML = data.selectedStatus;
                    document.getElementById("modal-pallet-status-badge").className = "";
                    document.getElementById("modal-pallet-status-badge").classList.add('badge');
                    if (data.statusId == 0) {
                        document.getElementById("modal-pallet-status-badge").innerHTML = data.selectedStatus;
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-warning');
                    }
                    else if (data.statusId == 1) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-success');
                    }
                    else if (data.statusId == 2) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-info');
                        document.getElementById("modal-pallet-status-badge").style.color = "black";
                    }
                    else if (data.statusId == 3) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-dark');
                        document.getElementById("modal-pallet-status-badge").style.color = "white";
                    }
                    else if (data.statusId == 4) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-purple');
                        document.getElementById("modal-pallet-status-badge").style.color = "white";
                    }
                    else if (data.statusId == -1) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-success');
                    }
                });
                $('#PalletDialog').modal('toggle');
            });
        }

        function formatDate(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            return [day, month, year].join('-');
        }

        function finalizeTruck() {
            var truckId = document.getElementById('truck-order').value;

            var formData = new FormData();
            formData.append('truck-id', truckId);

            $.ajax({
                type: "post",
                url: "/Warehouse/FinalizeTruck",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    window.location = '/Warehouse/TruckScanning';
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }

        $("#truck-order").change(function () {
            var truck_order = document.getElementById('truck-order').value;

            for (const pallet_icon of document.getElementsByClassName("pallet-icon")) {
                if (pallet_icon.src.includes("scanning_icon")) {
                    pallet_icon.src = "/images/pallet__small_icon.png";
                }
            }

            if (truck_order != "-") {
                $.get("GetOrderPalletPositions/?truckId=" + truck_order, function (message) {
                    $("#truck-order").prop("disabled", true);

                    truckPalletsCount = message.palletBtnIds.length;
                    document.getElementById("truck-sum-no").textContent = "Συνολικός αριθμός παλετών: " + truckPalletsCount;

                    selectedTruck = true;

                    for (const element of message.palletBtnIds) {
                        for (const pallet_identifier of document.getElementsByClassName("pallet-identifier")) {
                            if (pallet_identifier.innerHTML == element) {
                                pallet_identifier.parentElement.firstElementChild.src = "/images/scanning_icon.png";
                                break;
                            }
                        }
                    }
                });
            }
            else {
            }
        });
    </script>
}
