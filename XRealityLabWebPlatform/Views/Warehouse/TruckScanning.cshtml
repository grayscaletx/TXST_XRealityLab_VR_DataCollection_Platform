                    <img src="~/images/pallet_icon.png" style="display:block;margin-left:auto;margin-right:auto" width="50" height="50" />
                    <br />
                    <p style="font-size:16px">Κωδικοποίηση παλέτας: <strong id="modal-pallet-material-description">-</strong></p>
                    <p style="font-size:16px">Κωδικός SAP προϊόντος: <strong id="modal-pallet-sapid">-</strong></p>
                    <p style="font-size:16px">LOT παλέτας: <strong id="modal-pallet-lot">-</strong></p>
                    <p style="font-size:16px">Χώρα: <strong id="modal-pallet-country">-</strong></p>
                    <p style="font-size:16px">Αριθμός χαρτοκιβωτίων: <strong id="modal-pallet-pallet-boxes">-</strong></p>
                    <p style="font-size:16px">Ώρα συσκευασίας: <strong id="modal-pallet-creation-time">-</strong></p>
                    <p style="font-size:16px">Μέγιστη ημερομηνία παράδοσης: <strong id="modal-pallet-max-delivery-date">-</strong></p>
                    <p style="font-size:16px">Ημερομηνία λήξης της παλέτας: <strong id="modal-pallet-expiration-date">-</strong></p>
                    <p style="font-size:16px">QR παλέτας:</p>
                    <img style="display: block; margin-left: auto; margin-right: auto" id="modal-qr-image" width="300" height="300" />
                    <p style="font-size:16px">Barcode παλέτας:</p>
                    <img style="display: block; margin-left: auto; margin-right: auto" id="modal-barcode-image" width="300" height="80" />
                </div>
                <a href="" id="modal-pallet-palletcard" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;max-width:200px">Εκτύπωση παλετοκάρτας ARI</a>
                <a href="" id="modal-pallet-palletcard-lidl" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση παλετοκάρτας LIDL</a>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
}

