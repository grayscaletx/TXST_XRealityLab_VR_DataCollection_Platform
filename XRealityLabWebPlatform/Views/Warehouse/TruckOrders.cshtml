            if (truck_order != "-") {
                $.get("GetOrderPalletPositions/?truckId=" + truck_order, function (message) {
                    document.getElementById("truck_creation_date").textContent = "Ημ. δημιουργίας εγγράφου φόρτωσης: " + formatDate(message.creationDateTime);



                    for (const element of message.palletBtnIds) {
