        function formatDate(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            return [day, month, year].join('-');
        }

        function CheckPalletMaxDates() {
            var maxDate = new Date(document.getElementById('maxDeliveryDatePicker').value);
            var confirmationMessage = "";
            for (var i = 0; i < pallet_warehouse_btns.length; i++) {
                if (pallet_warehouse_btns[i].style.getPropertyValue('background-color') == "blue") {
                    var dateParts = pallet_warehouse_btns[i].children[4].innerText.split("/");
                    var tempDate = new Date("20" + +dateParts[2], dateParts[1] - 1, +dateParts[0]);
                    if (tempDate >= maxDate) {
                        confirmationMessage = confirmationMessage + " " + "Η παλέτα " + pallet_warehouse_btns[i].children[1].innerText + "|" +
                            pallet_warehouse_btns[i].children[2].innerText + "|" + pallet_warehouse_btns[i].children[3].innerText + "|"
                            + pallet_warehouse_btns[i].children[4].innerText + " έχει μεταγενέστερη ημερομηνία λήξης από την ημερομηνία λήξης που καθορίσατε. \n\n";
                    }
                }
            }
            if (!isValidDate(maxDate))
                document.getElementById("confirmation-message").textContent = "Δεν έχει επιλεχθεί επιθυμητή ημερομηνία";
            else if (confirmationMessage == "")
                document.getElementById("confirmation-message").textContent = "Οκ";
            else
                document.getElementById("confirmation-message").textContent = confirmationMessage;
        }
        function isValidDate(d) {
            return d instanceof Date && !isNaN(d);
        }

        $("#truck-order").change(function () {
            var truck_order = document.getElementById('truck-order').value;
            document.getElementById("truck_creation_date").textContent = "Ημ. δημιουργίας εγγράφου φόρτωσης: -";

            for (const pallet_icon of document.getElementsByClassName("pallet-icon")) {
                if (pallet_icon.src.includes("pallet_filter_small_icon")) {
