@model IEnumerable<ARI.Models.WarehouseSuppliesDTO>

@{
    ViewData["Title"] = "Προσθήκη EDI εγγράφου";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-heading">
    <div>
        Αποθέματα
        <small>Στους παρακάτω πίνακες προβάλετε η διαθεσιμότητα των προιόντων</small>
    </div>
</div>
<a id="download-btn" asp-action="DownloadWarehouseData" class="mb-1 btn btn-primary" type="button" style="float: right">Εξαγωγή δεδομένων</a>


<div class="card" style="max-width:800px">
    <div class="card-header">
        <div class="badge badge-success" style="margin:0px 10px">Δημιουργήθηκε</div> <i>(Παλέτες που έχουν δημιουργηθεί αλλά δεν έχουν τοποθετηθεί στην αποθήκη)</i>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered table-hover" id="table-ext-2">
            <thead>
                <tr>
                    <th>SAP Code</th>
                    <th>Material</th>
                    <th>LOT</th>
                    <th>Family</th>
                    <th>Seasonality</th>
                    <th>Country</th>
                    <th>Άθροισμα</th>
                    <th>Μεγ.ημ.παράδ.</th>
                    <th>Ημ.λήξης</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Where(k => k.suppliesMetricsDTOs[0].Sum != 0))
                {
                    <tr class="gradeX">
                        <td style="text-align: center">@item.MaterialDTO.MaterialSAPID</td>
                        <td style="text-align: center">@item.MaterialDTO.MaterialDescription</td>
                        <td style="text-align: center">@item.MaterialDTO.MaterialLOT</td>
                        <td style="text-align: center"> - </td>
                        <td style="text-align: center"> - </td>
                        <td style="text-align: center">@item.MaterialDTO.LanguageCode</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[0].Sum</td>
                        <td style="text-align: center">@item.MaterialDTO.MaxDeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td style="text-align: center">@item.MaterialDTO.ExpirationDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="badge badge-info" style="margin:0px 10px">
            Προστέθηκε στην αποθήκη
        </div><i>(Παλέτες τοποθετημένες στην αποθήκη)</i>
    </div>
    <div class="card-body" style="overflow-y: scroll">
        <table class="table table-striped table-bordered table-hover" id="table-ext-2">
            <thead>
                <tr>
                    <th>SAP Code</th>
                    <th>Material</th>
                    <th>LOT</th>
                    <th>Family</th>
                    <th>Seasonality</th>
                    <th>Country</th>
                    <th>ΣΑΛΑ 1</th>
                    <th>ΣΑΛΑ 1 ΨΥΓΕΙΟ</th>
                    <th>ΠΡΟΕΚΤΑΣΗ</th>
                    <th>ΣΑΛΑ 2 ΔΕΞΙΑ</th>
                    <th>ΣΑΛΆ 2 ΑΡΙΣΤΕΡΑ</th>
                    <th>ΣΑΛΑ 2 ΔΩΜΑΤΙΟ</th>
                    <th>ΜΑΚΙΟ</th>
                    <th>Άθροισμα</th>
                    <th>Μεγ.ημ.παράδ.</th>
                    <th>Ημ.λήξης</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Where(k => k.suppliesMetricsDTOs[1].Sum != 0))
                {
                    <tr class="gradeX">
                        <td style="text-align: center">@item.MaterialDTO.MaterialSAPID</td>
                        <td style="text-align: center">@item.MaterialDTO.MaterialDescription</td>
                        <td style="text-align: center">@item.MaterialDTO.MaterialLOT</td>
                        <td style="text-align: center"> - </td>
                        <td style="text-align: center"> - </td>
                        <td style="text-align: center">@item.MaterialDTO.LanguageCode</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sala1</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sala1Psigeio</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Proektasi</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sala2Deksia</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sala2Aristera</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sala2Dwmatio</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Makio</td>
                        <td style="text-align: center">@item.suppliesMetricsDTOs[1].Sum</td>
                        <td style="text-align: center">@item.MaterialDTO.MaxDeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td style="text-align: center">@item.MaterialDTO.ExpirationDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

