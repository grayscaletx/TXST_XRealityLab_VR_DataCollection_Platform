@section Scripts {
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script>
        //Initialize
        var [pallet_warehouse_btns, line_pallet_btns, filterIboxButton, searchPallets, noSelectedPallets, savePalletsBtn] = [];
        var [modalVirtual, modalLabel, modalDescription, modalSAPId, modalLOT, modalCountry, modalBoxes,
            modalCreation, modalDeliveryDate, modalExpirationDate, modalQR, modalBarcode, modalCardARI, modalCardLidl] = [];
        var [sala1Title, sala1Warehouse, sala1PsigeioTitle, sala1PsigeioWarehouse, proektasiTitle, proektasiWarehouse, sala2DeksiaTitle, sala2DeksiaWarehouse, sala2AristeriTitle,
            sala2AristeriWarehouse, sala2DomatioTitle, sala2DomatioWarehouse, makioTitle, makioWarehouse, eikonikiTitle, eikonikiWarehouse] = []
        palletCount = 0;
        init();
        savedIds = [];
        selectedIds = [];
        saveIds = @Html.Raw(Json.Serialize(Model.WarehouseDTO.PalletDTOs.Where(k => k.IsSelectedForLoad).Select(k => k.PalletId).ToList()));

        //Info for warehouse pallets (click) (dbclick)
        for (var i = 0; i < pallet_warehouse_btns.length; i++) {
            currentPalletId = pallet_warehouse_btns[i].getElementsByClassName("pallet-identifier")[0].innerHTML.trim();
            if (saveIds.includes(parseInt(currentPalletId))) {
                pallet_warehouse_btns[i].style.background = "purple";
                for (const child of pallet_warehouse_btns[i].children)
                    if (child.nodeName == "P")
                        child.style.color = "white";
            }

            pallet_warehouse_btns[i].addEventListener('click', function (event) {
                pallet_btn = event.currentTarget;
                backgroundColor = pallet_btn.style.getPropertyValue('background-color');
                currentPalletId = pallet_btn.getElementsByClassName("pallet-identifier")[0].innerHTML;

                if (saveIds.includes(currentPalletId))
                    pallet_btn.style.background = "purple";


                if (backgroundColor == "black" || backgroundColor == "purple")
                    return;


                if (backgroundColor == "yellow") {
                    pallet_btn.style.background = "blue";
                    for (const child of pallet_btn.children)
                        if (child.nodeName == "P")
                            child.style.color = "white";

                    palletCount = palletCount + 1;
                }
                else {
                    pallet_btn.style.background = "yellow";
                    for (const child of pallet_btn.children)
                        if (child.nodeName == "P")
                            child.style.color = "black";

                    palletCount = palletCount - 1;
                }

                if (!selectedIds.includes(currentPalletId)) {
                    selectedIds.push(currentPalletId);
                } else {
                    selectedIds.splice(selectedIds.indexOf(currentPalletId), 1);
                }
                noSelectedPallets.innerText = selectedIds.length;
                savePalletsBtn.classList.remove("disabled");
                if (selectedIds.length == 0) {
                    savePalletsBtn.classList.add("disabled");
                }
                else {
                    savePalletsBtn.classList.remove("disabled");
                }
            });
            pallet_warehouse_btns[i].addEventListener('dblclick', function (event) {
                var urlString = "?warehouseName=" + event.currentTarget.parentElement.id + "&loadinglineId=" + event.currentTarget.parentNode.parentNode.childNodes[3].id + "&itemId=" + event.currentTarget.id.split('-')[4];

                $.get("GetPalletWarehouseInfo/" + urlString, function (data) {
                    modalLabel.innerHTML = "Κωδικός παλέτας ΚΠ" + data.palletId;
                    modalDescription.innerHTML = data.material.materialDescription;
                    modalVirtual.src = data.isVirtual ? "/images/virtual_pallet__icon.png" : "/images/pallet_icon.png";
                    modalSAPId.innerHTML = data.material.materialSAPID;
                    modalLOT.innerHTML = data.palletLOT;
                    modalCountry.innerHTML = data.countryCode;
                    modalBoxes.innerHTML = data.noPalletBox;
                    modalCreation.innerHTML = data.creationDateTime;
                    modalDeliveryDate.innerHTML = formatDate(data.material.maxDeliveryDate);
                    modalExpirationDate.innerHTML = formatDate(data.material.expirationDate);
                    modalQR.src = data.qrCodeLink;
                    modalBarcode.src = data.barCodeLink;
                    modalCardARI.href = data.palletCardLink;
                    modalCardLidl.href = data.palletCardLIDL;
                    modalCardLidl.hidden = data.palletCardLIDL == null ? true : false;

                    modalStatusBadge.innerHTML = data.selectedStatus
                    modalStatusBadge.className = "";
                    modalStatusBadge.classList.add('badge');
                    modalStatusBadge.classList.add(data.statusId == 0 ? 'badge-warning' : data.statusId == 1 ?
                        'badge-success' : data.statusId == 2 ? 'badge-info' : data.statusId == 3 ? 'badge-dark' : data.statusId == 4 ?
                            'badge-danger' : data.statusId == -1 ? 'badge-success' : '');
                    modalStatusBadge.style.color = (data.statusId == 2) ? 'black' : 'white';
                });
                $('#PalletDialog').modal('toggle');
            });
        }

        ///search pallet
        selectedPalletIds = [];
        hasHidepalletFilter = true;
        function searchFilterPallets() {
            var formData = new FormData();
            formData.append('search-text1', document.getElementById('search-pallet-filter-text1').value);
            formData.append('search-text2', document.getElementById('search-pallet-filter-text2').value);
            formData.append('search-text3', document.getElementById('search-pallet-filter-text3').value);
            formData.append('pac-from-date', document.getElementById('pac-from-date').value);
            formData.append('pac-until-date', document.getElementById('pac-until-date').value);
            formData.append('lag-from-date', document.getElementById('lag-from-date').value);
            formData.append('lag-until-date', document.getElementById('lag-until-date').value);
            formData.append('exp-from-date', document.getElementById('exp-from-date').value);
            formData.append('exp-until-date', document.getElementById('exp-until-date').value);

            $.ajax({
                type: "post",
                url: "/Warehouse/GetFilterPallets",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    //revert pallet icon
                    for (const pallet_icon of document.getElementsByClassName("pallet-icon")) {
                        if (pallet_icon.src.includes("pallet_filter_small_icon")) {
                            pallet_icon.src = "/images/pallet__small_icon.png";
                        }
                    }

                    for (const element of message) {
                        for (const pallet_identifier of document.getElementsByClassName("pallet-identifier")) {
                            if (pallet_identifier.innerHTML == element) {
                                pallet_identifier.parentElement.firstElementChild.src = "/images/pallet_filter_small_icon.png";
                                break;
                            }
                        }
                    }
                    document.getElementById('no-pallets-filter').innerHTML = "(" + message.length + " παλέτες βρέθηκαν στην αποθήκη)";
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }
        function savePallets() {
            var formData = new FormData();
            formData.append('load-pass-token', @Html.Raw(Json.Serialize(Model.PassToken)));
            formData.append('selected-ids', selectedIds);

            $.ajax({
                type: "post",
                url: "/Warehouse/SavePallets",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    window.location = '/Warehouse/EditLoadPallets?passToken=' + @Html.Raw(Json.Serialize(Model.PassToken));
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }
        function clearPallets() {
            var formData = new FormData();
            formData.append('load-pass-token', @Html.Raw(Json.Serialize(Model.PassToken)));

            $.ajax({
                type: "post",
                url: "/Warehouse/ClearPallets",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    window.location = '/Warehouse/EditLoadPallets?passToken=' + @Html.Raw(Json.Serialize(Model.PassToken));
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }

        //Helpers
        function init() {
            pallet_warehouse_btns = document.getElementsByClassName('pallet-warehouse-btn');

            modalVirtual = document.getElementById("modal-pallet-material-virtual")
            modalLabel = document.getElementById("modal-pallet-label");
            modalDescription = document.getElementById("modal-pallet-material-description");
            modalSAPId = document.getElementById("modal-pallet-sapid");
            modalLOT = document.getElementById("modal-pallet-lot");
            modalCountry = document.getElementById("modal-pallet-country");
            modalBoxes = document.getElementById("modal-pallet-pallet-boxes");
            modalCreation = document.getElementById("modal-pallet-creation-time");
            modalDeliveryDate = document.getElementById("modal-pallet-max-delivery-date");
            modalExpirationDate = document.getElementById("modal-pallet-expiration-date");
            modalQR = document.getElementById("modal-qr-image");
            modalBarcode = document.getElementById("modal-barcode-image");
            modalCardARI = document.getElementById("modal-pallet-palletcard");
            modalCardLidl = document.getElementById("modal-pallet-palletcard-lidl");
            modalStatusBadge = document.getElementById("modal-pallet-status-badge");

            searchPallets = document.getElementById('search-pallets');
            filterIboxButton = document.getElementById('filter-ibox-button');
            noSelectedPallets = document.getElementById('pallet-count');
            savePalletsBtn = document.getElementById('save-pallets');
        }
        function formatDate(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            return [day, month, year].join('-');
        }

        function displayFilters() {
            searchPallets.style.display = searchPallets.style.display == "none" ? "block" : "none";
            filterIboxButton.innerHTML = searchPallets.style.display == "none" ? "Εμφάνιση φίλτρων" : "Απόκρυψη φίλτρων";
        }
    </script>

    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>
}


