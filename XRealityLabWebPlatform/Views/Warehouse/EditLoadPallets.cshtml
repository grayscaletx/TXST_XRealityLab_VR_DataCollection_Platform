@model ARI.Models.LoadDTO
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Επεξεργασία παλετών ARI";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int sala1_available = 264 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 1).Count();
    int sala1_psigeio_available = 16 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 2).Count();
    int proektasi_available = 216 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 3).Count();
    int sala_2_deksia_pteriga_available = 168 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 4).Count();
    int sala_2_aristeri_pteriga_available = 28 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 5).Count();
    int sala_2_domatio_available = 64 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 6).Count();
    int makio_available = 100 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 7).Count();
    int eikoniki_available = 200 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 8).Count();

    string paragraph_color, div_background_color, palletIcon;
    paragraph_color = div_background_color = palletIcon = string.Empty;
}

<!--Header-->
<div class="content-heading">
    <div>
        Φόρτωση \ Έντυπο @Model.LoadId  \ <strong>Επεξεργασία εντύπων</strong>
    </div>
</div>

<!--Selected pallets-->
<div class="card" style="max-width:1600px">
    <div class="card-header">
        <div class="text-sm" style="max-width:900px">
            Επιλέξτε τις παλέτες που θέλετε να προστεθούν για φόρτωση - έντυπο @Model.LoadId.
        </div>
    </div>
    <div class="card-body">
        <div>
            <h3><strong>Έντυπο @Model.LoadId</strong></h3>
            <div class="ibox">
                <div class="row">
                    <div class="ibox-tools" style="margin:0 10px 0 20px">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-filter"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li style="margin:2px 0" id="modal-pallet-action-rollback">
                                <a id="filter-ibox-button" onclick="displayFilters()" class="btn btn-primary">Απόκρυψη φίλτρων</a>
                            </li>
                        </ul>
                    </div>
                    <div class="ibox-tools" style="margin:0 10px">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-cog"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li style="margin:2px 0" id="modal-pallet-action-rollback">
                                <a onclick="clearPallets()" class="btn btn-primary">Εκκαθάριση παλετών</a>
                            </li>
                        </ul>
                    </div>
                </div>
                
            </div>
            <p class="lead bb">Επιλεγμένες παλέτες <strong>(@Model.WarehouseDTO.PalletDTOs.Where(k => k.IsSelectedForLoad).Count())</strong></p>
            <table class="table table-bordered table-hover" id="table-ext-1">
                <thead>
                    <tr>
                        <th></th>
                        <th data-priority="1">Α/Α</th>
                        <th style="text-align: center" class="sort-numeric">Θέση</th>
                        <th style="text-align: center" class="sort-numeric">Κωδικοποίηση παλέτας</th>
                        <th style="text-align: center" class="sort-numeric">Κωδικός SAP</th>
                        <th style="text-align: center" class="sort-numeric">LOT παλέτας</th>
                        <th style="text-align: center" class="sort-numeric">Χώρα</th>
                        <th style="text-align: center" class="sort-numeric">Μέγιστη ημερομηνία παράδοσης</th>
                        <th style="text-align: center" class="sort-numeric">Ημερομηνία λήξης της παλέτας</th>
                        <th style="text-align: center" class="sort-numeric">Εκτύπωση παλετοκάρτας</th>
                        <th style="text-align: center" class="sort-numeric">Εικονική</th>
                    </tr>
                </thead>
                <tbody id="selected-order-table">
                    @foreach (var item in Model.WarehouseDTO.PalletDTOs.Where(k => k.IsSelectedForLoad))
                    {
                        <tr class="gradeX">
                            @{ string _href = "/Warehouse/RemovePalletFromLoad?passToken=" + @Model.PassToken + "&palletId=" + @item.PalletId;
                                string positionDescription = string.Format("{0}{1}ΘΕΣΗ {2}", Common.Converters.GetEnumDescription((WarehouseArea)item.LoadingAreaID), Environment.NewLine, item.LoadingLine);
                                string isVirtual = item.IsVirtual ? "Ναι" : "Όχι";
                            }
                            <td>
                                <a href="@_href" style="margin: 0 10px 0 0"><em class="mr-2 fas fa-trash-alt"></em></a>
                            </td>
                            <td>ΠΑ @item.PalletId</td>
                            <td>@positionDescription</td>
                            <td style="text-align: center">@item.Material.MaterialDescription</td>
                            <td style="text-align: center">@item.Material.MaterialSAPID</td>
                            <td style="text-align: center">@item.PalletLOT</td>
                            <td style="text-align: center">@item.CountryCode</td>
                            <td style="text-align: center">@item.Material.MaxDeliveryDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align: center">@item.Material.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align: center">
                                <a href="@item.PalletCardLink" target="_blank" class="btn btn-primary" style="display:block;max-width:200px">παλετοκάρτα ARI</a>
                            </td>
                            <td style="text-align: center">@isVirtual</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <!--Filters-->
    <div id="search-pallets" class="card" style="width:800px;margin:10px 10px">
        <div class="card-body">
            <!--Filters-->
            <div class="col-lg-10">
                <h4>
                    <img src="~/images/pallet_filter_small_icon.png" style="margin: 0px 0px 0px 0px;width:20px;height:20px" />
                    Φίλτρα
                </h4>
                <input id="search-pallet-filter-text1" class="form-control mb-2" type="text" placeholder="Αναζήτηση material, LOT, GTIN, SAPCode etc." />
                <input id="search-pallet-filter-text2" class="form-control mb-2" type="text" placeholder="Αναζήτηση material, LOT, GTIN, SAPCode etc." />
                <input id="search-pallet-filter-text3" class="form-control mb-2" type="text" placeholder="Αναζήτηση material, LOT, GTIN, SAPCode etc." />
                <table style="margin: 0px 0px 0px 0px; display: inline;">
                    <tbody>
                        <tr class="gradeX" style="vertical-align: top">
                            <td>
                                <div>
                                    <label class="col-form-label mb-2">Packaging line date (Από)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" name="documentDate" id="pac-from-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                    <label class="col-form-label mb-2">Packaging line date (Εώς)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" name="documentDate" id="pac-until-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <label class="col-form-label mb-2">Max lager date  (Από)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" name="documentDate" id="lag-from-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                    <label class="col-form-label mb-2">Max lager date  (Eώς)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" name="documentDate" id="lag-until-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                </div>

                            </td>
                            <td>
                                <div>
                                    <label class="col-form-label mb-2">Expiration date  (Από)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" id="exp-from-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                    <label class="col-form-label mb-2">Expiration date  (Εώς)</label>
                                    <div class="input-group date" id="datetimepicker">
                                        <input class="form-control" type="date" id="exp-until-date" />
                                        <span class="input-group-append input-group-addon">
                                            <span class="input-group-text fas fa-calendar-alt"></span>
                                        </span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <button onclick="searchFilterPallets()" class="btn btn-secondary btn-lg">Εφαρμογή</button>
                <label><strong><i id="no-pallets-filter"></i></strong></label>
            </div>
        </div>
    </div>
    <!--Sum-->
    <div class="card" style="width:400px;margin:10px 10px">
        <div class="card-body">
            <h4>
                Σύνολο (@Model.WarehouseDTO.PalletDTOs.Where(k=> k.IsSelectedForLoad).Count() παλέτες)
            </h4>
            <br />
            <br />
            <br />
            <br />
            <h4>
                Προσωρινά επιλεγμένες <strong id="pallet-count">-</strong> παλέτες
            </h4>
            <p>
                Για να αποθηκευτούν στο έντυπο οι επιλεγμένες παλέτες πατήστε το πλήκτρο <a id="save-pallets" class="btn btn-primary disabled" onclick="savePallets()">Αποθήκευση</a>
            </p>
        </div>
    </div>
</div>
<br/>

<!--Hidden selection-->
<div class="card" style="width: 1400px; margin: 50px 0px 0px 0px; display: none">
    <div class="card-body">
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label"><strong>Στην αποθήκη:</strong></label>
                <div>
                    @Html.DropDownListFor(x => Model.WarehouseDTO.SelectedWarehouseArea, new SelectList(Model.WarehouseDTO.WarehouseAreaListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "from-warehouse" })
                    @Html.ValidationMessageFor(x => x.WarehouseDTO.SelectedWarehouseArea, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <label class="control-label"><strong>Στη σειρά:</strong></label>
                <div>
                    @Html.DropDownListFor(x => Model.WarehouseDTO.SelectedPosition, new SelectList(Model.WarehouseDTO.PositionListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "position" })
                    @Html.ValidationMessageFor(x => x.WarehouseDTO.SelectedPosition, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>
<div style="overflow-y: scroll">
    <!--Sala-1-->
    <div id="sala-1-title" class="card card-default" style="width: 1400px; margin: 0px 0px 0px 0px">
        <div class="card-body">
            <div>
                <p class="lead"><strong>ΣΑΛΑ 1</strong> (Διαθεσιμότητα @sala1_available/264 παλέτες)</p>
                <div style="float: right;margin:-30px 0px 0px 0px">
                    <p>
                        <canvas style="width: 10px; height: 10px; background: green; margin: 0px 0px 0px 0px"></canvas>
                        <i>Διαθέσιμες</i>
                        <canvas style="width: 10px; height: 10px; background: yellow; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες</i>
                        <canvas style="width: 10px; height: 10px; background: blue; margin: 0px 0px 0px 10px "></canvas>
                        <i>Προσωρινά επιλεγμένες για φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: purple; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες για αυτή τη φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: black; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες από άλλες φορτώσεις</i>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div id="sala-1-warehouse" style="width: 1400px">
        @for (int i = 1; i < 23; i++)//Lines
        {
            <table style="margin: 0px 0px 0px 0px; display: inline">
                <tbody class="line-pallet-btn">
                    <tr class="gradeX">
                        <td colspan="2">
                            <div>
                                <p class="line-description" style="font-size: 25px; text-align: center;margin:0px 0px 0px -30px">L@(i)</p>
                            </div>
                        </td>
                    </tr>
                    @for (int j = 1; j < 7; j++)//Line
                    {
                        <tr class="gradeX">
                            @for (int l = 1; l < 3; l++)//Position
                            {
                                @if (Model.WarehouseDTO.PalletDTOs.Any(k => k.LoadingAreaID == 1 && k.LoadingLine == i && k.LoadingPosition == ((j >= 2) ? (j * 2) + l - 2 : l)))
                                {
                                    <td>
                                        @{
                                            var palletInfo = Model.WarehouseDTO.PalletDTOs.FirstOrDefault(k => k.LoadingAreaID == 1 && k.LoadingLine == i && k.LoadingPosition == ((j >= 2) ? (j * 2) + l - 2 : l));
                                            paragraph_color = div_background_color = string.Empty;
                                            if (palletInfo.StatusId == (int)PalletStatus.AddedToWarehouse)
                                            { paragraph_color = "black"; div_background_color = "yellow"; }
                                            if (palletInfo.StatusId == (int)PalletStatus.SelectedForLoad)
                                            { paragraph_color = "white"; div_background_color = "black"; }
                                            else if (palletInfo.StatusId == (int)PalletStatus.ConfirmedForLoad)
                                            { paragraph_color = "white"; div_background_color = "purple"; }
                                            palletIcon = palletInfo.IsVirtual ? "/images/virtual_pallet__small_icon.png" : "/images/pallet__small_icon.png";
                                        }
                                        <!--Line-->
                                        <div id="@i" hidden></div>
                                        <div id="sala-1-warehouse" class="card" style="margin: 0px 5px 0px -5px; width: 75px">
                                            <div id="warehouse-pallet-1-@palletInfo.LoadingLine-@palletInfo.LoadingPosition" class="card-body text-center pallet-line-item pallet-warehouse-btn" style="background: @div_background_color">
                                                <img class="pallet-icon" src="@palletIcon" style="margin: -25px 0px 0px 0px;width:20px;height:20px" />
                                                <p style="color: @paragraph_color; margin: -10px 0px 0px 0px;"><strong>@palletInfo.CountryCode</strong></p>
                                                <p style="color: @paragraph_color;margin: -5px 0px 0px 0px;font-size:12px">@palletInfo.PalletLOT</p>
                                                <p style="color: @paragraph_color; margin: -5px 0px 0px 0px; font-size: 11px"><strong>*@palletInfo.Material.MaterialSAPID.Substring(palletInfo.Material.MaterialSAPID.Length - 3)</strong></p>
                                                <p style="color: @paragraph_color;margin: -5px 0px -10px 0px;font-size:11px"><strong>@palletInfo.Material.ExpirationDate.ToString("dd/MM/yy")</strong></p>
                                                <div class="pallet-identifier" hidden> @palletInfo.PalletId</div>
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        @{var tempposId = (j >= 2) ? (j * 2) + l - 2 : l;}
                                        <div class="card" style="@(l == 1 ? " margin: 0px 5px 0px -5px;" : "margin: 0px 18px 0px -5px;" )width: 75px">
                                            <div id="warehouse-pallet-1-@i-@tempposId" class="card-body text-center pallet-line-item" style="background:Green;">
                                                <img src="~/images/pallet__small_icon.png" style="margin: -25px 0px 0px 0px;width:20px;height:20px" />
                                                <p style="color: white; margin: -10px 0px 0px 0px;"><strong>-</strong></p>
                                                <p style="color:white;margin: -5px 0px 0px 0px;font-size:12px">-</p>
                                                <p style="color: white; margin: -5px 0px 0px 0px; font-size: 11px"><strong>-</strong></p>
                                                <p style="color:white;margin: -5px 0px -10px 0px;font-size:11px"><strong>-</strong></p>
                                            </div>
                                        </div>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <!--Sala-1 fridge-->
    <div id="sala-1-psigeio-title" class="card card-default" style="width: 1400px; margin: 0px 0px 30px 0px">
        <div class="card-body">
            <div>
                <p class="lead"><strong>ΣΑΛΑ 1 ΨΗΓΕΙΟ</strong>  (Διαθεσιμότητα @sala1_psigeio_available/16 παλέτες)</p>
                <div style="float: right;margin:-30px 0px 0px 0px">
                    <p>
                        <canvas style="width: 10px; height: 10px; background: green; margin: 0px 0px 0px 0px"></canvas>
                        <i>Διαθέσιμες</i>
                        <canvas style="width: 10px; height: 10px; background: yellow; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες</i>
                        <canvas style="width: 10px; height: 10px; background: black; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες για φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: purple; margin: 0px 0px 0px 10px "></canvas>
                        <i>Επικαιροποιημένες για φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: blue; margin: 0px 0px 0px 10px "></canvas>
                        <i>Προσωρινά επιλεγμένες για φόρτωση</i>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div id="sala-1-psigeio-warehouse" style="width:1400px">
        @for (int i = 1; i < 17; i++)
        {
            <table style="margin: 0px 0px 0px 0px; display: inline">
                <tbody>
                    <tr class="gradeX">
                        <td>
                            @if (Model.WarehouseDTO.PalletDTOs.Any(k => k.LoadingAreaID == 2 && k.LoadingLine == 0 && k.LoadingPosition == i))
                            {
                                <div id="-" hidden></div>
                                <div id="sala-1-psigeio-warehouse" class="card" style="margin: 0px -5px 0px 0px; max-width: 75px">
                                    @{
                                        var palletInfo = Model.WarehouseDTO.PalletDTOs.FirstOrDefault(k => k.LoadingAreaID == 2 && k.LoadingLine == 0 && k.LoadingPosition == i);
                                        paragraph_color = div_background_color = string.Empty;
                                        if (palletInfo.StatusId == (int)PalletStatus.AddedToWarehouse)
                                        { paragraph_color = "black"; div_background_color = "yellow"; }
                                        if (palletInfo.StatusId == (int)PalletStatus.SelectedForLoad)
                                        { paragraph_color = "white"; div_background_color = "black"; }
                                        else if (palletInfo.StatusId == (int)PalletStatus.ConfirmedForLoad)
                                        { paragraph_color = "white"; div_background_color = "purple"; }
                                        palletIcon = palletInfo.IsVirtual ? "/images/virtual_pallet__small_icon.png" : "/images/pallet__small_icon.png";
                                    }
                                    <div id="warehouse-pallet-2-0-@i" class="card-body text-center pallet-line-item pallet-warehouse-btn" style="background:@div_background_color">
                                        <img class="pallet-icon" src="@palletIcon" style="margin: -25px 0px 0px 0px;width:20px;height:20px" />
                                        <p style="color: @paragraph_color; margin: -10px 0px 0px 0px"><strong>@palletInfo.CountryCode</strong></p>
                                        <p style="color: @paragraph_color;margin: -5px 0px 0px 0px;font-size:12px">@palletInfo.PalletLOT</p>
                                        <p style="color: @paragraph_color;margin: -5px 0px 0px 0px;font-size:11px"><strong>*@palletInfo.Material.MaterialSAPID.Substring(palletInfo.Material.MaterialSAPID.Length - 3)</strong></p>
                                        <p style="color: @paragraph_color;margin: -5px 0px -10px 0px;font-size:11px"><strong>@palletInfo.Material.ExpirationDate.ToString("dd/MM/yy")</strong></p>
                                        <div class="pallet-identifier" hidden> @palletInfo.PalletId</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card" style="margin:0px -5px 0px 0px; width: 75px">
                                    <div id="warehouse-pallet-2-0-@i" class="card-body pallet-line-item text-center" style="background:Green">
                                        <img src="~/images/pallet__small_icon.png" style="margin: -25px 0px 0px 0px;width:20px;height:20px" />
                                        <p style="color: white;margin: -10px 0px 0px 0px;"><strong>-</strong></p>
                                        <p style="color:white;margin: -5px 0px 0px 0px;font-size:12px">-</p>
                                        <p style="color:white;margin: -5px 0px 0px 0px;font-size:11px"><strong>-</strong></p>
                                        <p style="color:white;margin: -5px 0px -10px 0px;font-size:11px"><strong>-</strong></p>
                                    </div>
                                </div>
                            }

                        </td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
    <!--Proektasi-->
    <div id="proektasi-title" class="card card-default" style="width: 1400px; margin: 0px 0px 0px 0px">
        <div class="card-body">
            <div>
                <p class="lead"><strong>ΠΡΟΕΚΤΑΣΗ</strong>  (Διαθεσιμότητα @proektasi_available/216 παλέτες)</p>
                <div style="float: right;margin:-30px 0px 0px 0px">
                    <p>
                        <canvas style="width: 10px; height: 10px; background: green; margin: 0px 0px 0px 0px"></canvas>
                        <i>Διαθέσιμες</i>
                        <canvas style="width: 10px; height: 10px; background: yellow; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες</i>
                        <canvas style="width: 10px; height: 10px; background: black; margin: 0px 0px 0px 10px "></canvas>
                        <i>Δεσμευμένες για φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: purple; margin: 0px 0px 0px 10px "></canvas>
                        <i>Επικαιροποιημένες για φόρτωση</i>
                        <canvas style="width: 10px; height: 10px; background: blue; margin: 0px 0px 0px 10px "></canvas>
                        <i>Προσωρινά επιλεγμένες για φόρτωση</i>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div id="proektasi-warehouse" style="width: 1400px">
        @for (int i = 1; i < 19; i++)
        {
            <table style="margin: 0px 0px 0px 0px; display: inline">
                <tbody class="line-pallet-btn">
                    <tr class="gradeX">
