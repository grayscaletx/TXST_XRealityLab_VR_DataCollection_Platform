        //compare orders-pallets
        function compareOrdersPallets() {

            var formData = new FormData();
            formData.append('selected-order-ids', selectedOrderIds);
            formData.append('selected-pallet-ids', selectedPalletIds);

            $.ajax({
                type: "post",
                url: "/Warehouse/CompareOrdersPallets",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    var compare_order_pallet_table = document.getElementById("compare-order-pallet-table");
                    removeAllChildNodes(compare_order_pallet_table);
                    var counter = 0;
                    var noOrderSum = 0;
                    var orderQuantitySum = 0;
                    var palletQuantitySum = 0;
                    var isTruckReady = true;
                    for (const element of message) {
                        var row = compare_order_pallet_table.insertRow(-1);
                        counter = counter + 1;
                        noOrderSum = noOrderSum + element.noOrders;
                        orderQuantitySum = orderQuantitySum + element.orderQuantity;
                        palletQuantitySum = palletQuantitySum + element.palletQuantity;
                        row.insertCell(0).outerHTML = "<td>" + counter + "</td>";
                        row.insertCell(1).outerHTML = "<td>" + element.material.materialDescription + "</td>";
                        row.insertCell(2).outerHTML = "<td>" + element.material.materialSAPID + "</td>";
                        row.insertCell(3).outerHTML = "<td>" + element.noOrders + "</td>";
                        row.insertCell(4).outerHTML = "<td>" + element.orderQuantity + "</td>";
                        row.insertCell(5).outerHTML = "<td>" + element.palletQuantity + "</td>";
                        row.insertCell(6).outerHTML = "<td>" + ((element.palletQuantity == element.orderQuantity) ? '<img src=\'/images/ok.jpg\' width=\'30px\' height=\'30px\' />' : '') + "</td>";
                        isTruckReady = ((element.palletQuantity == element.orderQuantity) ? true : false);
                    }
                    if (message.length == 0) {
                        isTruckReady = false;
                    }
                    //Sum
                    var row = compare_order_pallet_table.insertRow(-1);
                    row.insertCell(0).outerHTML = "<td>Sum</td>";
                    row.insertCell(1).outerHTML = "<td>-</td>";
                    row.insertCell(2).outerHTML = "<td>-</td>";
                    row.insertCell(3).outerHTML = "<td>" + noOrderSum + "</td>";
                    row.insertCell(4).outerHTML = "<td>" + orderQuantitySum + "</td>";
                    row.insertCell(5).outerHTML = "<td>" + palletQuantitySum + "</td>";
                    row.insertCell(6).outerHTML = "<td>" + ((orderQuantitySum == palletQuantitySum) ? '<img src=\'/images/ok.jpg\' width=\'30px\' height=\'30px\' />' : '') + "</td>";

                    document.getElementById('no-orders-filter').innerHTML = "(" + counter + " παραγγελίες)";
                    document.getElementById('no-orders-selected').innerHTML = "(" + selectedOrderIds.length + ")";

                    if (isTruckReady)
                        document.getElementById("create-truck-btn").disabled = false;
                    else
                        document.getElementById("create-truck-btn").disabled = true;
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }

        function truckValidation() {
            document.getElementById("create-truck-btn").disabled = true;

            var formData = new FormData();
            formData.append('selected-order-ids', selectedOrderIds);
            formData.append('selected-pallet-ids', selectedPalletIds);

            $.ajax({
                type: "post",
                url: "/Warehouse/CompareOrdersPallets",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    var isTruckReady = true;
                    for (const element of message) {
                        isTruckReady = ((element.palletQuantity == element.orderQuantity) ? true : false);
                    }
                    if (message.length == 0) {
                        isTruckReady = false;
                    }

                    if (isTruckReady) {
                        createTruck();
                    }
                    else {
                        alert("Σφάλμα, δοκιμάστε ξανά.")
                    }
                },
                error: function (message) {
                    alert(message);
                }
            });
        }

