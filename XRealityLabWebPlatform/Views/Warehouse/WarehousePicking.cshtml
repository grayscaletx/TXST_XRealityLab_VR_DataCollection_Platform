@model ARI.Models.OrderARIDTO
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Παλέτες για μεταφορά";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{int sala1_available = 264 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 1).Count();}
@{int sala1_psigeio_available = 16 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 2).Count();}
@{int proektasi_available = 216 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 3).Count();}
@{int sala_2_deksia_pteriga_available = 168 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 4).Count();}
@{int sala_2_aristeri_pteriga_available = 28 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 5).Count();}
@{int sala_2_domatio_available = 64 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 6).Count();}
@{int makio_available = 100 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 7).Count();}
@{int eikoniki_available = 200 - Model.WarehouseDTO.PalletDTOs.Where(k => k.LoadingAreaID == 8).Count();}

<div class="content-heading">
    <div>
        Δημιουργία φορτηγού (Picking)
    </div>
</div>

@if (Model.SucceededPastAction)
{
    <div id="success-dialog" class="alert alert-success alert-dismissible fade show" role="alert">
        <button class="close" type="button" onclick="CloseSuccessDialog()" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        <strong>Φόρτωση</strong> Δημιουργήθηκε η παραγγελία του φορτηγού με επιτυχία
    </div>
}

<!--Orders-->
<div class="card" style="max-width:1600px">
    <div class="card-header">
        <div class="card-title">Φόρτωση \ Δημιουργία φορτηγού (Picking)</div>
        <div class="text-sm" style="max-width:900px">
            Για τη δημιουργία νέου φορτηγού χρειάζεται να επιλέξετε τις παραγγελίες και τις παλέτες για φόρτωση. Μπορούν να επιλεχθούν από 20 εώς 100 παλέτες για το κάθε φορτηγό. <i>(Εάν οι παραγγελίες δεν έχουν ship-to-party ή sold-to-party δεν θα εμφανιστούν στην παρακάτω λίστα)</i>
        </div>
    </div>
    <div class="card-body">

        <!--Selected orders-->
        <div>
            <p class="lead bb">Επιλεγμένες παραγγελίες <strong id="no-orders-selected"></strong></p>
            <table class="table table-bordered table-hover" id="table-ext-1">
                <thead>
                    <tr>
                        <th></th>
                        <th data-priority="1">Α/Α</th>
                        <th style="text-align: center" class="sort-numeric">Reference number</th>
                        <th style="text-align: center" class="sort-numeric">Material</th>
                        <th style="text-align: center" class="sort-numeric">Quantity</th>
                        <th style="text-align: center" class="sort-numeric">No pallet..</th>
                        <th style="text-align: center" class="sort-numeric">GTIN</th>
                        <th style="text-align: center" class="sort-numeric">Ship-To-Party</th>
                        <th style="text-align: center" class="sort-numeric">Sold-To-Party</th>
                        <th style="text-align: center" class="sort-numeric">Document date</th>
                        <th style="text-align: center" class="sort-numeric">Purchase order date</th>
                        <th style="text-align: center" class="sort-numeric">Requested delivery date</th>
                    </tr>
                </thead>
                <tbody id="selected-order-table">
                    @*@foreach (var item in Model.EDIOrderDTOs.Take(2))
                        {
                            <tr class="gradeX">
                                <td>
                                    <a class="open-AddDeleteDialog" data-id="@item.PassToken" data-placement="top" style="margin: 0 10px 0 0" data-toggle="modal" data-target="#DeleteDialog"><em class="mr-2 fas fa-trash-alt"></em></a>
                                </td>
                                <td>ΠΑ @item.OrderId</td>
                                <td style="text-align: center">@item.ReferenceNumber</td>
                                <td style="text-align: center">@item.Material.MaterialDescription</td>
                                <td style="text-align: center">@item.Quantity</td>
                                <td style="text-align: center">@item.NoPalletBox</td>
                                <td style="text-align: center">@item.Material.GTIN</td>
                                <td style="text-align: center">@item.ShipToParty.Name1</td>
                                <td style="text-align: center">@item.SoldToParty.Name1</td>
                                <td style="text-align: center">@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                                <td style="text-align: center">@item.PurchaseOrderDate.ToString("dd/MM/yyyy")</td>
                                <td style="text-align: center">@item.RequestedDeliveryDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }*@
                </tbody>
            </table>
        </div>
        <br />
        <!--Search orders-->
        <div class="card card-default" id="cardDemo1">
            <div class="card-header">
                <div>
                    <p class="lead bb">Προσθήκη παραγγελιών</p>
                    <a class="float-left" data-tool="card-collapse" data-start-collapsed="" data-toggle="tooltip" title="Επιλέξτε για προσθήκη παραγγελιών">
                        <em class="fa fa-minus"></em>
                    </a>
                </div>
            </div>

            <div class="card-wrapper">
                <div class="card-body">
                    <div class="row">
                        <!--Search input-->
                        <div class="col-lg-9">
                            <input id="search-orders-filter-text" class="form-control mb-2" type="text" placeholder="Αναζήτηση reference number, material, GTIN, etc." />
                            <div class="d-flex">
                                <button onclick="searchFilterOrders()" class="btn btn-secondary" type="button">Αναζήτηση</button>
                                <label><i id="no-orders-filter"></i></label>
                            </div>
                        </div>
                        <!--Search table-->
                        <div class="col-lg-9">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th data-priority="1">Α/Α</th>
                                        <th style="text-align: center" class="sort-numeric">Reference number</th>
                                        <th style="text-align: center" class="sort-numeric">Material</th>
                                        <th style="text-align: center" class="sort-numeric">Quantity</th>
                                        <th style="text-align: center" class="sort-numeric">No pallet..</th>
                                        <th style="text-align: center" class="sort-numeric">GTIN</th>
                                        <th style="text-align: center" class="sort-numeric">Ship-To-Party</th>
                                        <th style="text-align: center" class="sort-numeric">Sold-To-Party</th>
                                        <th style="text-align: center" class="sort-numeric">Document date</th>
                                        <th style="text-align: center" class="sort-numeric">Purchase order date</th>
                                        <th style="text-align: center" class="sort-numeric">Requested delivery date</th>
                                    </tr>
                                </thead>
                                <tbody id="filter-order-table">
                                    @foreach (var item in Model.EDIOrderDTOs)
                                    {
                                        <tr class="gradeX">
                                            <td>
                                                <div class="checkbox c-checkbox">
                                                    <label>
                                                        <input onchange="handlePalletCheckbox(this, @item.OrderId.ToString())" type="checkbox" />
                                                        <span class="fa fa-check"></span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td>ΠΑ @item.OrderId</td>
                                            <td style="text-align: center">@item.ReferenceNumber</td>
                                            <td style="text-align: center">@item.Material.MaterialDescription</td>
                                            <td style="text-align: center">@item.Quantity</td>
                                            <td style="text-align: center">@item.NoPalletBox</td>
                                            <td style="text-align: center">@item.Material.GTIN</td>
                                            <td style="text-align: center">@item.ShipToParty.Name1</td>
                                            <td style="text-align: center">@item.SoldToParty.Name1</td>
                                            <td style="text-align: center">@item.DocumentDate.ToString("dd/MM/yyyy")</td>
                                            <td style="text-align: center">@item.PurchaseOrderDate.ToString("dd/MM/yyyy")</td>
                                            <td style="text-align: center">@item.RequestedDeliveryDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!--Filters-->
                        <div class="col-lg-3">
                            <h4>Φίλτρα</h4>
                            <div class="form-group">
                                <label class="col-form-label mb-2">Document date (From)</label>
                                <div class="input-group date" id="datetimepicker">
                                    <input class="form-control" type="date" name="documentDate" id="order-documentdatePicker" />
                                    <span class="input-group-append input-group-addon">
                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-form-label mb-2">Purchase order date (From)</label>
                                <div class="input-group date" id="datetimepicker">
                                    <input class="form-control" type="date" name="documentDate" id="order-purdatePicker" />
                                    <span class="input-group-append input-group-addon">
                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-form-label mb-2">Requested delivery date (From)</label>
                                <div class="input-group date" id="datetimepicker">
                                    <input class="form-control" type="date" id="order-requestdatePicker" />
                                    <span class="input-group-append input-group-addon">
                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                    </span>
                                </div>
                            </div>
                            <button onclick="searchFilterOrders()" class="btn btn-secondary btn-lg">Εφαρμογή</button>
                        </div>
                    </div>
                </div>
                <div class="card-footer">Επιλέξτε <strong>-</strong> για σύμπτυξη</div>
            </div>
        </div>


    </div>
</div>

<!--Pallets-->
<div class="card" style="max-width:1600px">
    <div class="card-body">

        <!--Selected pallets-->
        <div>
            <p class="lead bb">Επιλεγμένες παλέτες <strong id="truck_pallets"></strong></p>
            <div class="col-lg-12">
                <table style="margin: 0px 0px 0px 0px; display: inline;">
                    <tbody>
                        <tr class="gradeX" style="vertical-align: top">
                            <td width="230px" style="border: 1px solid black;">
                                <div style="margin:0px 5px 0px 5px;">
                                    <p style="font-size:18px;padding:5px"><em class="mr-2 fas fa-server"></em>Επιλ. παλέτες ανά αποθήκη</p>
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΣΑΛΑ 1: <strong id="truck_pallets_sala1"> - </strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΣΑΛΑ 1 ΨΥΓΕΙΟ: <strong id="truck_pallets_sala1_psigeio"> -</strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΠΡΟΕΚΤΑΣΗ: <strong id="truck_pallets_proektasi"> -</strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΣΑΛΑ 2 ΔΕΞΙΑ ΠΤΕΡΥΓΑ: <strong id="truck_pallets_sala2_deksia"> -</strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΣΑΛΑ 2 ΑΡΙΣΤΕΡΗ ΠΤΕΡΥΓΑ: <strong id="truck_pallets_sala2_aristeri"> -</strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΣΑΛΑ 2 ΔΩΜΑΤΙΟ: <strong id="truck_pallets_sala2_domatio"> -</strong></label>
                                    <br />
                                    <em class="mr-2 fas fa-boxes"></em>
                                    <label class="control-label">ΜΑΚΙΟ: <strong id="truck_pallets_makio"> -</strong></label>
                                </div>
                            </td>
                            <td width="200px" style="border: 1px solid black;">
                                <div style="margin:0px 5px 0px 5px;">
                                    <p style="font-size:18px;padding:5px"><em class="mr-2 fas fa-server"></em>Επιλ. παλέτες ανά LOT</p>
                                    <label class="control-label"><strong id="truck_pallets_lot"> -</strong></label>
                                    <br />
                                    <p style="font-size:18px;padding:5px"><em class="mr-2 fas fa-server"></em>Επιλ. παλέτες ανά SAPCode</p>
                                    <label class="control-label"><strong id="truck_pallets_sapcode"> -</strong></label>
                                    <br />
                                </div>
                            </td>
                            <td>
                                <div id="clone-container" style="max-width: 1400px; opacity:0.5">

                                </div>
                            </td>
                    </tbody>
                </table>
            </div>
        </div>
        <br />


        <!--Add pallets-->
        <div class="card card-default" id="cardDemo1">
            <div class="card-header">
                <div>
                    <p class="lead bb">Προσθήκη παλετών</p>
                    <a class="float-left" data-tool="card-collapse" data-start-collapsed="" data-toggle="tooltip" onclick="hidePalletFilter()" title="Επιλέξτε για προσθήκη παλετών">
                        <em class="fa fa-minus"></em>
                    </a>
                </div>
            </div>

            <div class="card-wrapper">
                <div class="card-body">
                    <div>
                        <!--Filters-->
                        <div class="col-lg-5">
                            <h4>
                                <img src="~/images/pallet_filter_small_icon.png" style="margin: 0px 0px 0px 0px;width:20px;height:20px" />
                                Φίλτρα
                            </h4>
                            <div class="input-group-prepend">
                                <button id="search-dropdown-default" class="btn btn-outline-secondary" type="button">Αναζήτηση (All)</button>
                                <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="sr-only">Toggle Dropdown</span>
                                </button>
                                <div class="dropdown-menu">
                                    <a onclick="updateFilterPalletDropIndex(1,'Αναζήτηση (SAPCode)')" class="dropdown-item">Αναζήτηση (SAPCode)</a>
                                    <a onclick="updateFilterPalletDropIndex(2,'Αναζήτηση (LOT)')" class="dropdown-item">Αναζήτηση (LOT)</a>
                                    <a onclick="updateFilterPalletDropIndex(3,'Αναζήτηση (Material)')" class="dropdown-item">Αναζήτηση (Material)</a>
                                    <a onclick="updateFilterPalletDropIndex(4,'Αναζήτηση (GTIN)')" class="dropdown-item">Αναζήτηση (GTIN)</a>
                                    <a onclick="updateFilterPalletDropIndex(5,'Αναζήτηση (Country)')" class="dropdown-item">Αναζήτηση (Country)</a>
                                    <div class="dropdown-divider" role="separator"></div><a onclick="updateFilterPalletDropIndex(0,'Αναζήτηση (All)')" class="dropdown-item">Αναζήτηση (All)</a>
                                    <div id="search-dropdown-id" hidden>0</div>
                                </div>
                            </div>
                            <input id="search-pallet-filter-text1" class="form-control mb-2" type="text" placeholder="Αναζήτηση material, LOT, GTIN, SAPCode etc." />
                            <input id="search-pallet-filter-text2" class="form-control mb-2" type="text" placeholder="Αναζήτηση material, LOT, GTIN, SAPCode etc." />
                            <table style="margin: 0px 0px 0px 0px; display: inline;">
                                <tbody>
                                    <tr class="gradeX" style="vertical-align: top">
                                        <td>
                                            <div>
                                                <label class="col-form-label mb-2">Packaging line date (From)</label>
                                                <div class="input-group date" id="datetimepicker">
                                                    <input class="form-control" type="date" name="documentDate" id="pallet-packdatePicker" />
                                                    <span class="input-group-append input-group-addon">
                                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <label class="col-form-label mb-2">Max lager date  (From)</label>
                                                <div class="input-group date" id="datetimepicker">
                                                    <input class="form-control" type="date" name="documentDate" id="pallet-lagdatePicker" />
                                                    <span class="input-group-append input-group-addon">
                                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <label class="col-form-label mb-2">Expiration date  (From)</label>
                                                <div class="input-group date" id="datetimepicker">
                                                    <input class="form-control" type="date" id="pallet-expdatePicker" />
                                                    <span class="input-group-append input-group-addon">
                                                        <span class="input-group-text fas fa-calendar-alt"></span>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <button onclick="searchFilterPallets()" class="btn btn-secondary btn-lg">Εφαρμογή</button>
                            <label><i id="no-pallets-filter"></i></label>
                        </div>
                        <br />
                        <!--Dropdown warehouse and line-->
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label class="control-label"><strong>Από την αποθήκη:</strong></label>
                                <div>
                                    @Html.DropDownListFor(x => Model.WarehouseDTO.SelectedWarehouseArea, new SelectList(Model.WarehouseDTO.WarehouseAreaListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "from-warehouse" })
                                    @Html.ValidationMessageFor(x => x.WarehouseDTO.SelectedWarehouseArea, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group" hidden>
                                <label class="control-label"><strong>Στη σειρά:</strong></label>
                                <div>
                                    @Html.DropDownListFor(x => Model.WarehouseDTO.SelectedPosition, new SelectList(Model.WarehouseDTO.PositionListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "position" })
                                    @Html.ValidationMessageFor(x => x.WarehouseDTO.SelectedPosition, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12">

                        </div>
                    </div>

                    <div class="card-footer">Επιλέξτε <strong>-</strong> για σύμπτυξη</div>
                </div>
            </div>
        </div>

        <!--SALA 1-->
        <div id="sala-1-title" class="card card-default" style="width: 1400px; margin: 0px 0px 0px 0px; display: none">
            <div class="card-body">
                <div>
                    <p class="lead"><strong>ΣΑΛΑ 1</strong> (Διαθεσιμότητα @sala1_available/264 παλέτες)</p>
                    <div style="float: right;margin:-30px 0px 0px 0px">
                        <p>
                            <canvas style="width: 10px; height: 10px; background: green; margin: 0px 0px 0px 0px"></canvas>
                            <i>Διαθέσιμες</i>
                            <canvas style="width: 10px; height: 10px; background: yellow; margin: 0px 0px 0px 10px "></canvas>
                            <i>Δεσμευμένες</i>
                            <canvas style="width: 10px; height: 10px; background: black; margin: 0px 0px 0px 10px "></canvas>
                            <i>Δεσμευμένες για φόρτωση</i>
                            <canvas style="width: 10px; height: 10px; background: purple; margin: 0px 0px 0px 10px "></canvas>
                            <i>Επικαιροποιημένες για φόρτωση</i>
                            <canvas style="width: 10px; height: 10px; background: blue; margin: 0px 0px 0px 10px "></canvas>
                            <i>Προσωρινά επιλεγμένες για φόρτωση</i>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <div id="sala-1-warehouse" style="width: 1400px;display: none">
            @for (int i = 1; i < 23; i++)//Lines
            {
                <table style="margin: 0px 0px 0px 0px; display: inline">
                    <tbody class="line-pallet-btn">
                        <tr class="gradeX">
                            <td colspan="2">
                                <div>
                                    <p class="line-description" style="font-size: 25px; text-align: center;margin:0px 0px 0px -30px">L@(i)</p>
                                </div>
                            </td>
                        </tr>
                        @for (int j = 1; j < 7; j++)//Line
                        {
                            <tr class="gradeX">
                                @for (int l = 1; l < 3; l++)//Position
                                {
                                    @if (Model.WarehouseDTO.PalletDTOs.Any(k => k.LoadingAreaID == 1 && k.LoadingLine == i && k.LoadingPosition == ((j >= 2) ? (j * 2) + l - 2 : l)))
                                    {
                                        <td>
                                            @{
                                                var palletInfo = Model.WarehouseDTO.PalletDTOs.FirstOrDefault(k => k.LoadingAreaID == 1 && k.LoadingLine == i && k.LoadingPosition == ((j >= 2) ? (j * 2) + l - 2 : l));
                                                string paragraph_color = string.Empty;
                                                string div_background_color = string.Empty;
                                                if (palletInfo.StatusId == (int)PalletStatus.AddedToWarehouse)
                                                { paragraph_color = "black"; div_background_color = "yellow"; }
                                                if (palletInfo.StatusId == (int)PalletStatus.SelectedForLoad)
                                                { paragraph_color = "white"; div_background_color = "black"; }
                                                else if (palletInfo.StatusId == (int)PalletStatus.ConfirmedForLoad)
                                                { paragraph_color = "white"; div_background_color = "purple"; }
                                            }
                                            <div id="@i" hidden></div>
                                            <div id="sala-1-warehouse" class="card" style="margin: 0px 5px 0px -5px; width: 75px">
                                                <div id="warehouse-pallet-1-@palletInfo.LoadingLine-@palletInfo.LoadingPosition" class="card-body text-center pallet-line-item pallet-warehouse-btn" style="background: @div_background_color">
                                                    <img class="pallet-icon" src="~/images/pallet__small_icon.png" style="margin: -25px 0px 0px 0px;width:20px;height:20px" />
                                                    <p style="color: @paragraph_color; margin: -10px 0px 0px 0px;"><strong>@palletInfo.CountryCode</strong></p>
                                                    <p style="color: @paragraph_color;margin: -5px 0px 0px 0px;font-size:12px">@palletInfo.Material.MaterialLOT</p>
                                                    <p style="color: @paragraph_color; margin: -5px 0px 0px 0px; font-size: 11px"><strong>*@palletInfo.Material.MaterialSAPID.Substring(palletInfo.Material.MaterialSAPID.Length - 3)</strong></p>
                                                    <p style="color: @paragraph_color;margin: -5px 0px -10px 0px;font-size:11px"><strong>@palletInfo.Material.ExpirationDate.ToString("dd/MM/yy")</strong></p>
                                                    <div class="pallet-identifier" hidden> @palletInfo.PalletId</div>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            @{var tempposId = (j >= 2) ? (j * 2) + l - 2 : l;}
