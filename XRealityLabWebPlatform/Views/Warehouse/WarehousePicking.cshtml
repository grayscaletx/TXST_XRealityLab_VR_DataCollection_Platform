@section Scripts {
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script>
        noTruckPalletSala1 = 0;
        noTruckPalletSala1Psigeio = 0;
        noTruckPalletProektasi = 0;
        noTruckPalletSala2Deksia = 0;
        noTruckPalletSala2Aristera = 0;
        noTruckPalletSala2Domatio = 0;
        noTruckPalletMakio = 0;
        noTruckPallet = 0;
        lotDic = "";
        sapCodeDic = "";
        document.getElementById('from-warehouse').selectedIndex = 0;
        var pallet_warehouse_btns = document.getElementsByClassName('pallet-warehouse-btn');

        ///search orders
        selectedOrderIds = [];
        function searchFilterOrders() {
            var search_text = document.getElementById('search-orders-filter-text').value;
            var doc_date = document.getElementById('order-documentdatePicker').value;
            var pur_date = document.getElementById('order-purdatePicker').value;
            var req_date = document.getElementById('order-requestdatePicker').value;

            var formData = new FormData();
            formData.append('search-text', search_text);
            formData.append('doc-date', doc_date);
            formData.append('pur-date', pur_date);
            formData.append('req-date', req_date);

            $.ajax({
                type: "post",
                url: "/Warehouse/GetFilterOrders",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    _message = message;
                    var filter_order_table = document.getElementById("filter-order-table");
                    removeAllChildNodes(filter_order_table);
                    var counter = 0;
                    for (const element of message) {
                        if (!selectedOrderIds.includes(element.orderId)) {
                            var row = filter_order_table.insertRow(-1);
