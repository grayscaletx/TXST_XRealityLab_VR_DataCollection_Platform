        function updateTruckClonePallets(palletBtn) {
            if (palletBtn.style.getPropertyValue('background-color') == "yellow") {
                if (!document.getElementById(event.currentTarget.id + "-truck-clone")) {
                    var clone_element = document.createElement("div");
                    clone_element.id = event.currentTarget.id + "-truck-clone";
                    clone_element.style.width = 160;
                    clone_element.style.paddingLeft = "5px";
                    clone_element.style.paddingRight = "5px";
                    clone_element.style.marginRight = "10px";
                    clone_element.style.marginTop = "10px";
                    clone_element.style.background = 'blue';
                    clone_element.style.display = "inline-block";
                    var par_element = document.createElement("p");
                    par_element.textContent = event.currentTarget.children[1].innerText + "|" +
                        event.currentTarget.children[2].innerText + "|" + event.currentTarget.children[3].innerText + "|"
                        + event.currentTarget.children[4].innerText;
                    par_element.style.color = "white";
                    par_element.style.textAlign = "center";
                    clone_element.appendChild(par_element);
                    document.getElementById('clone-container').appendChild(clone_element);
                }
            }
            else {
                if (document.getElementById(event.currentTarget.id + "-truck-clone"))
                    document.getElementById(event.currentTarget.id + "-truck-clone").remove();
            }
        }
        function updateWarehouseNoPallets(palletBtn) {
