@model ARI.Models.EDIOrderDTO

@{
    ViewData["Title"] = "Προσθήκη EDI εγγράφου";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-heading">
    <div>
        Προσθήκη νέας παραγγελίας
        <small>Προσθέστε χειροκίνητα τις πληφοροφορίες της παραγγελίας</small>
    </div>
</div>

@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Έλεγχος πρόσβασης \ Φορτηγά</div>
        <div class="text-sm">Πρόσθεσε τις πληροφορίες του φορτηγού.</div>
    </div>
    <div class="card-body">
        <div class="col-md-4">
            <form asp-action="AddOrderManually">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="ReferenceNumber" class="control-label"></label>
                    <input id="referenceNumberInput" asp-for="ReferenceNumber" class="form-control" />
                    <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                    <div>
                        <i>Προτεινόμενο reference number <small>(SoldToParty|PODate|ShipToParty)</small><br /> βάση κανόνα: </i>  <strong id="suggestedReferenceNumber"></strong>
                        <a onclick="updateReferenceNumberInput()" class="mb-1 btn btn-primary" style="float: right;background-color:slategray;border-color:darkgray">Επιλογή</a>
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedMaterial, htmlAttributes: new { @class = "control-label" })
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedMaterial, new SelectList(Model.MaterialListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "Material" })
                        @Html.ValidationMessageFor(x => x.SelectedMaterial, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Quantity" class="control-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedShipToParty, htmlAttributes: new { @class = "control-label" })
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedShipToParty, new SelectList(Model.ShipToPartyListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "ShipToParty" })
                        @Html.ValidationMessageFor(x => x.SelectedShipToParty, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(x => Model.SelectedSoldToParty, htmlAttributes: new { @class = "control-label" })
                    <div>
                        @Html.DropDownListFor(x => Model.SelectedSoldToParty, new SelectList(Model.SoldToPartyListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "SoldToParty" })
                        @Html.ValidationMessageFor(x => x.SelectedSoldToParty, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="DocumentDate" class="control-label"></label>
                    <input asp-for="DocumentDate" class="form-control" type="date" name="documentDate" id="documentdatePicker" value="@DateTime.Now" />
                    <span asp-validation-for="DocumentDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PurchaseOrderDate" class="control-label"></label>
                    <input asp-for="PurchaseOrderDate" class="form-control" type="date" id="purdatePicker" value="@DateTime.Now" />
                    <span asp-validation-for="PurchaseOrderDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RequestedDeliveryDate" class="control-label"></label>
                    <input asp-for="RequestedDeliveryDate" class="form-control" type="date" id="requestdatePicker" value="@DateTime.Now" />
                    <span asp-validation-for="RequestedDeliveryDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Προσθήκη" class="mb-1 btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    <script>
        shipToPartyTerm = "";
        purchaseDateTime = "";
        soldToPartyTerm = "";

        $("#ShipToParty").change(function () {
            var shipToParty = document.getElementById('ShipToParty').value;
            if (shipToParty == "-") {
                shipToPartyTerm = "";
                setReferenceNumberName();
            }
            else {
                var shipToPartyData = { customerId: shipToParty };
                $.ajax({
                    type: "post",
                    url: "/Logistics/GetCustomerTerm",
                    dataType: "json",
                    traditional: true,
                    data: shipToPartyData,
                    success: function (result) {
                        shipToPartyTerm = result;
                        setReferenceNumberName();
                    },
                    error: function () {

                    }
                });
            }
        });
        $("#SoldToParty").change(function () {
            var soldToParty = document.getElementById('SoldToParty').value;
            if (soldToParty == "-") {
                soldToPartyTerm = "";
                setReferenceNumberName();
            }
            else {
                var soldToPartyData = { customerId: soldToParty };
                $.ajax({
                    type: "post",
                    url: "/Logistics/GetCustomerTerm",
                    dataType: "json",
                    traditional: true,
                    data: soldToPartyData,
                    success: function (result) {
                        soldToPartyTerm = result;
                        setReferenceNumberName();
                    },
                    error: function () { }
                });
            }
        });
        $("#purdatePicker").change(function () {
            var pODate = new Date(document.getElementById('purdatePicker').value);

            if (isNaN(pODate)) {
                purchaseDateTime = "";
                setReferenceNumberName();
                return;
            };
            purchaseDateTime = pODate.getFullYear().toString().substring(2) + ((pODate.getMonth() > 8) ? (pODate.getMonth() + 1) : ('0' + (pODate.getMonth() + 1))) + ((pODate.getDate() > 9) ? pODate.getDate() : ('0' + pODate.getDate()))
            setReferenceNumberName();
        });

        function setReferenceNumberName() {
            document.getElementById('suggestedReferenceNumber').innerHTML = soldToPartyTerm + purchaseDateTime + shipToPartyTerm;
        }

        function updateReferenceNumberInput() {
            if (document.getElementById('suggestedReferenceNumber').innerHTML == '')
                return;

            document.getElementById('referenceNumberInput').value = document.getElementById('suggestedReferenceNumber').innerHTML;
        }
    </script>
}