@model IEnumerable<ARI.Models.EDIOrderDTO>

@{
    ViewData["Title"] = "Προσθήκη EDI εγγράφου";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-heading">
    <div>
        Προσθήκη EDI εγγράφου
        <small>Προσθέστε παραγγελίες με τύπο αρχείου .EDI για ανάγνωση και προσθήκη στο σύστημα.</small>
    </div>
</div>

@if (Model != null)
{
    @if (Model.FirstOrDefault().ActionMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button class="close" type="button" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <strong>Προσθήκη! </strong>@Model.FirstOrDefault().ActionMessage
        </div>
    }
}
<div class="card card-default">
    <div class="card-header">Φόρτωση αρχείου EDI</div>
    <div class="card-body">
        <form class="form-horizontal" method="post" enctype="multipart/form-data">
            <div class="form-group row">
                <input style="margin:0px 5px" class="btn btn-sm btn-primary" type="file" id="files" name="files" value="Φόρτωση παραγγελίας" />
            </div>
            <button id="upload" class="btn btn-primary">Προβολή</button>
            <img id="loader" class="block-center rounded" src="~/images/loading-gif.gif" style="width:30px; visibility:hidden" alt="Image" />
        </form>
        </div>
    <form method="post" enctype="multipart/form-data">


       
    </form>
</div>

<div class="card">
    <div class="card-header">
        Επίλεξε τις εγγραφές που θα ήθελες να αποθηκευτούν στη βάση δεδομένων.
        <br />
        Προβολή εγγραφών από το αρχείο:
        <strong id="edi-file-name"></strong>
        <div id="edi-failed" style="color:red"></div>
    </div>
    <div class="card-body" style="overflow-y:scroll">
        <table class="table table-striped table-bordered table-hover" id="table-ext-2">
            <thead>
                <tr>
                    <th><button id="save-all-orders" class="btn btn-primary" onclick="_saveAll()" style="display:none">Αποθήκευση όλων</button></th>
                    <th>Reference number</th>
                    <th>Material</th>
                    <th>GTIN</th>
                    <th>Quantity</th>
                    <th>No pallet boxes</th>
                    <th>Ship-to-Party</th>
                    <th>Ship-to-Party name</th>
                    <th>Sold-to-Party</th>
                    <th>Sold-to-Party name</th>
                    <th>Document date</th>
                    <th>Purchase Order date</th>
                    <th>Delivery date</th>
                </tr>
            </thead>
            <tbody id="edi-table">
            </tbody>
        </table>
    </div>
</div>

<a asp-action="Orders">Επιστροφή στα δελτία των παραγγελιών</a>
 
@section Scripts {
    <script>
        _message = '';
        var [loader, ediFileName, ediTable, ediFailed, saveAll] = [];
        init();
        $("#upload").click(function (evt) {
            evt.preventDefault();
            
            saveAll.style.display = "none";

            var fileupload = $("#files").get(0);
            var files = fileupload.files;

            if (files && files[0])
                loader.style.visibility = "visible";

            var formData = new FormData();
            formData.append('ediFile', files[0]);
            formData.append('name', name);
            ediFileName.innerHTML = files[0].name;

            $.ajax({
                type: "post",
                url: "/Logistics/UploadEDIFiles",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    _message = message;
                    removeAllChildNodes(ediTable);
                    var counter = 0;
                    for (const element of message) {
                        var row = ediTable.insertRow(-1);
                        row.insertCell(0).outerHTML = "<td><button class=\"btn btn-primary\" id=\"" + "k" + counter + "\" onClick=\"save(" + "k" + counter + ")\">Αποθήκευση</button><img src=\"/images/ok.jpg\" id=\"" + "k" + counter + "_img\" width=\"28\" height=\"28\" style=\"display: none\"/></td>";
                        row.insertCell(1).outerHTML = "<td>" + element.referenceNumber + "</td>";
                        row.insertCell(2).outerHTML = "<td>" + element.material.materialDescription + "</td>";
                        row.insertCell(3).outerHTML = "<td>" + element.material.gtin + "</td>";
                        row.insertCell(4).outerHTML = "<td>" + element.quantity + "</td>";
                        row.insertCell(5).outerHTML = "<td>" + element.noPalletBox + "</td>";
                        row.insertCell(6).outerHTML = "<td>" + element.shipToParty.customerSAPID + "</td>";
                        row.insertCell(7).outerHTML = "<td>" + element.shipToParty.name1 + "</td>";
                        row.insertCell(8).outerHTML = "<td>" + element.soldToParty.customerSAPID + "</td>";
                        row.insertCell(9).outerHTML = "<td>" + element.soldToParty.name1 + "</td>";
                        row.insertCell(10).outerHTML = "<td>" + formatDate(element.documentDate) + "</td>";
                        row.insertCell(11).outerHTML = "<td>" + formatDate(element.purchaseOrderDate) + "</td>";
                        row.insertCell(12).outerHTML = "<td>" + formatDate(element.requestedDeliveryDate) + "</td>";
                        row.insertCell(13).outerHTML = "<td hidden>" + counter + "</td/>";
                        counter = counter + 1;
                    }
                    ediFailed.innerHTML = "";
                    for (const element of message) {
                        if (element.failedEDIDTOs != null)
                        {
                            for (const failElement of element.failedEDIDTOs)
                                ediFailed.innerHTML += failElement.message + ",<br> ";
                        }
                    }

                    saveAll.style.display = "block";
                    loader.style.visibility = "hidden";
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        });

        //Actions
        function save(item) {
            document.getElementById(item.id).style.display = "none";
            document.getElementById(item.id + '_img').style.display = "block";

            var orderData = { _orders: JSON.stringify(_message), selectedItem: item.id };
            $.ajax({
                type: "post",
                url: "/Logistics/SaveOrder",
                dataType: "json",
                traditional: true,
                data: orderData,
                success: function (result) {
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }

        function _saveAll() {
            var orderData = { _orders: JSON.stringify(_message), selectedItem: 'all' };
            $.ajax({
                type: "post",
                url: "/Logistics/SaveOrder",
                dataType: "json",
                traditional: true,
                data: orderData,
                success: function (result) {
                    window.location = '/Logistics/Orders?actionMessage=Προστέθηκαν όλες οι εγγραφές';
                },
                error: function () {
                    alert("there was error uploading files!");
                }
            });
        }
        
        //Helpers
        function init() {
           loader = document.getElementById("loader");
           ediFileName = document.getElementById("edi-file-name");
           ediTable = document.getElementById('edi-table');
           ediFailed = document.getElementById('edi-failed');
           saveAll = document.getElementById('save-all-orders');
        }

        //Utils
        function removeAllChildNodes(parent) {
            while (parent.firstChild) {
                parent.removeChild(parent.firstChild);
            }
        }
        function formatDate(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;
            return [day, month, year].join('-');
        }
    </script>
}