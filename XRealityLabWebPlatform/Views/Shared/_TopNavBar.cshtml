@using System.Security.Claims;
@using XRealityLab.Common;
@using Common.Constants;

@{
    string role = string.Empty;
    if (((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").Count() != 0)
    {
        role = ((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").ToList().LastOrDefault().Value;
    }
    IEnumerable<Claim> claims = User.Claims;
}







