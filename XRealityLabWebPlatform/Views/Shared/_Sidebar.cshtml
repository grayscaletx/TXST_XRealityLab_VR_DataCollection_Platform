@using System.Security.Claims;
@using XRealityLab.Common;
@using Common.Constants;

@{
    string role = string.Empty;
    if (((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").Count() != 0)
    {
        role = ((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").ToList().LastOrDefault().Value;
    }
    IEnumerable<Claim> claims = User.Claims;
}

<!-- START Sidebar (left)-->
<div class="aside-inner">
    <nav class="sidebar" data-sidebar-anyclick-close="">
        <!-- START sidebar nav-->
        <ul class="sidebar-nav">
            <li class="has-user-block"> @await Component.InvokeAsync("Profile") </li>

            <!-- START user info-->
            <!--<li class="has-user-block">
               
            </li>-->
            <li class="nav-heading">
                <span>Main Navigation</span>
            </li>
            @if (role == RoleType.Administrator.GetEnumDescription())
            {
                <li class="@Html.isActive("Administrator", "Organizations")">
                    <a href="@Url.Action("Organizations", RoleType.Administrator.GetEnumDescription())" title="Organizations">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>Organizations</span>
                    </a>
                </li>
            }
            else if (role == RoleType.DirectorOfIT.GetEnumDescription())
            {
                <li class="@Html.isActive("DirectorOfIT", "Labs")">
                    <a href="@Url.Action("Labs", RoleType.DirectorOfIT.GetEnumDescription())" title="Organizations">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>Labs</span>
                    </a>
                </li>

            }
            else if (role == RoleType.LabDirector.GetEnumDescription())
            {
                <li class="@Html.isActive("Project", "AllProjects")">
                    <a href="@Url.Action("AllProjects", "Project")" title="Organizations">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>All Projects</span>
                    </a>
                </li>
                <li class="@Html.isActive("Project", "MyProjects")">
                    <a href="@Url.Action("MyProjects", "Project")" title="Organizations">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>My Projects</span>
                    </a>
                </li>
                <li class="@Html.isActive("User", "PrincipleInvestigators")">
                    <a href="@Url.Action("PrincipleInvestigators", "User")" title="PrincipleIvestigators">
                        <em class="fa-2x  fas fa-users"></em>
                        <span>Principle Ivestigators</span>
                    </a>
                </li>
                <li class="@Html.isActive("User", "ResearchAssistants")">
                    <a href="@Url.Action("ResearchAssistants", "User")" title="ResearchAssistants">
                        <em class="fa-2x fas fa-users"></em>
                        <span>Research Assistants</span>
                    </a>
                </li>
            }
            else if (role == RoleType.PrincipleInvestigator.GetEnumDescription())
            {
                <li class="@Html.isActive("Project", "MyProjects")">
                    <a href="@Url.Action("MyProjects", "Project")" title="My Projects">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>My Projects</span>
                    </a>
                </li>
                <li class="@Html.isActive("User", "PrincipleInvestigators")">
                    <a href="@Url.Action("PrincipleInvestigators", "User")" title="PrincipleIvestigators">
                        <em class="fa-2x  fas fa-users"></em>
                        <span>Principle Ivestigators</span>
                    </a>
                </li>
                <li class="@Html.isActive("User", "ResearchAssistants")">
                    <a href="@Url.Action("ResearchAssistants", "User")" title="ResearchAssistants">
                        <em class="fa-2x  fas fa-users"></em>
                        <span>Research Assistants</span>
                    </a>
                </li>
            }
            else if (role == RoleType.ResearchAssistant.GetEnumDescription())
            {
                <li class="@Html.isActive("Project", "MyProjects")">
                    <a href="@Url.Action("MyProjects", "Project")" title="Organizations">
                        <em class="fa-2x  far fa-clipboard"></em>
                        <span>My Projects</span>
                    </a>
                </li>

            }
            <li class="@Html.isActive("General", "Index")">
                <a href="@Url.Action("Index", "General")">
                    <em class="fa-2x icon-settings "></em>
                    <span>Settings</span>
                </a>
            </li>

            <!-- END user info-->
            <!-- Iterates over all sidebar items-->
            @if (role == "Research Assistant")
            {
                <li class="nav-heading">
                    <span>Main Navigation</span>
                </li>
                <li>
                    <a href="@Url.Action("MyProjects", "ResearchAssistant")" title="MyProjects">
                        <em class="fa-2x mr-2 far fa-clipboard"></em>
                        <span>My Projects</span>
                    </a>
                    <a href="#">
                        <em class="fa-2x icon-settings mr-2"></em>
                        <span>Settings</span>
                    </a>
                </li>
            }
            @if (role == "PI")
            {
                <li class="nav-heading">
                    <span>Main Navigation</span>
                </li>
                <li>
                    <a href="@Url.Action("MyProjects", "ResearchAssistant")" title="MyProjects">
                        <em class="fa-2x mr-2 far fa-clipboard"></em>
                        <span>My Projects</span>
                    </a>
                    <a href="@Url.Action("PrincipleInvestigators", "PrincipleInvestigator")" title="PrincipleIvestigators">
                        <em class="fa-2x mr-2 fas fa-users"></em>
                        <span>Principle Ivestigators</span>
                    </a>
                    <a href="@Url.Action("ResearchAssistants", "PrincipleInvestigator")" title="ResearchAssistants">
                        <em class="fa-2x mr-2 fas fa-users"></em>
                        <span>Research Assistants</span>
                    </a>
                    <a href="#">
                        <em class="fa-2x icon-settings mr-2"></em>
                        <span>Settings</span>
                    </a>
                </li>
            }
            @if (role == "UniversityAdmin")
            {
                <li class="nav-heading">
                    <span>Main Navigation</span>
                </li>
                <li>
                    <a href="@Url.Action("Labs", "UniversityAdmin")" title="Labs">
                        <em class="fa-2x icon-chemistry mr-2"></em>
                        <span>Labs</span>
                    </a>
                    <a href="#">
                        <em class="fa-2x icon-settings mr-2"></em>
                        <span>Settings</span>
                    </a>
                </li>
            }

        </ul>
        <!-- END sidebar nav-->
    </nav>
</div>
<!-- END Sidebar (left)-->
