<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>XRealityLab | @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/fonts/xr/fonts.css" />
    <link rel="stylesheet" href="~/css/xr-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="xr-auth">
        <aside class="xr-auth-side">
            <img src="~/_images/Logo/XRealityLab-wordmark.png" alt="XRealityLab" />
            <div class="xr-auth-frame">
                <h1>Every trial, <em>on record.</em></h1>
                <p>Plan your studies, run sessions with participants, and collect results straight from your VR and AR applications.</p>
            </div>
            <p class="xr-auth-chain">Organization <b>/</b> Lab <b>/</b> Project <b>/</b> Session <b>/</b> Participant</p>
        </aside>
        <main class="xr-auth-main" role="main">
            <div class="xr-auth-form">
                @RenderBody()
                <p class="xr-auth-foot">&copy; @DateTime.Now.Year XRealityLab</p>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
