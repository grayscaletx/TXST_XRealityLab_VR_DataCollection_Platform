@model XRealityLab.ProfileNavDTO;
@using XRealityLab
@using System.Security.Claims;

<div id="user-block">
    <div class="item user-block">
        <!-- User picture-->
        <div class="user-block-picture">
            <div class="user-block-status">
                <img id="user-photo" src="@Model.PhotoUrl" alt="Avatar" width="60" height="60" class="rounded-circle" />
                <div class="circle bg-success circle-lg"></div>
            </div>
        </div>
        <!-- Name and Job-->
        <div class="user-block-info">
            <span class="user-block-name"><strong>@Model.FullName</strong></span>
            <span class="user-block-role">@(Model.RoleName == "DirectorIT" ? "Director of IT" : Model.RoleName == "LabDirector" ? "Lab Director" : Model.RoleName == "PrincipleInvestigator" ? "Principal Investigator" : Model.RoleName == "ResearchAssistant" ? "Research Assistant" : Model.RoleName)</span>
            <a href="@Url.Action("EditProfile", "User")"><em class="fas fa-edit" title="Edit profile"></em></a>
        </div>
    </div>
</div>