@model IEnumerable<ARI.Models.PackagingLineFormDTO>
@using System.Security.Claims;
@using ARI.Common;

@{
    ViewBag.Title = "Έντυπα παλετών";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        Έντυπα συσκευαστηρίου
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--Form list-->
<div class="card" style="max-width:1800px">
    <div class="card-header">
        <div class="card-title">Γραμμή συσκευαστηρίου \ Έντυπα συσκευαστηρίου</div>
        <div class="text-sm">Στο παρακάτω πίνακα εμφανίζονται τα έντυπα του συσκευαστηρίου.</div>
        <a asp-action="ExportPalletData" class="mb-1 btn btn-primary" type="button" style="float: right;margin: 0px 0px 0px 5px;display:inline">Εξαγωγή δεδομένων</a>
        <a asp-action="AddPackagingLineForm" class="mb-1 btn btn-primary" type="button" style="float: right;display:inline">Δημιουργία νέου εντύπου</a>
    </div>
    <div class="card-body">
        <table class="table table-striped my-5 w-100" id="packagingLineDataTable">
            <thead>
                <tr>
                    <th>Α/Α</th>
                    <th style="text-align: center">Ημέρα εντύπου</th>
                    <th style="text-align: center">Κωδικοποίηση παλέτας</th>
                    <th style="text-align: center">Προϊόν</th>
                    <th style="text-align: center">LOT παραγωγής</th>
                    <th style="text-align: center">Χώρα</th>
                    <th style="text-align: center">Αριθμός ολοκλ. παλετών</th>
                    <th style="text-align: center">Ημερομηνία Δημιουργίας</th>
                    <th style="text-align: center">Κατάσταση</th>
                    <th style="text-align: center">Διαχείριση</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="gradeX">
                        @{
                            string badgeClass = "badge-" + (item.StatusId == -1 ? "danger" : item.StatusId == 0 ? "success" :
                                item.StatusId == 1 ? "warning" : item.StatusId == 2 ? "dark" : "");
                        }
                        <td data-sort="@item.PackagingLineId">
                            <a>ΚΕΣ @item.PackagingLineId</a>
                        </td>
                        <td data-sort="@Convert.ToInt64(((DateTimeOffset)item.FormDate).ToUnixTimeSeconds())" style="text-align: center">@item.FormDate.ToString("dd/MM/yyyy")</td>
                        <td style="text-align: center">@item.MaterialDescription</td>
                        <td style="text-align: center">@item.PackagingLineDescription</td>
                        <td style="text-align: center">@item.MaterialLOT</td>
                        <td style="text-align: center">@item.CountryCode</td>
                        <td style="text-align: center">@item.NoCompletedPallets / @item.NoPalletToCreated</td>
                        <td style="text-align: center">@item.RegistrationDateTime.ToString("dd/MM/yyyy HH:mm")</td>

                        <td style="text-align: center">
                            <div class="badge @badgeClass">@item.SelectedStatus</div>
                        </td>

                        @*<a class="open-AddDeleteDialog" data-id="@item.PassToken" data-placement="top" style="margin: 0 10px 0 0" data-toggle="modal" title="Διαγραφή" data-target="#DeleteDialog"><em class="mr-2 fas fa-trash-alt"></em></a>*@

                        <td class="ibox-tools">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-cog"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-user">
                                <li style="margin:2px 0">
                                    <a class="btn btn-primary" asp-action="EditPackagingLineForm" asp-route-passToken="@item.PassToken">Επεξεργασία εντύπου</a>
                                </li>
                                <li style="margin:2px 0">
                                    @if (item.StatusId == 1)
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="0" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Αναίρεση επικαιροποίησης</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="1" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Επικαιροποιήση εντύπου παραγωγής</a>
                                    }
                                </li>
                                <li style="margin:2px 0">
                                    @if (item.StatusId != -1)
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="-1" asp-route-passToken="@item.PassToken" asp-route-isEditView="0">Ακύρωση εντύπου παραγωγής</a>
                                    }
                                </li>
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
        <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
        <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
        <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">
}

@section Scripts {
    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>
}
