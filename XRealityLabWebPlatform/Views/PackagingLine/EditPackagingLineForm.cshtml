@model ARI.Models.PackagingLineFormDTO
@{
    ViewBag.Title = "Έντυπα παλετών";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string badgeClass = "badge-" + (Model.StatusId == -1 ? "danger" : Model.StatusId == 0 ? "success" :
        Model.StatusId == 1 ? "warning" : Model.StatusId == 2 ? "dark" : "");
    string badgeHourClass, badgeTitle, palletIcon, warehouseStyleDisplay, submitStyleDisplay;
    badgeHourClass = badgeTitle = palletIcon = warehouseStyleDisplay = submitStyleDisplay = string.Empty;
    string box_no, box_no_10, box_no_20, box_no_30, box_no_40, box_no_50, box_no_60, box_no_70, box_no_80, box_no_90;
    box_no = box_no_10 = box_no_20 = box_no_30 = box_no_40 = box_no_50 = box_no_60 = box_no_70 = box_no_80 = box_no_90 = string.Empty;
}

<!--Header-->
<div class="content-heading">
    <div>
        ΚΕΣ @Model.PackagingLineId
    </div>
</div>

<!--Alert dialog-->
<div id="success-dialog" style="display:none" class="alert alert-success alert-dismissible fade show" role="alert">
    <button class="close" type="button" onclick="CloseSuccessDialog()" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
    <strong>Ανανεώση</strong> Η εγγραφή ανανεώθηκε με επιτυχία
</div>
<br />
<!--Packaging line info-->
<div class="card card-default" style="max-width:1300px">
    <div class="card-body">
        <div class="row">
            <div class="col-lg-6">
                <p class="lead bb">Γραμμή συσκευαστηρίου \ ΚΕΣ @Model.PackagingLineId <i style="font-size:11px"> (Ημερομηνία και ώρα δημιουργίας:@Model.RegistrationDateTime.ToString("dd/MM/yyyy HH:mm"))</i></p>
                <form class="form-horizontal">
                    <div class="form-group row">
                        <div class="col-md-4">Κατάσταση παραγωγής:</div>
                        <div class="badge @badgeClass" style="margin:0px 10px">@Model.SelectedStatus</div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία εντύπου:</div>
                        <div class="col-md-8">
                            <strong>@Model.FormDate.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Κωδικοποίηση παλέτας:</div>
                        <div class="col-md-8">
                            <strong>@Model.MaterialDescription</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">LOT παραγωγής:</div>
                        <div class="col-md-2">
                            <strong>@Model.MaterialLOT</strong>
                        </div>
                        <div class="col-md-2" id="lot-edit" style="display:none">
                            <a id="lot-edit-in" class="mb-1 btn btn-primary" onclick='EditClick(this)'>Επεξ. LOT</a>
                        </div>
                        <div class="col-md-2" id="lot-edit-field" style="display:none">
                            <input maxlength="4" size="4" class="form-control" id="lot" />
                        </div>
                        <div class="col-md-2" id="lot-save" style="display:none">
                            <a class="mb-1 btn btn-primary" onclick='ChangeAllPalletLot(this)'>Αποθ.</a>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Αριθμός χαρτοκιβωτίων ανά παλέτα:</div>
                        <div class="col-md-8">
                            <strong>@Model.Material.PalletFactor</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Αριθμός δημιουργημένων παλετών:</div>
                        <div class="col-md-8">
                            <strong id="no-created-box">@Model.NoCompletedPallets</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Συνολικός αριθμός παλετών εντύπου γραμμής συσκευαστηρίου:</div>
                        <div class="col-md-8">
                            <strong>@Model.NoPalletToCreated</strong>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-6">
                <div class="text-sm" style="float: right">
                    <div class="ibox">
                        <div class="ibox-tools">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-cog"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-user">
                                <li style="margin:2px 0">
                                    <a class="btn btn-danger" asp-action="ChangeFormAllVirtualStatus" asp-route-passToken="@Model.PassToken" asp-route-isVirtual="1">Μετατροπή όλων των παλετών σε εικονικές</a>
                                </li>
                                <li style="margin:2px 0">
                                    <a class="btn btn-primary" asp-action="ChangeFormAllVirtualStatus" asp-route-passToken="@Model.PassToken" asp-route-isVirtual="0">Μετατροπή όλων των παλετών σε πραγματικές</a>
                                </li>
                                <li style="margin:2px 0">
                                    @if (Model.StatusId == 1)
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="0" asp-route-passToken="@Model.PassToken" asp-route-isEditView="1">Αναίρεση επικαιροποίησης</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="1" asp-route-passToken="@Model.PassToken" asp-route-isEditView="1">Επικαιροποιήση εντύπου παραγωγής</a>
                                    }
                                </li>
                                <li style="margin:2px 0">
                                    @if (Model.StatusId != -1)
                                    {
                                        <a class="btn btn-primary" asp-action="ChangeFormAllStatus" asp-route-formStatus="-1" asp-route-passToken="@Model.PassToken" asp-route-isEditView="1">Ακύρωση εντύπου παραγωγής</a>
                                    }
                                </li>
                                <li style="margin:2px 0">
                                    @if (Model.StatusId != -1)
                                    {
                                    <a id="lot-edit-cog" class="mb-1 btn btn-primary" onclick='EditClick(this)'>Επεξ. LOT</a>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <p class="lead bb" style="margin:31px 0px 10px 0px"></p>
                <p>
                </p>
                <p class="lead bb" style="margin:31px 0px 10px 0px"></p>
                <a href="@Model.PalletCardAriLink" target="_blank" class="btn btn-primary" style="display:none; float: right;max-width:250px">Εκτύπωση των ARI παλετοκαρτών της συγκεκριμένης παραγωγής</a>
                <form class="form-horizontal" style="margin:10px 0px 0px 0px">
                    <div class="form-group row">
                        <div class="col-md-4">Κωδικός SAP:</div>
                        <div class="col-md-8">
                            <strong>@Model.Material.MaterialSAPID</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Χώρα:</div>
                        <div class="col-md-8">
                            <strong>@Model.CountryCode</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία λήξης των παλετών της παραγωγής:</div>
                        <div class="col-md-8">
                            <strong>@Model.Material.ExpirationDate.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Σημειώσεις:</div>
                        <div class="col-md-8">
                            <strong>@Model.Notes</strong>
                        </div>
                    </div>
                    <div style="float: right;text-align:right;margin:20px 0px 0px 0px">
                        @if (Model.StatusId < 2)
                        {
                            <br />
                            <br />
                            <br />
                            <p>
                                Δημιουργήθηκαν <strong id="no-created-box-1">@Model.NoCompletedPallets παλέτες</strong>. <br />
                                Υπολείπονται <strong id="no-remaining-box">@(Model.NoPalletToCreated - Model.NoCompletedPallets) παλέτες</strong><br />
                            </p>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<br />
<!--Tracking hours header-->
<div class="card card-default" style="max-width:1300px;margin:0px 10px -10px 0px">
    <div class="card-body">
        <div>
            <p class="lead">Καταγραφή ωρών παλετών</p>
            <div style="float: right;margin:-30px 0px 0px 0px">
                <p>
                    <canvas style="width: 10px; height: 10px; background: orange; margin: 0px 0px 0px 0px"></canvas>
                    <i>Εικονική παλέτα</i>
                    <canvas style="width: 10px; height: 10px; background: green; margin: 0px 0px 0px 10px"></canvas>
                    <i>Διαθέσιμες</i>
                    <canvas style="width: 10px; height: 10px; background: yellow; margin: 0px 0px 0px 10px "></canvas>
                    <i>Δεσμευμένες</i>
                    <canvas style="width: 10px; height: 10px; background: black; margin: 0px 0px 0px 10px "></canvas>
                    <i>Δεσμευμένες για φόρτωση</i>
                    <canvas style="width: 10px; height: 10px; background: purple; margin: 0px 0px 0px 10px "></canvas>
                    <i>Επικαιροποιημένες για φόρτωση</i>
                </p>
            </div>
        </div>
    </div>
</div>
<br />

<!--Submit hour table-->
@for (int i = 0; i < 10; i++)
{
    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i))
        box_no = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().CreationDateTime != null) ?
   Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 10))
        box_no_10 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 10).FirstOrDefault().CreationDateTime != null) ?
           Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 10).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 20))
        box_no_20 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 20).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 20).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 30))
        box_no_30 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 30).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 30).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 40))
        box_no_40 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 40).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 40).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 50))
        box_no_50 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 50).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 50).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 60))
        box_no_60 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 60).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 60).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 70))
        box_no_70 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 70).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 70).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 80))
        box_no_80 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 80).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 80).FirstOrDefault().CreationDateTime : "0.00";

    @if (Model.palletDTOs.Any(k => k.PackagingLinePalletNo == i + 90))
        box_no_90 = (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 90).FirstOrDefault().CreationDateTime != null) ?
            Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 90).FirstOrDefault().CreationDateTime : "0.00";

    <table style="width:150px;display:inline;margin:0px 12px 0px 0px">
        <tbody>
            @if (Model.NoPalletToCreated > i)
            {
                <tr class="gradeX">
                    @{ var statusId = Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().StatusId;
                        badgeHourClass = "badge-" + (statusId == -1 ? "danger" : statusId == 0 ? "warning" :
                            statusId == 1 ? "success" : statusId == 2 ? "info" : statusId == 3 ? "dark" :
                            statusId == 4 ? "purple" : "");
                        badgeTitle = (statusId == -1 ? "Άκυρο" : statusId == 0 ? "Αναμ. για φορτ." :
                            statusId == 1 ? "Δημιουργήθ." : statusId == 2 ? "Προστ. στην αποθ." : statusId == 3 ? "Επιλ. για φορτ." :
                            statusId == 4 ? "Επιβ. για φορτ." : "");
                        palletIcon = Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().IsVirtual
                            ? "/images/virtual_pallet__icon.png" : "/images/pallet_icon.png";
                        warehouseStyleDisplay = statusId == 1 ? "block" : "none";
                        submitStyleDisplay = Model.palletDTOs.Exists(k => k.PackagingLinePalletNo == i && k.CreationDateTime == null) ? "block" : "none";
                    }
                    <td>
                        <div class="card">
                            <div class="card-body text-center">
                                @if (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).Count() != 0)
                                {
                                    <a class="open-palletDialog" data-id="@Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().PalletId" data-placement="top" data-toggle="modal" data-target="#PalletDialog" style="cursor:pointer;font-size:30px">@(i + 1)</a>
                                }
                                <br />
                                <img src="@palletIcon" style="margin: 0px 0px 10px 0px" />
                                <p class="mb-3">Ώρα <strong>@box_no</strong></p>
                                <div id="status-badge" class="badge @badgeHourClass" style="margin: 0px 0px; width: 84px">@badgeTitle</div>
                                <br />
                                <br />
                                <a id="warehouse-a" class="btn btn-primary" asp-controller="Warehouse" asp-action="TopView" style="display: @warehouseStyleDisplay; white-space: normal; width: 80px; height: 50px; text-align: center; line-height: 30px; font-size: 12px; background-color: forestgreen; border-color: green">Αποθήκη</a>
                                <button id="add-time-btn" onclick="DisplayBtnData(this)" class="btn btn-primary open-AddTime" type="button" data-toggle="modal" data-target="#AddTimeDialog" style="display: @submitStyleDisplay; white-space: normal; width: 80px; height: 50px; font-size: 12px; background-color: orange; border-color: darkorange ">Υποβολή ώρας</button>
                                @if (Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i).FirstOrDefault().StatusId >= 2 && Model.palletDTOs.Where(k => k.StatusId >= 2).Count() != Model.palletDTOs.Count())
                                {
                                    <div style="width:80px;height:50px"></div>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.NoPalletToCreated > 10 + i)
            {
                <tr class="gradeX">
                    @{ var statusId = Model.palletDTOs.Where(k => k.PackagingLinePalletNo == i + 10).FirstOrDefault().StatusId;
                        badgeHourClass = "badge-" + (statusId == -1 ? "danger" : statusId == 0 ? "warning" :
                            statusId == 1 ? "success" : statusId == 2 ? "info" : statusId == 3 ? "dark" :
