                        badgeTitle = (statusId == -1 ? "Άκυρο" : statusId == 0 ? "Αναμ. για φορτ." :
                            statusId == 1 ? "Δημιουργήθ." : statusId == 2 ? "Προστ. στην αποθ." : statusId == 3 ? "Επιλ. για φορτ." :
