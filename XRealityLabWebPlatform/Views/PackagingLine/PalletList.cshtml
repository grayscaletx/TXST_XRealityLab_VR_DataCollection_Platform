@section BodyArea {
    <!--Pallet info dialog-->
    <div class="modal fade" id="PalletDialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog" style="align-content:center">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="modal-pallet-label">Προβολή παλέτας</h4>&nbsp;&nbsp;
                    <div class="ibox">
                        <div class="ibox-tools">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-cog"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-user">
                                <li style="margin:2px 0" id="modal-pallet-action-rollback">
                                    <a class="btn btn-primary">Αφαίρεση της παλέτας από την αποθήκη</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body" style="align-items: center">
                    <div id="modal-pallet-status-badge" class="badge" style="display: block; margin-left: auto; margin-right: auto;width:240px">Επιβ. για φορτ.</div>
                    <br />
                    <img id="modal-pallet-material-virtual" src="~/images/pallet_icon.png" style="display:block;margin-left:auto;margin-right:auto" width="50" height="50" />
                    <br />
                    <p style="font-size:16px">Κωδικοποίηση παλέτας: <strong id="modal-pallet-material-description">-</strong></p>
                    <p style="font-size:16px">Κωδικός SAP προϊόντος: <strong id="modal-pallet-sapid">-</strong></p>
                    <p style="font-size:16px">LOT παλέτας: <strong id="modal-pallet-lot">-</strong></p>
                    <p style="font-size:16px">Χώρα: <strong id="modal-pallet-country">-</strong></p>
                    <p style="font-size:16px">Αριθμός χαρτοκιβωτίων: <strong id="modal-pallet-pallet-boxes">-</strong></p>
                    <p style="font-size:16px">Ώρα συσκευασίας: <strong id="modal-pallet-creation-time">-</strong></p>
                    <p style="font-size:16px">Μέγιστη ημερομηνία παράδοσης: <strong id="modal-pallet-max-delivery-date">-</strong></p>
                    <p style="font-size:16px">Ημερομηνία λήξης της παλέτας: <strong id="modal-pallet-expiration-date">-</strong></p>
                    <p style="font-size:16px">QR παλέτας:</p>
                    <img style="display: block; margin-left: auto; margin-right: auto" id="modal-qr-image" width="300" height="300" />
                    <p style="font-size:16px">Barcode παλέτας:</p>
                    <img style="display: block; margin-left: auto; margin-right: auto" id="modal-barcode-image" width="300" height="80" />
                </div>
                <a href="" id="modal-pallet-palletcard" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;max-width:200px">Εκτύπωση παλετοκάρτας ARI</a>
                <a href="" id="modal-pallet-palletcard-lidl" target="_blank" class="btn btn-primary" style="display:block;margin-left:auto;margin-right:auto;margin-top:10px;max-width:200px">Εκτύπωση παλετοκάρτας LIDL</a>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
}

@section Styles{
    <style>
        .pallet-btn {
            opacity: 1.0;
        }
        .pallet-btn:hover {
            opacity: 0.6;
            cursor: pointer;
        }
        .pallet-warehouse-btn {
            opacity: 1.0;
        }
        .pallet-warehouse-btn:hover {
            opacity: 0.6;
            cursor: pointer;
        }
    </style>
}

@section Scripts {
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script>
        //Initialize
        lastPalletToLoadElement = "", lastWarehousePalletElement = "";
        var [pallet_btns, pallet_warehouse_btns, line_pallet_btns, from_warehouse, position] = [];
        var [modalVirtual, modalRollback, modalLabel, modalDescription, modalSAPId, modalLOT, modalCountry, modalBoxes,
            modalCreation, modalDeliveryDate, modalExpirationDate, modalQR, modalBarcode, modalCardARI, modalCardLidl] = [];
        var [sala1Title, sala1Warehouse, sala1PsigeioTitle, sala1PsigeioWarehouse, proektasiTitle, proektasiWarehouse, sala2DeksiaTitle, sala2DeksiaWarehouse, sala2AristeriTitle,
            sala2AristeriWarehouse, sala2DomatioTitle, sala2DomatioWarehouse, makioTitle, makioWarehouse, eikonikiTitle, eikonikiWarehouse] = [];
        init();

        //Info for warehouse pallets (dbclick)
        for (var i = 0; i < pallet_warehouse_btns.length; i++) {
            pallet_warehouse_btns[i].addEventListener('dblclick', function (event) {
                var urlString = "?warehouseId=" + from_warehouse.value + "&loadinglineId=" + position.value + "&itemId=" + event.currentTarget.id.split('-')[4];

                $.get("GetPalletWarehouseInfo/" + urlString, function (data) {
                    modalRollback.style.display = 'block';
                    modalRollback.children[0].href = "/PackagingLine/RevertPalletToLobby?passToken=" + data.passToken;
                    modalLabel.innerHTML = "Κωδικός παλέτας ΚΠ" + data.palletId;
                    modalDescription.innerHTML = data.material.materialDescription;
                    modalVirtual.src = data.isVirtual ? "/images/virtual_pallet__icon.png" : "/images/pallet_icon.png";
                    modalSAPId.innerHTML = data.material.materialSAPID;
                    modalLOT.innerHTML = data.palletLOT;
                    modalCountry.innerHTML = data.countryCode;
                    modalBoxes.innerHTML = data.noPalletBox;
                    modalCreation.innerHTML = data.creationDateTime;
                    modalDeliveryDate.innerHTML = formatDate(data.material.maxDeliveryDate);
                    modalExpirationDate.innerHTML = formatDate(data.material.expirationDate);
                    modalQR.src = data.qrCodeLink;
                    modalBarcode.src = data.barCodeLink;
                    modalCardARI.href = data.palletCardLink;
                    modalCardLidl.href = data.palletCardLIDL;
                    modalCardLidl.hidden = data.palletCardLIDL == null ? true : false;
                    modalStatusBadge.innerHTML = data.selectedStatus
                    modalStatusBadge.className = "";
                    modalStatusBadge.classList.add('badge');
                    modalStatusBadge.classList.add(data.statusId == 0 ? 'badge-warning' : data.statusId == 1 ?
                        'badge-success' : data.statusId == 2 ? 'badge-info' : data.statusId == 3 ? 'badge-dark' : data.statusId == 4 ?
                            'badge-danger' : data.statusId == -1 ? 'badge-success' : '');
                    modalStatusBadge.style.color = (data.statusId == 2) ? 'black' : 'white';
                });
                $('#PalletDialog').modal('toggle');
            });
        }

        //Selection (click)
        //Info for warehouse pallets (dbclick)
        for (var i = 0; i < pallet_btns.length; i++) {
            pallet_btns[i].addEventListener('click', function (event) {
                if (lastPalletToLoadElement != "") {
                    lastPalletToLoadElement.style.background = "green";
                }
                for (var i = 0, opts = document.getElementById('pallet').options; i < opts.length; ++i)
                    if (opts[i].value.includes(event.currentTarget.id.split('-')[4])) {
                        $("#pallet").val(opts[i].value);
                        break;
                    }
                document.getElementById(event.currentTarget.id).style.background = "blue";
                lastPalletToLoadElement = document.getElementById(event.currentTarget.id);
                submitVisibility();
            });
            pallet_btns[i].addEventListener('dblclick', function (event) {
                $.get("GetPalletInfo/?palletId=" + event.currentTarget.id.split('-')[4], function (data) {
                    modalRollback.style.display = 'none';
                    modalLabel.innerHTML = "Κωδικός παλέτας ΚΠ" + data.palletId;
                    modalDescription.innerHTML = data.material.materialDescription;
                    modalVirtual.src = data.isVirtual ? "/images/virtual_pallet__icon.png" : "/images/pallet_icon.png";
                    modalSAPId.innerHTML = data.material.materialSAPID;
                    modalLOT.innerHTML = data.palletLOT;
                    modalCountry.innerHTML = data.countryCode;
                    modalBoxes.innerHTML = data.noPalletBox;
                    modalCreation.innerHTML = data.creationDateTime;
                    modalCreation.innerHTML = formatDate(data.material.maxDeliveryDate);
                    modalExpirationDate.innerHTML = formatDate(data.material.expirationDate);
                    modalQR.src = data.qrCodeLink;
                    modalBarcode.src = data.barCodeLink;
                    modalCardARI.href = data.palletCardLink;
                    modalCardLidl.href = data.palletCardLIDL;
                    modalCardLidl.hidden = data.palletCardLIDL == null ? true : false;

                    modalStatusBadge.innerHTML = data.selectedStatus
                    modalStatusBadge.className = "";
                    modalStatusBadge.classList.add('badge');
                    modalStatusBadge.classList.add(data.statusId == 0 ? 'badge-warning' : data.statusId == 1 ?
                        'badge-success' : data.statusId == 2 ? 'badge-info' : data.statusId == 3 ? 'badge-dark' : data.statusId == 4 ?
                            'badge-danger' : data.statusId == -1 ? 'badge-success' : '');
                    modalStatusBadge.style.color = (data.statusId == 2) ? 'black' : 'white';
                });
                $('#PalletDialog').modal('toggle');
            });
        }
        for (var i = 0; i < line_pallet_btns.length; i++) {
            line_pallet_btns[i].addEventListener('mouseover', function (event) {
                line_pallet_items = event.currentTarget.getElementsByClassName("pallet-line-item");
                if (line_pallet_items != null)
                    for (var i = 0; i < line_pallet_items.length; i++) {
                        line_pallet_items[i].style.opacity = "0.6";
                    }
            });
            line_pallet_btns[i].addEventListener('mouseout', function (event) {
                line_pallet_items = event.currentTarget.getElementsByClassName("pallet-line-item");
                if (line_pallet_items != null)
                    for (var i = 0; i < line_pallet_items.length; i++) {
                        line_pallet_items[i].style.opacity = "1.0";
                    }
            });
            line_pallet_btns[i].addEventListener('click', function (event) {
                if (lastWarehousePalletElement != "" && lastWarehousePalletElement != null) {
                    lastWarehousePalletElement.style.background = "green";
                }
                var positionValue = event.currentTarget.getElementsByClassName('line-description')[0];
                line_pallet_items = event.currentTarget.getElementsByClassName("pallet-line-item");

                var temp_background_color = document.getElementById('warehouse-pallet-' + from_warehouse.value + '-' + positionValue.textContent.substring(1) + '-' + line_pallet_items.length).style.getPropertyValue('background-color');
                if (temp_background_color == "yellow" || temp_background_color == "black" || temp_background_color == "purple")
                    return;

                line_pallet_items[line_pallet_items.length - 1].style.background = "blue";

                if ($("#position option").length != 1)
                    for (var i = 0, opts = position.options; i < opts.length; ++i)
                        if (opts[i].text.includes(positionValue.textContent)) {
                            $("#position").val(opts[i].value);
                            break;
                        }

                lastWarehousePalletElement = document.getElementById('warehouse-pallet-' + from_warehouse.value + '-' + positionValue.textContent.substring(1) + '-' + line_pallet_items.length);
                submitVisibility();
            });
        }

        //OnChange events
        $("#pallet").change(function () {
            if (lastPalletToLoadElement != "") {
                lastPalletToLoadElement.style.background = "green";
            }
            document.getElementById('pallet-card-to-load-' + pallet.value).style.background = pallet.value == "-" ? "green" : "blue";

            lastPalletToLoadElement = document.getElementById('pallet-card-to-load-' + pallet.value);
            submitVisibility();
        });
        $("#from-warehouse").change(function () {
            clearWarehouseDisplay();
            if (from_warehouse.value == "-") {
                position.innerHTML = "";
                $("#position").append("<option value=\"" + "-" + "\">" + "-" + "</option>");
            }
            else {
                sala1Title.style.display = sala1Warehouse.style.display = from_warehouse.value == "1" ? "block" : "none";
                sala1PsigeioTitle.style.display = sala1PsigeioWarehouse.style.display = from_warehouse.value == "2" ? "block" : "none";
                proektasiTitle.style.display = proektasiWarehouse.style.display = from_warehouse.value == "3" ? "block" : "none";
                sala2DeksiaTitle.style.display = sala2DeksiaWarehouse.style.display = from_warehouse.value == "4" ? "block" : "none";
                sala2AristeriTitle.style.display = sala2AristeriWarehouse.style.display = from_warehouse.value == "5" ? "block" : "none";
                sala2DomatioTitle.style.display = sala2DomatioWarehouse.style.display = from_warehouse.value == "6" ? "block" : "none";
                makioTitle.style.display = makioWarehouse.style.display = from_warehouse.value == "7" ? "block" : "none";
                eikonikiTitle.style.display = eikonikiWarehouse.style.display = from_warehouse.value == "8" ? "block" : "none";

                document.getElementById('transfer-btn').setAttribute("type", "submit");
                $.get("LoadingLines/?loadingAreaId=" + from_warehouse.value, function (data) {
                    position.innerHTML = "";
                    for (var i = 0; i < data.length; i++) {
                        $("#position").append("<option value=\"" + data[i].value + "\">" + data[i].text + "</option>");
                    }
                });
            }

            if (from_warehouse.value == "2" && document.getElementById('container-area-2').textContent != '16') {
                document.getElementById('warehouse-pallet-2-0-16').style.background = "blue";
            }
            else if (from_warehouse.value == "7" && document.getElementById('container-area-7').textContent != '100') {
                document.getElementById('warehouse-pallet-7-0-100').style.background = "blue";
            }
            else if (from_warehouse.value == "8" && document.getElementById('container-area-8').textContent != '200') {
                document.getElementById('warehouse-pallet-8-0-200').style.background = "blue";
            }
            submitVisibility();
        });
        $("#position").change(function () {
            if (lastWarehousePalletElement != "" && lastWarehousePalletElement != null) {
                lastWarehousePalletElement.style.background = "green";
            }
            var tempPos = from_warehouse.value == 1 || from_warehouse.value == 3 || from_warehouse.value == 4 ? 12 : from_warehouse.value == 5 ? 4 : from_warehouse.value == 6 ? 8 : 0;
            document.getElementById('warehouse-pallet-' + from_warehouse.value + (position.value == "-" ? '-1-' : '-' + position.value + '-') + tempPos).style.background = (position.value == "-") ? "green" : "blue";
            lastWarehousePalletElement = document.getElementById('warehouse-pallet-' + from_warehouse.value + '-' + position.value + '-' + tempPos);
            submitVisibility();
        });

        //Actions
        function transferPalletToWarehouse() {
            if (position.value)
                if (from_warehouse.value != "-" && pallet.value != "-" && (position.value != "-" || (from_warehouse.value == "2" && position.value == "-") || (from_warehouse.value == "7" && position.value == "-"))) {
                    var urlString = "?palletId=" + pallet.value + "&warehouseId=" + from_warehouse.value + "&loadinglineId=" + position.value;
                    $.get("TransferPalletToWarehouse/" + urlString, function (data) {
                        window.location = '/PackagingLine/PalletList?succeededPastAction=true'
                    });
                }
        }

        //Helpers
        function init() {
            document.getElementById('pallet').selectedIndex = 0;
            document.getElementById("from-warehouse").selectedIndex = 0;

            pallet_btns = document.getElementsByClassName('pallet-btn');
            pallet_warehouse_btns = document.getElementsByClassName('pallet-warehouse-btn');
            line_pallet_btns = document.getElementsByClassName('line-pallet-btn');
            from_warehouse = document.getElementById('from-warehouse');
            position = document.getElementById('position');

            modalVirtual = document.getElementById("modal-pallet-material-virtual")
            modalRollback = document.getElementById("modal-pallet-action-rollback");
            modalLabel = document.getElementById("modal-pallet-label");
            modalDescription = document.getElementById("modal-pallet-material-description");
            modalSAPId = document.getElementById("modal-pallet-sapid");
            modalLOT = document.getElementById("modal-pallet-lot");
            modalCountry = document.getElementById("modal-pallet-country");
            modalBoxes = document.getElementById("modal-pallet-pallet-boxes");
            modalCreation = document.getElementById("modal-pallet-creation-time");
            modalDeliveryDate = document.getElementById("modal-pallet-max-delivery-date");
            modalExpirationDate = document.getElementById("modal-pallet-expiration-date");
            modalQR = document.getElementById("modal-qr-image");
            modalBarcode = document.getElementById("modal-barcode-image");
            modalCardARI = document.getElementById("modal-pallet-palletcard");
            modalCardLidl = document.getElementById("modal-pallet-palletcard-lidl");
            modalStatusBadge = document.getElementById("modal-pallet-status-badge");

            sala1Title = document.getElementById('sala-1-title');
            sala1Warehouse = document.getElementById('sala-1-warehouse');
            sala1PsigeioTitle = document.getElementById('sala-1-psigeio-title');
            sala1PsigeioWarehouse = document.getElementById('sala-1-psigeio-warehouse');
            proektasiTitle = document.getElementById('proektasi-title');
            proektasiWarehouse = document.getElementById('proektasi-warehouse');
            sala2DeksiaTitle = document.getElementById('sala-2-deksia-title');
            sala2DeksiaWarehouse = document.getElementById('sala-2-deksia-warehouse');
            sala2AristeriTitle = document.getElementById('sala-2-aristeri-title');
            sala2AristeriWarehouse = document.getElementById('sala-2-aristeri-warehouse');
            sala2DomatioTitle = document.getElementById('sala-2-domatio-title');
            sala2DomatioWarehouse = document.getElementById('sala-2-domatio-warehouse');
            makioTitle = document.getElementById('makio-title');
            makioWarehouse = document.getElementById('makio-warehouse');
            eikonikiTitle = document.getElementById('eikoniki-title');
            eikonikiWarehouse = document.getElementById('eikoniki-warehouse');
        };
        function formatDate(date) {
            var d = new Date(date),
                month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2)
                month = '0' + month;
            if (day.length < 2)
                day = '0' + day;

            return [day, month, year].join('-');
        }

        //UI Utils
        function submitVisibility() {
            var model = @Html.Raw(Json.Serialize(Model.PalletDTOs));
            var virtualCheck = false;
            for (var i = 0; i < model.length; i++)
            {
                if (model[i].palletId == pallet.value)
                    virtualCheck = model[i].isVirtual;
            }
            if (!virtualCheck && from_warehouse.value != "-" && pallet.value != "-" && (position.value != "-" || (from_warehouse.value == "2" && position.value == "-") || (from_warehouse.value == "7" && position.value == "-"))) {
                document.getElementById('transfer-btn').setAttribute("type", "submit");
            }
            else {
                document.getElementById('transfer-btn').setAttribute("type", "hidden");
            }
        }
        function closeSuccessDialog() {
            window.location = '/PackagingLine/PalletList?succeededPastAction=false'
        }
        function clearWarehouseDisplay() {
            sala1Title.style.display = sala1Warehouse.style.display = sala1PsigeioTitle.style.display = sala1PsigeioWarehouse.style.display = proektasiTitle.style.display =
                proektasiWarehouse.style.display = sala2DeksiaTitle.style.display = sala2DeksiaWarehouse.style.display = sala2AristeriTitle.style.display =
                sala2AristeriWarehouse.style.display = sala2DomatioTitle.style.display = sala2DomatioWarehouse.style.display = makioTitle.style.display = makioWarehouse.style.display =
                eikonikiTitle.style.display = eikonikiWarehouse.style.display = "none";
        }
    </script>
}