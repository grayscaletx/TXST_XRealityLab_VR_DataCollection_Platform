@section Scripts {
    @*<script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>*@
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <script>
        //Initialize view elements
        document.getElementById('to-warehouse').style.display = "none";
        document.getElementById('selected-pallet').style.display = "none";

        //From Warehouse
        document.getElementById('curr-from-warehouse').selectedIndex = 0;
        var curr_pallet_warehouse_btns = document.getElementsByClassName('curr-pallet-warehouse-btn');

        for (var i = 0; i < curr_pallet_warehouse_btns.length; i++) {
            curr_pallet_warehouse_btns[i].addEventListener('click', function (event) {
                curr_pallet_btn = event.currentTarget;

                if (curr_pallet_btn.style.getPropertyValue('background-color') == "black" || curr_pallet_btn.style.getPropertyValue('background-color') == "purple")
                    return;

                if (curr_pallet_btn.style.getPropertyValue('background-color') == "yellow") {
                    curr_pallet_btn.style.background = "blue";

                    ToggleCurrentWarehouse(false)

                    for (const child of curr_pallet_btn.children)
                        if (child.nodeName == "P")
                            child.style.color = "white";

                    var urlString = "?warehouseName=" + event.currentTarget.parentElement.id + "&loadinglineId=" + event.currentTarget.parentNode.parentNode.childNodes[1].id + "&itemId=" + event.currentTarget.id.split('-')[5];
                    $.get("GetCurrPalletWarehouseInfo/" + urlString, function (data) {
                        document.getElementById("selectedPalletId").innerText = data.palletId;
                    });

                    document.getElementById("selected-pallet").children[1].children[1].innerHTML = event.currentTarget.children[1].innerText + "<br/>" +
                        event.currentTarget.children[2].innerText + "<br/>" + event.currentTarget.children[3].innerText + "<br/>"
                        + event.currentTarget.children[4].innerText;
                }
                else {
                    curr_pallet_btn.style.background = "yellow";
                    for (const child of curr_pallet_btn.children)
                        if (child.nodeName == "P")
                            child.style.color = "black";
                }
            });
            //To Warehouse
            curr_pallet_warehouse_btns[i].addEventListener('dblclick', function (event) {
                var urlString = "?warehouseName=" + event.currentTarget.parentElement.id + "&loadinglineId=" + event.currentTarget.parentNode.parentNode.childNodes[1].id + "&itemId=" + event.currentTarget.id.split('-')[4];

                $.get("GetCurrPalletWarehouseInfo/" + urlString, function (data) {
                    document.getElementById("modal-pallet-label").innerHTML = "Κωδικός παλέτας ΚΠ" + data.palletId;
                    document.getElementById("modal-pallet-material-description").innerHTML = data.material.materialDescription;
                    document.getElementById("modal-pallet-sapid").innerHTML = data.material.materialSAPID;
                    document.getElementById("modal-pallet-lot").innerHTML = data.material.materialLOT;
                    document.getElementById("modal-pallet-country").innerHTML = data.countryCode;
                    document.getElementById("modal-pallet-pallet-boxes").innerHTML = data.noPalletBox;
                    document.getElementById("modal-pallet-creation-time").innerHTML = data.creationDateTime;
                    document.getElementById("modal-pallet-max-delivery-date").innerHTML = formatDate(data.material.maxDeliveryDate);
                    document.getElementById("modal-pallet-expiration-date").innerHTML = formatDate(data.material.expirationDate);
                    document.getElementById("modal-qr-image").src = data.qrCodeLink;
                    document.getElementById("modal-barcode-image").src = data.barCodeLink;
                    document.getElementById("modal-pallet-palletcard").href = data.palletCard;

                    //Status
                    document.getElementById("modal-pallet-status-badge").innerHTML = data.selectedStatus
                    document.getElementById("modal-pallet-status-badge").className = "";
                    document.getElementById("modal-pallet-status-badge").classList.add('badge');
                    if (data.statusId == 0) {
                        document.getElementById("modal-pallet-status-badge").innerHTML = data.selectedStatus;
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-warning');
                    }
                    else if (data.statusId == 1) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-success');
                    }
                    else if (data.statusId == 2) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-info');
                        document.getElementById("modal-pallet-status-badge").style.color = "black";
                    }
                    else if (data.statusId == 3) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-dark');
                        document.getElementById("modal-pallet-status-badge").style.color = "white";
                    }
                    else if (data.statusId == 4) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-purple');
                        document.getElementById("modal-pallet-status-badge").style.color = "white";
                    }
                    else if (data.statusId == -1) {
                        document.getElementById("modal-pallet-status-badge").classList.add('badge-danger');
                    }
                });
                $('#PalletDialog').modal('toggle');
            });
        }

        function ToggleCurrentWarehouse(enabled) {
            document.getElementById('curr-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-1-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-1-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-1-psigeio-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-1-psigeio-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-proektasi-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-proektasi-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-deksia-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-deksia-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-aristeri-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-aristeri-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-domatio-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-sala-2-domatio-warehouse').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-makio-title').style.display = (enabled == false) ? "none" : "block";
            document.getElementById('curr-makio-warehouse').style.display = (enabled == false) ? "none" : "block";

            document.getElementById('selected-pallet').style.display = (enabled == true) ? "none" : "block";
