            SubmitVisibility();
        });

        function TransferPositionPalletToWarehouse() {
            var pallet_drop = document.getElementById('selectedPalletId').innerText;
            var warehouse_drop = document.getElementById('from-warehouse').value;
            var position_drop = document.getElementById('position').value;

            if (position_drop)
                if (warehouse_drop != "-" && (position_drop != "-" || (warehouse_drop == "2" && position_drop == "-") || (warehouse_drop == "7" && position_drop == "-"))) {
                    var urlString = "?palletId=" + pallet_drop + "&warehouseId=" + warehouse_drop + "&loadinglineId=" + position_drop;
                    $.get("TransferPositionPalletToWarehouse/" + urlString, function (data) {
