@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@section BodyArea {
    <div class="modal fade" id="PalletDialog" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog" style="align-content:center">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="myModalLabel">Προβολή στοιχείων της παλέτας</h4>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <img style="align-self:center;margin:10px 0px 0px 0px" width="100" height="100" src="~/images/pallet_large_icon.png" />
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-md-4">Κωδικός παλέτας:</div>
                        <div class="col-md-8">
                            <strong id="pallet_id"></strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Κατάσταση:</div>
                        <!--@*TEMP*@-->
                        <div class="badge badge-success" style="margin:0px 10px">Δημιουργήθηκε</div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία εντύπου:</div>
                        <div class="col-md-8">
                            <strong id="pallet_date"></strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Κωδικοποίηση παλέτας:</div>
                        <div class="col-md-8">
                            <strong id="material_description">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Προϊόν:</div>
                        <div class="col-md-8">
                            <strong id="packaging_line_description"></strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">LOT προϊόντος:</div>
                        <div class="col-md-8">
                            <strong id="material_lot">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Χώρα:</div>
                        <div class="col-md-8">
                            <strong id="country_code">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Παλετοκιβώτια:</div>
                        <div class="col-md-8">
                            <strong id="no_pallet_box">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία δημιουργίας:</div>
                        <div class="col-md-8">
                            <strong id="registration_date">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία λήξης του προϊόντος:</div>
                        <div class="col-md-8">
                            <strong id="expiration_date">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Σημειώσεις:</div>
                        <div class="col-md-8">
                            <strong id="notes">-</strong>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Κλείσιμο</button>
                </div>
            </div>
        </div>
    </div>
}
