@model ARI.Models.PackagingLineFormDTO
@{
    ViewBag.Title = "Έντυπα παλετών";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        Έντυπα παλετών
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--Add new form-->
<div class="card" style="max-width:1300px">
    <div class="card-header">
        <div class="card-title">Αναγνώστης \ Σκανάρισμα παλέτας</div>
        <div class="text-sm">Προσθέστε τις πληροφορίες</div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="AddPackagingLineForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label class="control-label">Προσθήκη ημερομηνίας εντύπου</label>
                        <input asp-for="FormDate" class="form-control" type="date" name="FormDate" id="palletDatePicker" value="@DateTime.Now" />
                        <span asp-validation-for="FormDate" class="text-danger"></span>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">LOT σημερινής παραγωγής:</div>
                        <div class="col-md-8">
                            <strong id="material-lot-id">-</strong>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Κωδικοποίηση παραγωγής (Κωδικός SAP \ Περιγραφή)</label>
                        <div id="filter-dropdown">
                            @Html.DropDownListFor(x => Model.SelectedMaterial, new SelectList(Model.MaterialListItems, "Value", "Text"), htmlAttributes: new { @class = "form-control", id = "material" })
                            @Html.ValidationMessageFor(x => x.SelectedMaterial, "", new { @class = "text-danger" })
                        </div>
                        <input id="search-filter-text" class="form-control mb-2" type="text" placeholder="Αναζήτηση κωδικός SAP, περιγραφή, GTIN, etc." />
                        <div class="d-flex">
                            <button onclick="searchFilterMaterials()" class="btn btn-secondary" type="button">Αναζήτηση</button>
                            <label><i id="no-filter"></i></label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Κωδικοποίηση παλέτας:</div>
                        <div class="col-md-8">
                            <strong id="product-mat-id">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Χώρα:</div>
                        <div class="col-md-8">
                            <strong id="country-code">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Aριθμός χαρτοκιβωτίων ανά παλέτα:</div>
                        <div class="col-md-8">
                            <strong id="pallet-no">-</strong>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">Ημερομηνία λήξης της παλέτας:</div>
                        <div class="col-md-8">
                            <strong id="expiration-pallet-date">-</strong>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Αριθμός παλετών για δημιουργία</label>
                        <input id="noPallets" asp-for="NoPalletToCreated" class="form-control" />
                        <span asp-validation-for="NoPalletToCreated" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Σημειώσεις</label>
                        <input asp-for="Notes" class="form-control" />
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                    <div class="form-group" id="submit-btn" hidden>
                        <input type="submit" value="Δημιουργία" class="mb-1 btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="PackagingLineForms">Επιστροφή στη λίστα των εντύπων</a>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/moment.js"></script>
    <link rel="stylesheet" href="~/css/bootstrap-datetimepicker.min.css">
    <script src="~/js/bootstrap-datetimepicker.min.js"></script>
    <script>
        $(function () {
            var material = document.getElementById("material");
            material.onchange = getMaterialInfo;

            const inputs = document.querySelectorAll('input');
            for (let i = 0; i < inputs.length; i++) {
                inputs[i].addEventListener('input', updateValue);
            }
        });
        $("#palletDatePicker").change(function () {
            handleSubmitButton();
            var referenceDate = new Date(2021, 0, 1);
            var formDate = new Date(document.getElementById('palletDatePicker').value);
            if (isNaN(formDate) || formDate <= referenceDate) {
                document.getElementById('material-lot-id').innerText = "Μη εφικτή ημερομηνία";
                document.getElementById('expiration-pallet-date').innerText = "Μη εφικτή ημερομηνία";
                return;
            }

            var difference = Math.abs(formDate - referenceDate);
            days = parseInt(difference / (1000 * 3600 * 24)) + 466;
            document.getElementById('material-lot-id').innerText = days;
            if (document.getElementById('material').value != "-") {
                var date = new Date(document.getElementById('palletDatePicker').value);
                date.setDate(date.getDate() - 1);
                const formatDate = (date) => {
                    let formatted_date = date.getDate() + "-" + (date.getMonth() + 1) + "-" + date.getFullYear()
                    return formatted_date;
                }
                document.getElementById('expiration-pallet-date').innerText = formatDate(date);
            }
        });
        function getMaterialInfo() {
            handleSubmitButton();
            var materialValue = document.getElementById('material').value;
            if (materialValue == "-") {
                document.getElementById('product-mat-id').innerText = "-";
                document.getElementById('country-code').innerText = "-";
                document.getElementById('pallet-no').innerText = "-";
                document.getElementById('expiration-pallet-date').innerText = "-";
            }
            else {
                $.get("LoadMaterialItems/?materialId=" + materialValue, function (data) {
                    document.getElementById('product-mat-id').innerText = data.materialDescription;
                    document.getElementById('country-code').innerText = data.languageCode;
                    document.getElementById('pallet-no').innerText = data.palletFactor;
                    var date = new Date(document.getElementById('palletDatePicker').value);
                    if (isNaN(date) || document.getElementById('palletDatePicker').value == "-" || document.getElementById('palletDatePicker').value == "Μη εφικτή ημερομηνία") {
                        document.getElementById('expiration-pallet-date').innerText = "Μη εφικτή ημερομηνία";
                        return;
                    }
                    date.setDate(date.getDate() + data.expirationDays - 1);
                    const formatDate = (date) => {
                        let formatted_date = date.getDate() + "-" + (date.getMonth() + 1) + "-" + date.getFullYear()
                        return formatted_date;
                    }
                    document.getElementById('expiration-pallet-date').innerText = formatDate(date);
                });
            }
        }
        function updateValue(e) {
            handleSubmitButton();
        }

        //Utils
        function handleSubmitButton() {
            var referenceDate = new Date(2021, 0, 1);
            var formDate = new Date(document.getElementById('palletDatePicker').value);
            var materialValue = document.getElementById('material').value;
            var noPallets = document.getElementById('noPallets').value;
            if (materialValue != "-" && !isNaN(formDate) && formDate >= referenceDate
                && parseInt(noPallets) <= 100 && parseInt(noPallets) >= 1) {
                document.getElementById('submit-btn').hidden = false;
            }
            else {
                document.getElementById('submit-btn').hidden = true;
            }
        }
        function searchFilterMaterials() {
            var search_text = document.getElementById('search-filter-text').value;

            var formData = new FormData();
            formData.append('search-text', search_text);

            $.ajax({
                type: "post",
                url: "/PackagingLine/GetFilterMaterials",
                contentType: false,
                processData: false,
                data: formData,
                success: function (message) {
                    var filter_dropdown = document.getElementById("filter-dropdown");
                    removeAllChildNodes(filter_dropdown);
                    create_select = document.createElement("select");
                    create_select.id = "Material";
                    create_select.classList.add('form-control');
                    create_select.name = "SelectedMaterial";
                    create_select.onchange = getMaterialInfo;
                    for (const element of message) {
                        option_element = document.createElement("option");
                        option_element.value = element.value;
                        option_element.innerHTML = element.text;
                        create_select.appendChild(option_element);
                    }
                    filter_dropdown.appendChild(create_select);
                },
                error: function () {
                    alert("error");
                }
            });
        }
        function removeAllChildNodes(parent) {
            while (parent.firstChild) {
                parent.removeChild(parent.firstChild);
            }
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

}