@using System.Security.Claims;
@using XRealityLab.Common;
@using Common.Constants;
@model List<XRealityLab.Models.ProjectDTO>

@{
    ViewBag.Title = "MyProjects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    string role = string.Empty;
    if (((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").Count() != 0)
    {
        role = ((ClaimsIdentity)User.Identity).FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role").ToList().LastOrDefault().Value;
    }
    IEnumerable<Claim> claims = User.Claims;
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>My Projects</strong>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<div class="container" style="float: left;">
    <div class="card-columns">
        @foreach (var item in Model)
        {
            string passToken = item.PassToken;
            <div class="card mb-4" style="background-color : @item.Color;padding:10px 0;height:360px">
                @if (role == RoleType.LabDirector.GetEnumDescription() || role == RoleType.PrincipleInvestigator.GetEnumDescription())
                {
                    <div align="right">
                        <a class="fa-2x mr-2 fas fa-ellipsis-h text-white" data-toggle="dropdown"></a>
                        <div class="dropdown-menu" role="menu">
                            <a class="dropdown-item" href="/User/AddPrincipleInvestigatorsToProject?passToken=@item.PassToken">Add Principle Investigators</a>
                            <a class="dropdown-item" href="/User/AddResearchAssistantsToProject?passToken=@item.PassToken">Add Research Assistants</a>
                            <a class="dropdown-item" href="/Project/EditResearchMethods?passToken=@item.PassToken">Add Research Method</a>
                        </div>
                    </div>
                }
                <div align="center" style="padding :10px 0 0 0" onclick="location.href='/Project/DataCollections?passToken=@passToken'">
                    <img src="@item.PhotoUrl" alt="Avatar" width="90" height="90" class="rounded-circle" />
                </div>
                <h3 class="text-white" style="margin:10px">@item.FullName</h3>
                <div class="card-body">
                    <div style="background-color: black; margin: 0px -16px; height: 50px">
                        <h4 class="card-title text-white" style="padding: 13px">Supervising PIs</h4>
                    </div>
                    <div style="background-color:white;margin:0px -16px; height:103px">
                        @foreach (var PI in item.UserDTOs)
                        {
                            <span class="fa fa-envelope" style="padding:15px 10px">
                                @PI.Firstname @PI.Lastname
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
        @if (role == RoleType.LabDirector.GetEnumDescription() || role == RoleType.PrincipleInvestigator.GetEnumDescription())
        {
            <div class="card mb-4" style="height:360px;background-color:transparent" onclick="location.href='/Project/AddProject'">
                <div align="center" style="padding :60px 0 0 0">
                    <h4 style="color: #4bc4e9;font-size:100px">+</h4>
                    <h4 style="color: #4bc4e9">New Project</h4>
                </div>
                <img style="margin:-215px 0px 0 0" width="370" height="360" src="/_images/group_icons/new_organization.png" />
            </div>
        }
    </div>
</div>
