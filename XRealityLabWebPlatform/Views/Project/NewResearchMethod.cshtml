@model XRealityLab.Models.ProjectDTO
@using System.Security.Claims;
@using XRealityLab.Common;

@{
    ViewBag.Title = "AddNewResearchMethod";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>New Research Method</strong>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<!--Projects Cards-->
<form asp-action="AddNewResearchMethod">
    <div class="row">
        <div class="col-xl-4">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group" style="display: none;">
                        <label>passToken</label>
                        <input asp-for="PassToken" class="form-control" type="text" placeholder="Enter Title" />
                    </div>
                    <div class="form-group">
                        <label>Title</label>
                        <input asp-for="Title" class="form-control" type="text" placeholder="Enter Title" />
                    </div>
                    <div class="form-group row">
                        <label class="col-md-2 col-form-label">Select</label>
                        <div class="col-md-10">
                            <select asp-for="ResearchMethodId" class="custom-select custom-select-lg mb-3">
                                <option selected="">Choose Research Method</option>
                                @foreach (var item in Model.ResearchDTOs)
                                {
                                    <option value=@item.ResearchMethodId>@item.TypeId</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="btn btn-sm btn-primary" type="submit">Submit</button>
</form>

@section Styles {
    <link href="~/vendor/bootstrap-colorpicker/dist/css/bootstrap-colorpicker.css" rel="stylesheet" />

}

@section Scripts {
    <script src="~/vendor/bootstrap-colorpicker/dist/js/bootstrap-colorpicker.js"></script>

}
