@model List<XRealityLab.Models.ProjectDTO>
@using XRealityLab.Common;

@{
    ViewBag.Title = "All Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-heading">
    <div>
        <strong>All projects</strong><span class="xr-count">@Model.Count</span>
        <span class="xr-sub">Every project of your lab. Add researchers and research methods from the menu of each project.</span>
    </div>
</div>

<partial name="_ActionMessage" />

<div class="xr-grid">
    <a class="xr-card xr-card-new" href="/Project/AddProject">
        <span class="xr-plus">+</span>
        New project
    </a>

    @foreach (var item in Model)
    {
        <article class="xr-card" style="--xr-card-color:@item.Color">
            <div class="xr-card-band">
                <div class="xr-card-menu">
                    <a class="fas fa-ellipsis-h" data-toggle="dropdown" role="button" aria-label="Actions for @item.FullName"></a>
                    <div class="dropdown-menu dropdown-menu-right" role="menu">
                        <a class="dropdown-item" href="/Project/DataCollections?passToken=@item.PassToken">Data collections</a>
                        <a class="dropdown-item" href="/Project/EditResearchMethods?passToken=@item.PassToken">Research methods</a>
                        <a class="dropdown-item" href="/User/AddPrincipleInvestigatorsToProject?passToken=@item.PassToken">Principal Investigators</a>
                        <a class="dropdown-item" href="/User/AddResearchAssistantsToProject?passToken=@item.PassToken">Research Assistants</a>
                        <a class="dropdown-item" href="/Project/EditProject?passToken=@item.PassToken">Edit project</a>
                        <a class="dropdown-item text-danger" href="/Project/RemoveProject?passToken=@item.PassToken" onclick="return confirm('Remove this project together with its sessions, participants and results? This cannot be undone.');">Remove project</a>
                    </div>
                </div>
            </div>
            <img class="xr-card-avatar" src="@item.PhotoUrl" alt="" />
            <div class="xr-card-body">
                <h3 class="xr-card-title"><a href="/Project/DataCollections?passToken=@item.PassToken">@item.FullName</a></h3>
                <p class="xr-label">Principal Investigators</p>
                <ul class="xr-people">
                    @if (item.UserDTOs.Count == 0)
                    {
                        <li class="xr-empty">None yet. Add one from the menu.</li>
                    }
                    @foreach (var PI in item.UserDTOs)
                    {
                        <li>@((Rank)PI.Rank + ". " + PI.Firstname + " " + PI.Lastname)</li>
                    }
                </ul>
                <div class="xr-card-foot">
                    <a href="/Project/DataCollections?passToken=@item.PassToken">Open data collections</a>
                </div>
            </div>
        </article>
    }
</div>
