@model XRealityLab.Models.ProjectDTO

@{
    ViewBag.Title = "DataCollections";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>Data Collections</strong>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<div class="container" style="float: left;">
    <h2>@Model.FullName</h2>
    <div class="card">
        <table class="table table-bordered table-hover" id="table-ext-1">
            <thead>
                <tr>
                    <th style="width:25%">Title</th>
                    <th style="width:45%">Description</th>
                    <th style="width:15%">Date</th>
                    <th style="width:10%">Participants</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    @{string passToken = Model.PassToken;}
                    <td class="text-primary" colspan="40" align="left"><a href="/Project/NewSession?passToken=@passToken">New Session +</a></td>
                </tr>
                @foreach (var item in Model.SessionDTOs)
                {
                    string sessionPassToken = item.PassToken;
                    <tr>
                        <td class="text-primary"><a href="/Project/Participants?passToken=@sessionPassToken">@item.Title</a></td>
                        <td>@item.Description</td>
                        <td>@item.Registered</td>
                        <td>@item.ParticipantsCount</td>
                        <td align="right">
                            <a class="fa-2x mr-2 fas fa-ellipsis-h text-dark" data-toggle="dropdown"></a>
                            <div class="dropdown-menu" role="menu">
                                <a class="dropdown-item" asp-action="DownloadDataCollectiontData" asp-route-sessionPassToken=@sessionPassToken>Export Data</a>
                                <a class="dropdown-item" href="#">Edit</a>
                                <a class="dropdown-item" asp-action="DeleteSession" asp-route-passToken="@Model.PassToken" asp-route-sessionId="@item.SessionId" onclick="return confirm('Are you sure you want to delete this item?');">Remove</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>