@model XRealityLab.Models.SessionDTO

@using XRealityLab.Common;

@{
    ViewBag.Title = "Participants";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header-->
<div class="content-heading">
    <div>
        <strong>Participants</strong>
        <ol class="breadcrumb breadcrumb px-0 pb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("MyProjects", "Project")">My Projects</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Project/DataCollections?passToken=@Model.ProjectPassToken">Data Collections</a>
            </li>
            <li class="breadcrumb-item active">Participants</li>
        </ol>
    </div>
</div>

<!--Alert dialog-->
@if (ViewBag.actionMessage != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <button class="close" type="button" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
        @ViewBag.actionMessage
    </div>
}

<div class="container" style="float: left;">
    <h2>@Model.Title <span class="xr-count">@Model.participantDTOs.Count participants</span></h2>
    <div class="card">
        <div class="xr-table-scroll">
            <table class="table table-striped table-bordered table-hover" id="participantsDataTable">
                <thead>
                    <tr>
                        <th style="width:5%">ID</th>
                        <th style="width:30%">Name</th>
                        @*<th style="width:20%">Email</th>
                    <th>Created</th>*@
                        @foreach (var item in Model.researchDTOs)
                        {
                            <th style="width:14%">@item.Title<span class="xr-th-sub">@item.TypeId</span></th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{int count = 0; }
                    <tr>
                        @{string passToken = Model.PassToken;}
                        <td class="text-primary" colspan="40" align="left"><a href="/Project/NewParticipant?passToken=@passToken"> New participant + </a></td>
                    </tr>
                    @foreach (var item in Model.participantDTOs)
                    {
                        count = count + 1;
                        string completeid = string.Empty;
                        <tr class="gradeX">
                            <td data-sort="@item.ParticipantId">P#@item.ParticipantId</td>
                            @{string resultsTokens = "passToken=" + item.PassToken + "&sessionPassToken=" + Model.PassToken;}
                            <td class="text-primary"> <a href="/Project/Results?@resultsTokens">@item.FirstName @item.LastName</a><span class="xr-cell-sub">@item.Email &middot; added @item.Registered.ToString("MM/dd/yyyy")</span></td>
                            @*<td>@item.Email</td>
                        <td>@item.Registered</td>*@
                            @foreach (var researchCompletion in item.researchCompletionDTOs)
                            {
                                if (researchCompletion.Completed)
                                {
                                    if (researchCompletion.ResearchMethodId == (int)ResearchType.OfflineMethod)
                                    {
                                        completeid = "offline-complete" + count.ToString() + "-" + researchCompletion.ResearchId.ToString();
                                        <td align="center">
                                            <div class="form-group row">
                                                <form id=@completeid method="post" enctype="multipart/form-data" asp-action="OfflineComplete" asp-route-participantPassToken=@item.PassToken asp-route-sessionPassToken=@Model.PassToken asp-route-researchPassToken=@researchCompletion.PassToken>
                                                    <div class="col-xl-10">
                                                        <div class="checkbox c-checkbox">
                                                            <label>
                                                                <input type="checkbox" checked="" onchange="document.getElementById('@completeid').submit()" />
                                                                <span class="fa fa-check"></span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td align="center">
                                            <div class="form-group row" style="pointer-events: none">
                                                <div class="col-xl-10">
                                                    <div class="checkbox c-checkbox">
                                                        <label>
                                                            <input type="checkbox" checked="" />
                                                            <span class="fa fa-check"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                }
                                else
                                {
                                    if (researchCompletion.ResearchMethodId == (int)ResearchType.OfflineMethod)
                                    {
                                        completeid = "offline-complete" + count.ToString() + "-" + researchCompletion.ResearchId.ToString();
                                        <td align="center">
                                            <div class="form-group row">
                                                <form id=@completeid method="post" enctype="multipart/form-data" asp-action="OfflineComplete" asp-route-participantPassToken=@item.PassToken asp-route-sessionPassToken=@Model.PassToken asp-route-researchPassToken=@researchCompletion.PassToken>
                                                    <div class="col-xl-10">
                                                        <div class="checkbox c-checkbox">
                                                            <label>
                                                                <input type="checkbox" onchange="document.getElementById('@completeid').submit()" />
                                                                <span class="fa fa-check"></span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td align="center">
                                            <div class="form-group row" style="pointer-events: none">
                                                <div class="col-xl-10">
                                                    <div class="checkbox c-checkbox">
                                                        <label>
                                                            <input type="checkbox" />
                                                            <span class="fa fa-check"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                }

                            }
                            <td align="right">
                                <a class="fa-2x mr-2 fas fa-ellipsis-h text-dark" data-toggle="dropdown"></a>
                                <div class="dropdown-menu" role="menu">
                                    <a class="dropdown-item" asp-action="DownloadParticipantData" asp-route-participantPassToken=@item.PassToken asp-route-sessionPassToken=@Model.PassToken>Export Data</a>
                                    <a class="dropdown-item" asp-action="DeleteParticipant" asp-route-passToken="@Model.PassToken" asp-route-participantId="@item.ParticipantId" onclick="return confirm('Are you sure you want to delete this item?');">Remove</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/vendor/datatables.net-bs4/css/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-keytable-bs/css/keyTable.bootstrap.css">
    <link rel="stylesheet" href="~/vendor/datatables.net-responsive-bs/css/responsive.bootstrap.css">
}

@section Scripts {
    <script src="~/vendor/datatables.net/js/jquery.dataTables.js"></script>
    <script src="~/vendor/datatables.net-bs4/js/dataTables.bootstrap4.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/dataTables.buttons.js"></script>
    <script src="~/vendor/datatables.net-buttons-bs/js/buttons.bootstrap.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.colVis.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.flash.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.html5.js"></script>
    <script src="~/vendor/datatables.net-buttons/js/buttons.print.js"></script>
    <script src="~/vendor/datatables.net-keytable/js/dataTables.keyTable.js"></script>
    <script src="~/vendor/datatables.net-responsive/js/dataTables.responsive.js"></script>
    <script src="~/vendor/datatables.net-responsive-bs/js/responsive.bootstrap.js"></script>
    <script src="~/vendor/jszip/dist/jszip.js"></script>
    <script src="~/vendor/pdfmake/build/pdfmake.js"></script>
    <script src="~/vendor/pdfmake/build/vfs_fonts.js"></script>
}