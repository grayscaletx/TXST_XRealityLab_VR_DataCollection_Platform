# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# The .env file is ignored by git - never commit real passwords.

# SQL Server "sa" password: at least 8 characters with upper case, lower case and a digit.
# Avoid the characters ; and $ in it.
DB_PASSWORD=

# First Administrator of the platform (created on the first start only).
# The password needs at least 4 characters and one lower-case letter.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the web platform (used in invitation e-mails).
PLATFORM_URL=http://localhost:8080

# E-mail: None (e-mails are written to the web container log), SendGrid or Smtp
MAIL_PROVIDER=None
MAIL_FROM_EMAIL=no-reply@example.org
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
