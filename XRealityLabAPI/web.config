<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\XRealityLabAPI.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <!-- The log in call carries the e-mail address in the URL. Without this, IIS / Azure App Service
             rejects addresses that contain "+" (for example name+tag@example.org) before they reach the API. -->
        <requestFiltering allowDoubleEscaping="true" />
      </security>
    </system.webServer>
  </location>
</configuration>
